# ARQUIVO: game/episodes/Ep5_1/episode5_1.rpy DIALOGOS: 2562


# game/episodes/Ep5_1/episode5_1.rpy:3
translate HZIlle ep5_1_start_82cb08a4:

#   "7 hours earlier..."
    "7 horas antes..."

# game/episodes/Ep5_1/episode5_1.rpy:10
translate HZIlle ep5_1_start_c8676799:

#   luc "My head’s spinning without my meds... I remember my parents said I shouldn’t ever—"
    luc "La cabeza me da vueltas sin mis medicinas... Recuerdo que mis padres decían que no debía nunca..."

# game/episodes/Ep5_1/episode5_1.rpy:12
translate HZIlle ep5_1_start_d7d6993f:

#   law "Consider it a new kind of liberation. From bars, your parents, and from your own mind."
    law "Considéralo un nuevo tipo de liberación. De los bares, de tus padres y de tu propia mente."

# game/episodes/Ep5_1/episode5_1.rpy:14
translate HZIlle ep5_1_start_c4882578:

#   luc "But I’m not well..."
    luc "Pero no estoy bien..."

# game/episodes/Ep5_1/episode5_1.rpy:16
translate HZIlle ep5_1_start_b1c67a1e:

#   law "Everyone you trust kept you in the dark for so long, you don't even know what it's like to be free."
    law "Todas las personas en las que confías te mantuvieron en la oscuridad durante tanto tiempo que ni siquiera sabes lo que es ser libre."

# game/episodes/Ep5_1/episode5_1.rpy:17
translate HZIlle ep5_1_start_9477523b:

#   law "You've been off your meds for only a few days, give it more time."
    law "Llevas pocos días sin tomar la medicación, dale más tiempo."

# game/episodes/Ep5_1/episode5_1.rpy:19
translate HZIlle ep5_1_start_f6cef5d0:

#   luc "I'm not better or worse... just not the same. I don't know."
    luc "No soy ni mejor ni peor... simplemente no soy igual, no lo sé."

# game/episodes/Ep5_1/episode5_1.rpy:21
translate HZIlle ep5_1_start_81290d47:

#   law "Can you handle another mission?"
    law "¿Puedes con otra misión?"

# game/episodes/Ep5_1/episode5_1.rpy:23
translate HZIlle ep5_1_start_941905e0:

#   luc "I’ll try... If it means helping [k]."
    luc "Lo intentaré... Si eso significa ayudar a [k]."

# game/episodes/Ep5_1/episode5_1.rpy:28
translate HZIlle ep5_1_start_38fe4123:

#   luc "IS THAT A GUN?!"
    luc "¿ESO ES UNA PISTOLA?"

# game/episodes/Ep5_1/episode5_1.rpy:29
translate HZIlle ep5_1_start_c8d93eb9:

#   law "It is."
    law "Lo es."

# game/episodes/Ep5_1/episode5_1.rpy:31
translate HZIlle ep5_1_start_884d55bf:

#   luc "You need me to deal with [mc]?"
    luc "¿Necesitas que me ocupe de [mc]?"

# game/episodes/Ep5_1/episode5_1.rpy:33
translate HZIlle ep5_1_start_84d75bb1:

#   law "Not just yet."
    law "Todavía no."

# game/episodes/Ep5_1/episode5_1.rpy:35
translate HZIlle ep5_1_start_b30e2da1:

#   luc "Who then?"
    luc "¿Quién entonces?"

# game/episodes/Ep5_1/episode5_1.rpy:37
translate HZIlle ep5_1_start_a3599738:

#   law "You’re about to trigger a chain reaction that’ll redefine power in New Zhine City."
    law "Estás a punto de desencadenar una reacción en cadena que redefinirá el poder en Ciudad Nueva Zhine."

# game/episodes/Ep5_1/episode5_1.rpy:38
translate HZIlle ep5_1_start_925609f3:

#   law "It’s not just about saving [k] anymore."
    law "Ya no se trata sólo de salvar [k]."

# game/episodes/Ep5_1/episode5_1.rpy:39
translate HZIlle ep5_1_start_deebcd9a:

#   law "It’s about saving everyone from [z]."
    law "Se trata de salvar a todos de [z]."

# game/episodes/Ep5_1/episode5_1.rpy:41
translate HZIlle ep5_1_start_0fc1d265:

#   "3 hours later..."
    "3 horas después..."

# game/episodes/Ep5_1/episode5_1.rpy:44
translate HZIlle ep5_1_start_977fa14d:

#   "???" "Now where did those keys go?"
    "???" "¿Dónde han ido a parar esas llaves?"

# game/episodes/Ep5_1/episode5_1.rpy:46
translate HZIlle ep5_1_start_1a0cd834:

#   luc "I can do this."
    luc "Puedo hacerlo."

# game/episodes/Ep5_1/episode5_1.rpy:47
translate HZIlle ep5_1_start_8d96d42b:

#   luc "I’m doing this for everyone."
    luc "Lo hago por todos."

# game/episodes/Ep5_1/episode5_1.rpy:49
translate HZIlle ep5_1_start_bbb8dcc2:

#   luc "Right."
    luc "Correcto."

# game/episodes/Ep5_1/episode5_1.rpy:51
translate HZIlle ep5_1_start_7db899f4:

#   "???" "[sa]? Is that you?"
    "???" "[sa] ¿Eres tú?"

# game/episodes/Ep5_1/episode5_1.rpy:52
translate HZIlle ep5_1_start_b6020a59:

#   "???" "Look at that, I remembered!"
    "???" "Mira, ¡me he acordado!"

# game/episodes/Ep5_1/episode5_1.rpy:53
translate HZIlle ep5_1_start_19e1a07e:

#   "???" "... Are you upset? I swear I ate lunch already!"
    "???" "... ¿Estás enfadado? ¡Te juro que ya he almorzado!"

# game/episodes/Ep5_1/episode5_1.rpy:55
translate HZIlle ep5_1_start_fd387ed1:

#   "???" "Come in, tell me about your bartending job!"
    "???" "Pasa, ¡háblame de tu trabajo de camarero!"

# game/episodes/Ep5_1/episode5_1.rpy:59
translate HZIlle ep5_1_start_b229092b:

#   luc "..."
    luc "..."

# game/episodes/Ep5_1/episode5_1.rpy:75
translate HZIlle ep5_mansion_lilz_22642914:

#   z "Sit."
    z "Siéntate."

# game/episodes/Ep5_1/episode5_1.rpy:77
translate HZIlle ep5_mansion_lilz_7a5f725e:

#   lil "What's wrong?"
    lil "¿Qué ocurre?"

# game/episodes/Ep5_1/episode5_1.rpy:79
translate HZIlle ep5_mansion_lilz_daff3f38:

#   z "Is there anything you'd like to confess to?"
    z "¿Hay algo que quieras confesar?"

# game/episodes/Ep5_1/episode5_1.rpy:83
translate HZIlle ep5_mansion_lilz_f50f7f29:

#   lilt "No, it can't be... It's not possible! He cannot know!"
    lilt "No, no puede ser... ¡No es posible! ¡Él no puede saberlo!"

# game/episodes/Ep5_1/episode5_1.rpy:84
translate HZIlle ep5_mansion_lilz_105c4cdb:

#   lil "Not really, no."
    lil "En realidad, no."

# game/episodes/Ep5_1/episode5_1.rpy:87
translate HZIlle ep5_mansion_lilz_3fe5415e:

#   z "We're not as close as we once were."
    z "Ya no estamos tan unidos como antes."

# game/episodes/Ep5_1/episode5_1.rpy:88
translate HZIlle ep5_mansion_lilz_0a45819c:

#   lil "And since when do you... care?"
    lil "¿Y desde cuándo... te importa?"

# game/episodes/Ep5_1/episode5_1.rpy:90
translate HZIlle ep5_mansion_lilz_800123e0:

#   z "I may not care... But I notice more than you think."
    z "Puede que no me importe... Pero me doy cuenta más de lo que crees."

# game/episodes/Ep5_1/episode5_1.rpy:92
translate HZIlle ep5_mansion_lilz_b4193089:

#   lil "Is that so?"
    lil "¿Es así?"

# game/episodes/Ep5_1/episode5_1.rpy:94
translate HZIlle ep5_mansion_lilz_b35d214e:

#   z "You've always been sharp. And secretive."
    z "Siempre has sido astuto y reservado."

# game/episodes/Ep5_1/episode5_1.rpy:95
translate HZIlle ep5_mansion_lilz_681ac6ca:

#   z "Always keeping your cards close to your chest. That's a dangerous combo."
    z "Mantener siempre las cartas cerca del pecho es una combinación peligrosa."

# game/episodes/Ep5_1/episode5_1.rpy:97
translate HZIlle ep5_mansion_lilz_8cce3367:

#   z "You were keeping them so close, in fact, I suspected an affair."
    z "Los mantenías tan unidos que, de hecho, sospeché de una aventura."

# game/episodes/Ep5_1/episode5_1.rpy:100
translate HZIlle ep5_mansion_lilz_ceeaa5a4:

#   lilt "... that's ironic."
    lilt "... es irónico."

# game/episodes/Ep5_1/episode5_1.rpy:101
translate HZIlle ep5_mansion_lilz_bc7668eb:

#   lil "Again, you'd be the last to care."
    lil "De nuevo, serías el último en preocuparte."

# game/episodes/Ep5_1/episode5_1.rpy:104
translate HZIlle ep5_mansion_lilz_e4528f0c:

#   lil "Not like you'd care, anyway."
    lil "De todas formas, no es que te importe."

# game/episodes/Ep5_1/episode5_1.rpy:106
translate HZIlle ep5_mansion_lilz_ed6fb824:

#   z "On the contrary, I would."
    z "Al contrario."

# game/episodes/Ep5_1/episode5_1.rpy:108
translate HZIlle ep5_mansion_lilz_ede50e2f:

#   lil "Never took you as an emotional one."
    lil "Nunca te tomé por una emocional."

# game/episodes/Ep5_1/episode5_1.rpy:110
translate HZIlle ep5_mansion_lilz_5e9a2d15:

#   z "It's my anger that you should worry about."
    z "Es mi ira lo que debería preocuparte."

# game/episodes/Ep5_1/episode5_1.rpy:111
translate HZIlle ep5_mansion_lilz_fa8fd059:

#   z "Since my concerns were somewhat valid, I've made sure you won't step out of line again."
    z "Como mis preocupaciones eran en cierto modo válidas, me he asegurado de que no vuelvas a pasarte de la raya."

# game/episodes/Ep5_1/episode5_1.rpy:113
translate HZIlle ep5_mansion_lilz_a144f083:

#   lil "Huh?!"
    lil "¿Eh?"

# game/episodes/Ep5_1/episode5_1.rpy:114
translate HZIlle ep5_mansion_lilz_f58ad9c0:

#   lil "You're barking up the wrong tree. I am not having an affair."
    lil "Estás ladrando al árbol equivocado. No estoy teniendo una aventura."

# game/episodes/Ep5_1/episode5_1.rpy:116
translate HZIlle ep5_mansion_lilz_07e0176d:

#   z "Hmmm... My mistake then."
    z "Hmmm... Error mío entonces."

# game/episodes/Ep5_1/episode5_1.rpy:118
translate HZIlle ep5_mansion_lilz_51ae8eef:

#   lil "It wouldn't have been YOUR mistake if you'd let off from being such a control freak!"
    lil "¡No habría sido TU error si hubieras dejado de ser tan controladora!"

# game/episodes/Ep5_1/episode5_1.rpy:120
translate HZIlle ep5_mansion_lilz_67c225a0:

#   z "However..."
    z "Sin embargo..."

# game/episodes/Ep5_1/episode5_1.rpy:121
translate HZIlle ep5_mansion_lilz_b72f5b80:

#   z "In digging up your secrets, I found your BlitzTransfer account..."
    z "Al desenterrar tus secretos, encontré tu cuenta de BlitzTransfer..."

# game/episodes/Ep5_1/episode5_1.rpy:123
translate HZIlle ep5_mansion_lilz_a9cf8c48:

#   z "And all the money flowing out, nothing ever in."
    z "Y todo el dinero que sale, nunca entra nada."

# game/episodes/Ep5_1/episode5_1.rpy:124
translate HZIlle ep5_mansion_lilz_b1c66b55:

#   lil "..."
    lil "..."

# game/episodes/Ep5_1/episode5_1.rpy:126
translate HZIlle ep5_mansion_lilz_948dd324:

#   z "You were either planning an escape or... funneling money to [f]. Which is it?"
    z "O estabas planeando una huida o... canalizando dinero hacia [f] ¿Cuál es?"

# game/episodes/Ep5_1/episode5_1.rpy:128
translate HZIlle ep5_mansion_lilz_5a707aa3:

#   lil "Neither."
    lil "Tampoco."

# game/episodes/Ep5_1/episode5_1.rpy:130
translate HZIlle ep5_mansion_lilz_e3268561:

#   z "Don't play dumb with me!"
    z "¡No te hagas el tonto conmigo!"

# game/episodes/Ep5_1/episode5_1.rpy:131
translate HZIlle ep5_mansion_lilz_de4665c7:

#   z "How dare you go behind my back to help MY daughter?!"
    z "¿Cómo te atreves a ir a mis espaldas para ayudar a MI hija?"

# game/episodes/Ep5_1/episode5_1.rpy:133
translate HZIlle ep5_mansion_lilz_b787ebd1:

#   lil "She is in deep trouble!"
    lil "¡Está metida en un buen lío!"

# game/episodes/Ep5_1/episode5_1.rpy:134
translate HZIlle ep5_mansion_lilz_2582a036:

#   lil "Caught up with horrible people because of YOUR actions! It is my duty to help MY daughter!"
    lil "¡Atrapada con gente horrible a causa de TUS acciones! ¡Es mi deber ayudar a MI hija!"

# game/episodes/Ep5_1/episode5_1.rpy:136
translate HZIlle ep5_mansion_lilz_c62e7774:

#   z "You're not her mother."
    z "No eres su madre."

# game/episodes/Ep5_1/episode5_1.rpy:138
translate HZIlle ep5_mansion_lilz_042ef94c:

#   lil "So what if I'm not her biological mother?! That doesn't strip away my right to help her!"
    lil "¿Y qué si no soy su madre biológica? ¡Eso no me quita el derecho a ayudarla!"

# game/episodes/Ep5_1/episode5_1.rpy:140
translate HZIlle ep5_mansion_lilz_702c3881:

#   z "You've misunderstood... as usual."
    z "Has entendido mal... como siempre."

# game/episodes/Ep5_1/episode5_1.rpy:141
translate HZIlle ep5_mansion_lilz_edbc67c6:

#   z "She sees us as nothing but cash machines. That's our only value to her. It's finally time you open your eyes!"
    z "No nos ve más que como cajeros automáticos. Ése es nuestro único valor para ella. Por fin es hora de que abra los ojos!"

# game/episodes/Ep5_1/episode5_1.rpy:143
translate HZIlle ep5_mansion_lilz_7e50941d:

#   z "You think she loves you? As long as the cash flows, maybe."
    z "¿Crees que te quiere? Mientras fluya el dinero, tal vez."

# game/episodes/Ep5_1/episode5_1.rpy:144
translate HZIlle ep5_mansion_lilz_5c1e12c6:

#   z "Stop the funds, and watch how quickly you become a nobody to her."
    z "Detén los fondos y observa lo rápido que te conviertes en un don nadie para ella."

# game/episodes/Ep5_1/episode5_1.rpy:146
translate HZIlle ep5_mansion_lilz_d2f2e6e7:

#   z "Trust me, been there, done that."
    z "Créeme, lo he vivido y lo he hecho."

# game/episodes/Ep5_1/episode5_1.rpy:148
translate HZIlle ep5_mansion_lilz_f2955cee:

#   lil "[f] despises you, and it's so easy to see why."
    lil "[f] te desprecia, y es muy fácil ver por qué."

# game/episodes/Ep5_1/episode5_1.rpy:149
translate HZIlle ep5_mansion_lilz_46665699:

#   lil "Don't you dare put me in the same boat."
    lil "No te atrevas a meterme en el mismo saco."

# game/episodes/Ep5_1/episode5_1.rpy:151
translate HZIlle ep5_mansion_lilz_8b88dca1:

#   z "She despises me now because the money's stopped — shows you where her heart's at."
    z "Ahora me desprecia porque se ha acabado el dinero, eso demuestra dónde está su corazón."

# game/episodes/Ep5_1/episode5_1.rpy:152
translate HZIlle ep5_mansion_lilz_786c31af:

#   z "And if you had half the brains for personal matters as you do for business, you'd cut her off too."
    z "Y si tuvieras la mitad de cerebro para los asuntos personales que para los negocios, también la cortarías."

# game/episodes/Ep5_1/episode5_1.rpy:153
translate HZIlle ep5_mansion_lilz_bd551a30:

#   z "Stop the handouts, and she'll be home before the month's out."
    z "Déjate de limosnas y volverá a casa antes de que acabe el mes."

# game/episodes/Ep5_1/episode5_1.rpy:155
translate HZIlle ep5_mansion_lilz_ee1972dd:

#   lil "Or she might end up dead."
    lil "O podría acabar muerta."

# game/episodes/Ep5_1/episode5_1.rpy:157
translate HZIlle ep5_mansion_lilz_56403e03:

#   z "[f] knows how to look after herself. Always finding a new host to parasite from."
    z "[f] sabe cuidar de sí misma. Siempre encuentra un nuevo huésped del que parasitar."

# game/episodes/Ep5_1/episode5_1.rpy:159
translate HZIlle ep5_mansion_lilz_c2e2dc57:

#   lil "She's your daughter!"
    lil "¡Es tu hija!"

# game/episodes/Ep5_1/episode5_1.rpy:160
translate HZIlle ep5_mansion_lilz_116941f6:

#   z "And who better than me to know the games she plays?"
    z "¿Y quién mejor que yo para conocer los juegos a los que juega?"

# game/episodes/Ep5_1/episode5_1.rpy:162
translate HZIlle ep5_mansion_lilz_80234db1:

#   lil "You despise her because she defies you, doesn't bow to the 'king'. Does it bruise your ego that she stands up to you?"
    lil "La desprecias porque te desafía, porque no se inclina ante el \"rey\" ¿Te hiere el ego que te haga frente?"

# game/episodes/Ep5_1/episode5_1.rpy:163
translate HZIlle ep5_mansion_lilz_ef3122da:

#   z "Hm."
    z "Hm."

# game/episodes/Ep5_1/episode5_1.rpy:165
translate HZIlle ep5_mansion_lilz_99a36b27:

#   lil "Is that it?"
    lil "¿Es eso?"

# game/episodes/Ep5_1/episode5_1.rpy:167
translate HZIlle ep5_mansion_lilz_a82fffa3:

#   z "Thanks to some... police intervention, your funds at BlitzTransfer are now inaccessible."
    z "Gracias a una... intervención policial, tus fondos en BlitzTransfer son ahora inaccesibles."

# game/episodes/Ep5_1/episode5_1.rpy:168
translate HZIlle ep5_mansion_lilz_fd304ae3:

#   z "No more money for [f]. Let’s find out what you mean to her now, without your financial backing."
    z "No más dinero para [f]. Averigüemos lo que significas para ella ahora, sin tu respaldo financiero."

# game/episodes/Ep5_1/episode5_1.rpy:170
translate HZIlle ep5_mansion_lilz_9a70e4d8:

#   z "Should you attempt to contact her, I suggest you look over your shoulder."
    z "Si intentas ponerte en contacto con ella, te sugiero que mires por encima del hombro."

# game/episodes/Ep5_1/episode5_1.rpy:171
translate HZIlle ep5_mansion_lilz_950516eb:

#   z "Because I'll be watching."
    z "Porque estaré mirando."

# game/episodes/Ep5_1/episode5_1.rpy:173
translate HZIlle ep5_mansion_lilz_23f6813a:

#   z "... Oh, and one more thing."
    z "... Ah, y una cosa más."

# game/episodes/Ep5_1/episode5_1.rpy:186
translate HZIlle ep5_mansion_5837fb28:

#   mct "New day... New tasks!"
    mct "Nuevo día... ¡Nuevas tareas!"

# game/episodes/Ep5_1/episode5_1.rpy:187
translate HZIlle ep5_mansion_f1459b59:

#   mct "Another exciting day guarding the mansion..."
    mct "Otro día emocionante vigilando la mansión..."

# game/episodes/Ep5_1/episode5_1.rpy:191
translate HZIlle ep5_mansion_c3338c0f:

#   mct "I might bump into [lil] again today! I'm so looking forward to it!"
    mct "¡Puede que hoy vuelva a toparme con [lil] ! ¡Me hace mucha ilusión!"

# game/episodes/Ep5_1/episode5_1.rpy:192
translate HZIlle ep5_mansion_e227173d:

#   mct "Damn, last night was something else!"
    mct "Maldita sea, ¡lo de anoche fue otra cosa!"

# game/episodes/Ep5_1/episode5_1.rpy:194
translate HZIlle ep5_mansion_a94a123d:

#   mct "How am I supposed to keep my cool around her after that?"
    mct "¿Cómo se supone que voy a mantener la calma con ella después de eso?"

# game/episodes/Ep5_1/episode5_1.rpy:196
translate HZIlle ep5_mansion_338d35e6:

#   mct "I swear, I'm just going to throw myself at her the moment I see her."
    mct "Te juro que me lanzaré sobre ella en cuanto la vea."

# game/episodes/Ep5_1/episode5_1.rpy:198
translate HZIlle ep5_mansion_c3101375:

#   mct "Fuck me..."
    mct "No me jodas..."

# game/episodes/Ep5_1/episode5_1.rpy:200
translate HZIlle ep5_mansion_84101646:

#   mct "Deep breathes!"
    mct "¡Respira hondo!"

# game/episodes/Ep5_1/episode5_1.rpy:202
translate HZIlle ep5_mansion_525109fa:

#   mct "Stay calm!"
    mct "¡Mantén la calma!"

# game/episodes/Ep5_1/episode5_1.rpy:204
translate HZIlle ep5_mansion_f7698069:

#   mct "And focus..."
    mct "Y concéntrate..."

# game/episodes/Ep5_1/episode5_1.rpy:208
translate HZIlle ep5_mansion_8cb54363:

#   mct "Yay!"
    mct "¡Viva!"

# game/episodes/Ep5_1/episode5_1.rpy:210
