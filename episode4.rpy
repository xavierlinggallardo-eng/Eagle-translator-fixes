translate HZIlle ep4_party_table_ti_d8bf7bb1:

#   ti "100%% party! How about a drink?"
    ti "100%% fiesta! ¿Qué tal una copa?"

# game/episodes/Ep4/episode4.rpy:1077
translate HZIlle ep4_party_table_ti_56c3991c:

#   mc "Why not?"
    mc "¿Por qué no?"

# game/episodes/Ep4/episode4.rpy:1078
translate HZIlle ep4_party_table_ti_a1e68dae:

#   ti "That's the... spirit!"
    ti "Ese es el... ¡espíritu!"

# game/episodes/Ep4/episode4.rpy:1081
translate HZIlle ep4_party_table_ti_760d0385:

#   mc "Thanks, I'll pass."
    mc "Gracias, paso."

# game/episodes/Ep4/episode4.rpy:1082
translate HZIlle ep4_party_table_ti_bc470e06:

#   ti "Your loss!"
    ti "¡Tú te lo pierdes!"

# game/episodes/Ep4/episode4.rpy:1085
translate HZIlle ep4_party_table_ti_9bd7cd18:

#   mc "I'll be around... if you need anything."
    mc "Estaré por aquí... si necesitas algo."

# game/episodes/Ep4/episode4.rpy:1086
translate HZIlle ep4_party_table_ti_bfd131e7:

#   ti "Sure, sure!"
    ti "¡Claro, claro!"

# game/episodes/Ep4/episode4.rpy:1088
translate HZIlle ep4_party_table_ti_a60d4a9e:

#   ti "..."
    ti "..."

# game/episodes/Ep4/episode4.rpy:1089
translate HZIlle ep4_party_table_ti_e965f416:

#   ti "I am so fucked."
    ti "Estoy muy jodida."

# game/episodes/Ep4/episode4.rpy:1100
translate HZIlle ep4_party_staircase_fv_c6bd2747:

#   fv "No talking, remember?"
    fv "No hables, ¿recuerdas?"

# game/episodes/Ep4/episode4.rpy:1101
translate HZIlle ep4_party_staircase_fv_2b35b6fe:

#   mc "..."
    mc "..."

# game/episodes/Ep4/episode4.rpy:1103
translate HZIlle ep4_party_staircase_fv_3b7282cf:

#   fv "Good boy."
    fv "Buen chico."

# game/episodes/Ep4/episode4.rpy:1105
translate HZIlle ep4_party_staircase_fv_0dc4e2f1:

#   mct "She looks familiar... How do I know this girl?"
    mct "Me resulta familiar... ¿De qué conozco a esta chica?"

# game/episodes/Ep4/episode4.rpy:1107
translate HZIlle ep4_party_staircase_fv_37543d7e:

#   fv "Don't let me out of your sight tonight."
    fv "No me pierdas de vista esta noche."

# game/episodes/Ep4/episode4.rpy:1108
translate HZIlle ep4_party_staircase_fv_d00866d5:

#   fv "I promise, you will not regret it."
    fv "Te prometo que no te arrepentirás."

# game/episodes/Ep4/episode4.rpy:1113
translate HZIlle ep4_party_staircase_fv_b56e377b:

#   mct "Strange..."
    mct "Es extraño..."

# game/episodes/Ep4/episode4.rpy:1121
translate HZIlle ep4_party_staircase_ff_1c602135:

#   mc "Hey, hey! What's the newest and hottest [z] employee doing at a [hns] party?"
    mc "¡Eh, eh! ¿Qué hace la empleada más nueva y atractiva de [z] en una fiesta de [hns]?"

# game/episodes/Ep4/episode4.rpy:1123
translate HZIlle ep4_party_staircase_ff_1cf2a5e9:

#   ff "Shhh! Are you mad? Don't mention the Z word here!"
    ff "¡Shhh! ¿Estás loco? ¡No menciones la palabra con Z aquí!"

# game/episodes/Ep4/episode4.rpy:1124
translate HZIlle ep4_party_staircase_ff_e1f05897:

#   mc "Oops. My bad."
    mc "Culpa mía."

# game/episodes/Ep4/episode4.rpy:1126
translate HZIlle ep4_party_staircase_ff_ecc5fbdf:

#   ff "Hmmm. Let me think, Brainiac. What do you usually do at a party?"
    ff "Hmmm. Déjame pensar, Brainiac. ¿Qué sueles hacer en una fiesta?"

# game/episodes/Ep4/episode4.rpy:1127
translate HZIlle ep4_party_staircase_ff_1f707c98:

#   mc "Drink, dance, have fun... and talk to people. Sitting alone in a corner isn't on my list, sorry."
    mc "Bebe, baila, diviértete... y habla con la gente. Sentarse solo en un rincón no está en mi lista, lo siento."

# game/episodes/Ep4/episode4.rpy:1129
translate HZIlle ep4_party_staircase_ff_8ad033c8:

#   ff "Touché. I snagged an invite, so I'd hate to miss it."
    ff "Touché. Conseguí una invitación, así que no me gustaría perdérmelo."

# game/episodes/Ep4/episode4.rpy:1130
translate HZIlle ep4_party_staircase_ff_4b7d42bd:

#   mc "You are missing it!"
    mc "¡Te lo estás perdiendo!"

# game/episodes/Ep4/episode4.rpy:1132
translate HZIlle ep4_party_staircase_ff_16cf5bfe:

#   ff "Ok, I only know like... two folks around here. Making new connections? Not my strong suit, honestly."
    ff "Vale, sólo conozco a... dos personas por aquí. ¿Hacer nuevas conexiones? No es mi fuerte, sinceramente."

# game/episodes/Ep4/episode4.rpy:1133
translate HZIlle ep4_party_staircase_ff_27136887:

#   mc "I kinda expected bartenders to be chattier."
    mc "Esperaba que los camareros fueran más habladores."

# game/episodes/Ep4/episode4.rpy:1135
translate HZIlle ep4_party_staircase_ff_2d647f1d:

#   ff "Usually, folks come to bartenders to chat, not the other way around."
    ff "Normalmente, la gente acude a los camareros para charlar, no al revés."

# game/episodes/Ep4/episode4.rpy:1136
translate HZIlle ep4_party_staircase_ff_94c7385b:

#   ff "I need a drink..."
    ff "Necesito un trago..."

# game/episodes/Ep4/episode4.rpy:1138
translate HZIlle ep4_party_staircase_ff_1fec23cf:

#   mc "Don't you move! I'm on it!"
    mc "¡No te muevas! ¡Estoy en ello!"

# game/episodes/Ep4/episode4.rpy:1139
translate HZIlle ep4_party_staircase_ff_6992cfa2:

#   ff "I thought we were talking to kickstart things."
    ff "Creía que estábamos hablando para empezar."

# game/episodes/Ep4/episode4.rpy:1141
translate HZIlle ep4_party_staircase_ff_d2253646:

#   mc "We will... while drunk!"
    mc "Lo haremos... ¡estando borrachos!"

# game/episodes/Ep4/episode4.rpy:1142
translate HZIlle ep4_party_staircase_ff_3fa5e8e2:

#   ff "Keep it chill with the percentages, alright?"
    ff "Mantén la calma con los porcentajes, ¿de acuerdo?"

# game/episodes/Ep4/episode4.rpy:1147
translate HZIlle ep4_party_staircase_ff_f83797a2:

#   mc "Uh-oh... What's that look?"
    mc "Uh-oh... ¿Qué es esa mirada?"

# game/episodes/Ep4/episode4.rpy:1148
translate HZIlle ep4_party_staircase_ff_fb1af4f1:

#   ff "I'm hunting."
    ff "Estoy cazando."

# game/episodes/Ep4/episode4.rpy:1150
translate HZIlle ep4_party_staircase_ff_163ec697:

#   mc "For?"
    mc "¿Para qué?"

# game/episodes/Ep4/episode4.rpy:1151
translate HZIlle ep4_party_staircase_ff_e6eb5a4c:

#   ff "Higher-ups."
    ff "Los superiores."

# game/episodes/Ep4/episode4.rpy:1153
translate HZIlle ep4_party_staircase_ff_7886f194:

#   mc "Oh. I thought I could be your prey..."
    mc "Oh. Pensé que podría ser tu presa..."

# game/episodes/Ep4/episode4.rpy:1154
translate HZIlle ep4_party_staircase_ff_f81afb76:

#   ff "Not this time."
    ff "Esta vez no."

# game/episodes/Ep4/episode4.rpy:1156
translate HZIlle ep4_party_staircase_ff_ac548bfb:

#   ff "Help me find someone in charge. Please?"
    ff "Ayúdame a encontrar a algún responsable, por favor."

# game/episodes/Ep4/episode4.rpy:1157
translate HZIlle ep4_party_staircase_ff_04153eee:

#   ff "Fit redhead looks like she knows a thing or two."
    ff "La pelirroja en forma parece que sabe un par de cosas."

# game/episodes/Ep4/episode4.rpy:1159
translate HZIlle ep4_party_staircase_ff_822aa5c3:

#   mc "How so?"
    mc "¿Por qué?"

# game/episodes/Ep4/episode4.rpy:1160
translate HZIlle ep4_party_staircase_ff_58cb607f:

#   ff "As a bartender, I'd often try to guess people's jobs and personalities from their chats and appearances."
    ff "Como camarero, a menudo intentaba adivinar el trabajo y la personalidad de la gente a partir de sus charlas y apariencias."

# game/episodes/Ep4/episode4.rpy:1161
translate HZIlle ep4_party_staircase_ff_7b816d63:

#   ff "The way that redhead's sizing up everyone... like she's scouting for recruits. Maybe I should give her a shot?"
    ff "La forma en que esa pelirroja está evaluando a todo el mundo... como si estuviera buscando reclutas. ¿Quizá debería darle una oportunidad?"

# game/episodes/Ep4/episode4.rpy:1163
translate HZIlle ep4_party_staircase_ff_2198008d:

#   mc "Not a chance. She's my sister."
    mc "Ni hablar, es mi hermana."

# game/episodes/Ep4/episode4.rpy:1165
translate HZIlle ep4_party_staircase_ff_ed85d255:

#   ff "Shit..."
    ff "Mierda..."

# game/episodes/Ep4/episode4.rpy:1166
translate HZIlle ep4_party_staircase_ff_b29dc1f5:

#   ff "Hitting up strangers for life changing opportunities is harder than I thought."
    ff "Pedir a desconocidos oportunidades que cambian la vida es más difícil de lo que pensaba."

# game/episodes/Ep4/episode4.rpy:1168
translate HZIlle ep4_party_staircase_ff_fb476872:

#   mc "I only know a couple of people, but I could ask around."
    mc "Sólo conozco a un par de personas, pero podría preguntar por ahí."

# game/episodes/Ep4/episode4.rpy:1169
translate HZIlle ep4_party_staircase_ff_3c42a95c:

#   ff "I'd be so grateful! Ehh... I'll get a drink first."
    ff "Te lo agradecería mucho! Ehh... Primero me tomaré una copa."

# game/episodes/Ep4/episode4.rpy:1171
translate HZIlle ep4_party_staircase_ff_f35b55f1:

#   mc "No, no! Let me... We'll come up with a strategy while drunk."
    mc "¡No, no! Déjame... Idearemos una estrategia estando borrachos."

# game/episodes/Ep4/episode4.rpy:1186
translate HZIlle ep4_party_staircase_ff_2_7a7f7d2b:

#   mc "Here you go!"
    mc "Aquí tienes"

# game/episodes/Ep4/episode4.rpy:1188
translate HZIlle ep4_party_staircase_ff_2_6c494895:

#   ff "I'm not sure if it's my kind of party..."
    ff "No estoy seguro de que sea mi tipo de fiesta..."

# game/episodes/Ep4/episode4.rpy:1189
translate HZIlle ep4_party_staircase_ff_2_b06e4d58:

#   ff "I'm fine with alcohol, but have you seen all the drugs?"
    ff "Me parece bien el alcohol, pero ¿has visto todas las drogas?"

# game/episodes/Ep4/episode4.rpy:1191
translate HZIlle ep4_party_staircase_ff_2_2707e90f:

#   ff "Weed? Cocaine? It's like a perfect receipe to cook a disaster."
    ff "¿Hierba? ¿Cocaína? Es como una receta perfecta para cocinar un desastre."

# game/episodes/Ep4/episode4.rpy:1192
translate HZIlle ep4_party_staircase_ff_2_4839e807:

#   mc "So, what's your idea of a good party?"
    mc "¿Cuál es tu idea de una buena fiesta?"

# game/episodes/Ep4/episode4.rpy:1194
translate HZIlle ep4_party_staircase_ff_2_7da7c68d:

#   ff "People I know. People I like."
    ff "Gente que conozco, gente que me gusta."

# game/episodes/Ep4/episode4.rpy:1195
translate HZIlle ep4_party_staircase_ff_2_9f7a7ab9:

#   ff "Fun and games."
    ff "Diversión y juegos."

# game/episodes/Ep4/episode4.rpy:1197
translate HZIlle ep4_party_staircase_ff_2_01704fac:

#   ff "Maybe some nerdy stuff."
    ff "Tal vez algunas cosas de empollones."

# game/episodes/Ep4/episode4.rpy:1198
translate HZIlle ep4_party_staircase_ff_2_9504c884:

#   mc "Nerdy, in what sense?"
    mc "¿Idiota, en qué sentido?"

# game/episodes/Ep4/episode4.rpy:1200
translate HZIlle ep4_party_staircase_ff_2_6c746242:

#   ff "Like a movie... or a board game. Getting wasted and fucking everything that looks my way... Not quite."
    ff "Como una película... o un juego de mesa. Emborracharme y follarme a todo lo que se cruce en mi camino... No del todo."

# game/episodes/Ep4/episode4.rpy:1201
translate HZIlle ep4_party_staircase_ff_2_e69b666d:

#   mc "How about dancing? Or better yet, karaoke!"
    mc "¿Qué te parece bailar? O mejor aún, ¡el karaoke!"

# game/episodes/Ep4/episode4.rpy:1203
translate HZIlle ep4_party_staircase_ff_2_d5c49769:

#   ff "Hahaha! I have the voice of an angel!"
    ff "¡Jajaja! ¡Tengo la voz de un ángel!"

# game/episodes/Ep4/episode4.rpy:1205
translate HZIlle ep4_party_staircase_ff_2_61747d93:

#   mc "Hmmm... Was this angel banished to hell, by any chance?"
    mc "Hmmm... ¿Por casualidad este ángel fue desterrado al infierno?"

# game/episodes/Ep4/episode4.rpy:1206
translate HZIlle ep4_party_staircase_ff_2_e32f260c:

#   ff "You did not just say that! I'm a decent singer!"
    ff "¡No acabas de decir eso! ¡Soy un cantante decente!"

# game/episodes/Ep4/episode4.rpy:1208
translate HZIlle ep4_party_staircase_ff_2_bae99522:

#   ff "My shower can vouch for me."
    ff "Mi ducha puede dar fe de mí."

# game/episodes/Ep4/episode4.rpy:1209
translate HZIlle ep4_party_staircase_ff_2_dd5ce4f2:

#   ff "Also, I have a degree in trust-me-brology."
    ff "Además, tengo un título en confianza-me-brología."

# game/episodes/Ep4/episode4.rpy:1211
translate HZIlle ep4_party_staircase_ff_2_ce616462:

#   mc "Got it! Do not let you near a mic. How about your moves?"
    mc "¡Lo tengo! No te dejo acercarte a un micro. ¿Qué tal tus movimientos?"

# game/episodes/Ep4/episode4.rpy:1212
translate HZIlle ep4_party_staircase_ff_2_f4b87446:

#   ff "What do you think?"
    ff "¿Qué te parece?"

# game/episodes/Ep4/episode4.rpy:1214
translate HZIlle ep4_party_staircase_ff_2_1cafb13d:

#   mc "I think you've got... crazy moves."
    mc "Creo que tienes... movimientos locos."

# game/episodes/Ep4/episode4.rpy:1215
translate HZIlle ep4_party_staircase_ff_2_7e22d07c:

#   ff "On par with my singing skills!"
    ff "¡A la par que mis dotes de cantante!"

# game/episodes/Ep4/episode4.rpy:1217
translate HZIlle ep4_party_staircase_ff_2_88742b53:

#   mc "Ready to give them a whirl?"
    mc "¿Listo para probarlos?"

# game/episodes/Ep4/episode4.rpy:1218
translate HZIlle ep4_party_staircase_ff_2_5dd6c398:

#   ff "Nobody's dancing."
    ff "Nadie baila."

# game/episodes/Ep4/episode4.rpy:1220
translate HZIlle ep4_party_staircase_ff_2_7548d236:

#   mc "Yet!"
    mc "¡Todavía!"

# game/episodes/Ep4/episode4.rpy:1222
translate HZIlle ep4_party_staircase_ff_2_02965c5c:

#   mc "Want all eyes on you? Stand out in the crowd."
    mc "¿Quieres que todos te miren? Destaca entre la multitud."

# game/episodes/Ep4/episode4.rpy:1223
translate HZIlle ep4_party_staircase_ff_2_4f1ff32e:

#   ff "Not without liquid courage!"
    ff "¡No sin valor líquido!"

# game/episodes/Ep4/episode4.rpy:1225
translate HZIlle ep4_party_staircase_ff_2_3be2f197:

#   mc "Damn... That went fast."
    mc "Maldita sea... Eso ha ido rápido."

# game/episodes/Ep4/episode4.rpy:1226
translate HZIlle ep4_party_staircase_ff_2_8fba352a:

#   mc "Looks like you handle alcohol just fine."
    mc "Parece que manejas bien el alcohol."

# game/episodes/Ep4/episode4.rpy:1228
translate HZIlle ep4_party_staircase_ff_2_7d583c4d:

#   ff "Hey, don't judge!"
    ff "Oye, ¡no juzgues!"

# game/episodes/Ep4/episode4.rpy:1229
translate HZIlle ep4_party_staircase_ff_2_e59a607d:

#   ff "I'm getting another one..."
    ff "Voy a comprar otro..."

# game/episodes/Ep4/episode4.rpy:1240
translate HZIlle ep4_party_corridor_f_5339f61d:

#   f "Hop on the elevator, you've got a party waiting up top."
    f "Sube al ascensor, arriba te espera una fiesta."

# game/episodes/Ep4/episode4.rpy:1241
translate HZIlle ep4_party_corridor_f_76e13ac4:

#   mc "I just came here to talk."
    mc "Sólo he venido a hablar."

# game/episodes/Ep4/episode4.rpy:1243
translate HZIlle ep4_party_corridor_f_8b698a7e:

#   f "About? Your new girlfriend?"
    f "¿Sobre? ¿Tu nueva novia?"

# game/episodes/Ep4/episode4.rpy:1244
translate HZIlle ep4_party_corridor_f_0fab7f0e:

#   mc "When it comes to getting under people's skin, [n] has no match. Give her a glimpse of vulnerability, say, a tad bit of jealousy, and she'll dive right in."
    mc "Cuando se trata de meterse en la piel de la gente, [n] no tiene rival. Dale un atisbo de vulnerabilidad, digamos, un poquito de celos, y se zambullirá de lleno."

# game/episodes/Ep4/episode4.rpy:1246
translate HZIlle ep4_party_corridor_f_dcc65986:

#   mc "Just don't pay attention to her."
    mc "No le prestes atención."

# game/episodes/Ep4/episode4.rpy:1247
translate HZIlle ep4_party_corridor_f_297664e8:

#   f "Thanks for the advice, but I'm not jealous..."
    f "Gracias por el consejo, pero no estoy celoso..."

# game/episodes/Ep4/episode4.rpy:1249
translate HZIlle ep4_party_corridor_f_053d08d0:

