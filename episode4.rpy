translate HZIlle ep4_party_2_table_n_48ea8301:

#   mc "Small issue, though."
    mc "Pequeño problema, sin embargo."

# game/episodes/Ep4/episode4.rpy:2194
translate HZIlle ep4_party_2_table_n_69b89f5b:

#   mc "All we've got is that it's happening – nothing more."
    mc "Todo lo que tenemos es que está ocurriendo, nada más."

# game/episodes/Ep4/episode4.rpy:2196
translate HZIlle ep4_party_2_table_n_837dcf10:

#   n "That's where [v] comes in."
    n "Ahí es donde entra [v]."

# game/episodes/Ep4/episode4.rpy:2197
translate HZIlle ep4_party_2_table_n_00af8f22:

#   n "Stay tight with the app people and [v] will do her thing."
    n "Mantente firme con la gente de la aplicación y [v] hará lo suyo."

# game/episodes/Ep4/episode4.rpy:2199
translate HZIlle ep4_party_2_table_n_0de30d97:

#   n "And let's hope for the best."
    n "Y esperemos lo mejor."

# game/episodes/Ep4/episode4.rpy:2200
translate HZIlle ep4_party_2_table_n_3ab180c4:

#   mc "Got it!"
    mc "Entendido."

# game/episodes/Ep4/episode4.rpy:2202
translate HZIlle ep4_party_2_table_n_de9b0c17:

#   n "Well, what are you waiting for?! Get to work!"
    n "Bueno, ¡a qué esperas! ¡Ponte manos a la obra!"

# game/episodes/Ep4/episode4.rpy:2203
translate HZIlle ep4_party_2_table_n_e54d80da:

#   mc "Five more minutes? I'm petitioning for an endless dance-a-thon with you!"
    mc "¿Cinco minutos más? ¡Pido un maratón de baile interminable contigo!"

# game/episodes/Ep4/episode4.rpy:2205
translate HZIlle ep4_party_2_table_n_2631e151:

#   n "You are an idiot."
    n "Eres idiota."

# game/episodes/Ep4/episode4.rpy:2206
translate HZIlle ep4_party_2_table_n_7c2f9675:

#   n "Fine. Five more minutes."
    n "Bien. Cinco minutos más."

# game/episodes/Ep4/episode4.rpy:2218
translate HZIlle ep4_party_2_table_n_6e5884fa:

#   mct "I still need to get [n] a drink."
    mct "Todavía tengo que conseguir [n] una bebida."

# game/episodes/Ep4/episode4.rpy:2228
translate HZIlle ep4_party_2_corridor_gg_f3ab2af9:

#   mc "[gg]? Oh my..."
    mc "[gg] Oh Dios..."

# game/episodes/Ep4/episode4.rpy:2229
translate HZIlle ep4_party_2_corridor_gg_6c0ba0c9:

#   mc "I like what's going on here!"
    mc "¡Me gusta lo que está pasando aquí!"

# game/episodes/Ep4/episode4.rpy:2231
translate HZIlle ep4_party_2_corridor_gg_590ca027:

#   gg "Thanks. Just blending in, not here to party."
    gg "Gracias. Sólo me mezclo, no estoy aquí de fiesta."

# game/episodes/Ep4/episode4.rpy:2232
translate HZIlle ep4_party_2_corridor_gg_8f183e0e:

#   mc "Ah, I see. 'The party just got better' line is out then?"
    mc "Ah, ya veo. ¿La frase \"La fiesta acaba de mejorar\" está descartada entonces?"

# game/episodes/Ep4/episode4.rpy:2234
translate HZIlle ep4_party_2_corridor_gg_c1422437:

#   gg "Fun's on standby at the moment."
    gg "La diversión está en espera en este momento."

# game/episodes/Ep4/episode4.rpy:2235
translate HZIlle ep4_party_2_corridor_gg_412905c1:

#   mc "Did you get your answer from [z]?"
    mc "¿Obtuviste tu respuesta de [z]?"

# game/episodes/Ep4/episode4.rpy:2237
translate HZIlle ep4_party_2_corridor_gg_ae7180b4:

#   gg "Hmm..."
    gg "Hmm..."

# game/episodes/Ep4/episode4.rpy:2238
translate HZIlle ep4_party_2_corridor_gg_28982079:

#   gg "If he'd answered, would I even be here?"
    gg "Si hubiera contestado, ¿estaría yo aquí?"

# game/episodes/Ep4/episode4.rpy:2240
translate HZIlle ep4_party_2_corridor_gg_b81bcf35:

#   mc "I take it as a no..."
    mc "Lo tomo como un no..."

# game/episodes/Ep4/episode4.rpy:2242
translate HZIlle ep4_party_2_corridor_gg_27807e55:

#   gg "I've waited long enough. The big guy's indecision won't hold me back."
    gg "Ya he esperado bastante. La indecisión del grandullón no me detendrá."

# game/episodes/Ep4/episode4.rpy:2243
translate HZIlle ep4_party_2_corridor_gg_99654a24:

#   gg "I'm a sitting duck! No protection from [z]. [hns] wants me... dead or working for them."
    gg "Soy un blanco fácil, sin protección frente a [z]. [hns] me quiere... muerto o trabajando para ellos."

# game/episodes/Ep4/episode4.rpy:2244
translate HZIlle ep4_party_2_corridor_gg_02596126:

#   gg "[z] had his chance and he blew it."
    gg "[z] tuvo su oportunidad y la desaprovechó."

# game/episodes/Ep4/episode4.rpy:2246
translate HZIlle ep4_party_2_corridor_gg_3bd3947f:

#   mc "Yeah, only one option for you. I get it."
    mc "Sí, para ti sólo hay una opción, lo entiendo."

# game/episodes/Ep4/episode4.rpy:2248
translate HZIlle ep4_party_2_corridor_gg_9926a6c6:

#   gg "Why are you here?"
    gg "¿Por qué estás aquí?"

# game/episodes/Ep4/episode4.rpy:2249
translate HZIlle ep4_party_2_corridor_gg_49e2292b:

#   mc "What do you mean why? It's a party!"
    mc "¿Cómo que por qué? ¡Es una fiesta!"

# game/episodes/Ep4/episode4.rpy:2251
translate HZIlle ep4_party_2_corridor_gg_168dc0e2:

#   gg "We both know it's not just a party. Everone's here for something."
    gg "Ambos sabemos que no es sólo una fiesta. Todos están aquí por algo."

# game/episodes/Ep4/episode4.rpy:2252
translate HZIlle ep4_party_2_corridor_gg_60d7b3ea:

#   gg "Besides, these are your enemies."
    gg "Además, son tus enemigos."

# game/episodes/Ep4/episode4.rpy:2254
translate HZIlle ep4_party_2_corridor_gg_d9abb5da:

#   mc "Nobody killed me yet."
    mc "Nadie me ha matado todavía."

# game/episodes/Ep4/episode4.rpy:2255
translate HZIlle ep4_party_2_corridor_gg_0e5e0954:

#   gg "Phantom Policy does mean something, after all."
    gg "Al fin y al cabo, la Política Fantasma significa algo."

# game/episodes/Ep4/episode4.rpy:2258
translate HZIlle ep4_party_2_corridor_gg_9d4910d5:

#   mc "No killing?"
    mc "¿No matar?"

# game/episodes/Ep4/episode4.rpy:2259
translate HZIlle ep4_party_2_corridor_gg_3af24827:

#   gg "No killing at the party."
    gg "No matar en la fiesta."

# game/episodes/Ep4/episode4.rpy:2261
translate HZIlle ep4_party_2_corridor_gg_d85a3ac5:

#   mc "Which is?"
    mc "¿Cuál es?"

# game/episodes/Ep4/episode4.rpy:2262
translate HZIlle ep4_party_2_corridor_gg_ad55c37b:

#   gg "So you didn't know? Dear god."
    gg "¿Así que no lo sabías? Dios mío."

# game/episodes/Ep4/episode4.rpy:2266
translate HZIlle ep4_party_2_corridor_gg_e6f74baf:

#   mc "See? I'm fine."
    mc "¿Ves? Estoy bien."

# game/episodes/Ep4/episode4.rpy:2267
translate HZIlle ep4_party_2_corridor_gg_742b48a6:

#   gg "I'd be more concerned about [z] if I were you."
    gg "Yo que tú me preocuparía más por [z]."

# game/episodes/Ep4/episode4.rpy:2269
translate HZIlle ep4_party_2_corridor_gg_a69f7c68:

#   mc "No need. He knows."
    mc "No hace falta, él lo sabe."

# game/episodes/Ep4/episode4.rpy:2270
translate HZIlle ep4_party_2_corridor_gg_f9036fff:

#   gg "If that's really the case, and I doubt it is, his trust in you is truly remarkable."
    gg "Si realmente es así, y lo dudo, su confianza en ti es realmente notable."

# game/episodes/Ep4/episode4.rpy:2272
translate HZIlle ep4_party_2_corridor_gg_54bf2a25:

#   gg "Or... You're not just partying. You're on a mission."
    gg "O... No sólo estás de fiesta, sino que tienes una misión."

# game/episodes/Ep4/episode4.rpy:2273
translate HZIlle ep4_party_2_corridor_gg_e14cd690:

#   mc "I told you too much, didn't I?"
    mc "Te he contado demasiado, ¿verdad?"

# game/episodes/Ep4/episode4.rpy:2275
translate HZIlle ep4_party_2_corridor_gg_6ca657c6:

#   gg "Your secret is safe with me."
    gg "Tu secreto está a salvo conmigo."

# game/episodes/Ep4/episode4.rpy:2278
translate HZIlle ep4_party_2_corridor_gg_76320599:

#   mc "Since we're sharing secrets, is the offer from the app really the sole reason you've come?"
    mc "Ya que estamos compartiendo secretos, ¿es realmente la oferta de la aplicación la única razón por la que has venido?"

# game/episodes/Ep4/episode4.rpy:2279
translate HZIlle ep4_party_2_corridor_gg_3b0df070:

#   gg "Positive. Almost."
    gg "Positivo. Casi."

# game/episodes/Ep4/episode4.rpy:2281
translate HZIlle ep4_party_2_corridor_gg_d8b38e1e:

#   gg "If you haven't already noticed, [op] was my father, and I'm certain one of the app people killed him."
    gg "Por si aún no te has dado cuenta, [op] era mi padre, y estoy seguro de que uno de los de la app lo mató."

# game/episodes/Ep4/episode4.rpy:2282
translate HZIlle ep4_party_2_corridor_gg_4f9d7685:

#   gg "I'll hunt down the one responsible. Even if I have to rid myself of all Morph supplies."
    gg "Cazaré al responsable, aunque tenga que deshacerme de todos los suministros Morph."

# game/episodes/Ep4/episode4.rpy:2283
translate HZIlle ep4_party_2_corridor_gg_63f233da:

#   mc "I'm... sorry for your loss."
    mc "Siento... tu pérdida."

# game/episodes/Ep4/episode4.rpy:2285
translate HZIlle ep4_party_2_corridor_gg_f4ca578b:

#   gg "Why?"
    gg "¿Por qué?"

# game/episodes/Ep4/episode4.rpy:2286
translate HZIlle ep4_party_2_corridor_gg_97548592:

#   mc "You lost a family member, I mean... There is no need to play tough."
    mc "Has perdido a un familiar... No hace falta hacerse el duro."

# game/episodes/Ep4/episode4.rpy:2288
translate HZIlle ep4_party_2_corridor_gg_6a3d9c52:

#   gg "If [op] had seen me in tears, he'd come back, kill me, and then return to the dead."
    gg "Si [op] me hubiera visto llorando, volvería, me mataría y luego regresaría a los muertos."

# game/episodes/Ep4/episode4.rpy:2289
translate HZIlle ep4_party_2_corridor_gg_7fa24df0:

#   gg "I don't need pity. I need revenge."
    gg "No necesito compasión, sino venganza."

# game/episodes/Ep4/episode4.rpy:2290
translate HZIlle ep4_party_2_corridor_gg_ad09b856:

#   mc "Shit."
    mc "Mierda."

# game/episodes/Ep4/episode4.rpy:2292
translate HZIlle ep4_party_2_corridor_gg_df4cbae3:

#   gg "And don't tell me it was you..."
    gg "Y no me digas que fuiste tú..."

# game/episodes/Ep4/episode4.rpy:2293
translate HZIlle ep4_party_2_corridor_gg_936c0183:

#   mc "No fucking way!"
    mc "¡Ni de coña!"

# game/episodes/Ep4/episode4.rpy:2295
translate HZIlle ep4_party_2_corridor_gg_e37b90eb:

#   mc "I didn't take you to be so... intense."
    mc "No pensaba que fueras tan... intensa."

# game/episodes/Ep4/episode4.rpy:2296
translate HZIlle ep4_party_2_corridor_gg_5dff3a0d:

#   gg "Don't trust what you see, [mc]."
    gg "No te fíes de lo que veas, [mc]."

# game/episodes/Ep4/episode4.rpy:2298
translate HZIlle ep4_party_2_corridor_gg_442e3d85:

#   mc "If there's anything..."
    mc "Si hay algo..."

# game/episodes/Ep4/episode4.rpy:2299
translate HZIlle ep4_party_2_corridor_gg_5f3d1f19:

#   gg "Sure, I'll hit you up."
    gg "Claro, te llamaré."

# game/episodes/Ep4/episode4.rpy:2302
translate HZIlle ep4_party_2_corridor_gg_0ad60cf2:

#   gg "Oh. How's your lasered friend? Alive and unscorched?"
    gg "¿Cómo está tu amigo herido por el láser? ¿Vivo y sin cicatrices?"

# game/episodes/Ep4/episode4.rpy:2303
translate HZIlle ep4_party_2_corridor_gg_e2358cd9:

#   mc "Not a friend. She's actually my sister..."
    mc "No es una amiga, en realidad es mi hermana..."

# game/episodes/Ep4/episode4.rpy:2305
translate HZIlle ep4_party_2_corridor_gg_a3639456:

#   mc "And yes, she's with me at the party."
    mc "Y sí, está conmigo en la fiesta."

# game/episodes/Ep4/episode4.rpy:2307
translate HZIlle ep4_party_2_corridor_gg_8a787517:

#   gg "Sister... Yeah."
    gg "Hermana... Sí."

# game/episodes/Ep4/episode4.rpy:2308
translate HZIlle ep4_party_2_corridor_gg_2eb212a9:

#   gg "Cool. Can't wait to meet the female [mc]."
    gg "Genial, estoy deseando conocer a la hembra [mc]."

# game/episodes/Ep4/episode4.rpy:2310
translate HZIlle ep4_party_2_corridor_gg_ee726253:

#   mc "Don't tell her that."
    mc "No se lo digas."

# game/episodes/Ep4/episode4.rpy:2312
translate HZIlle ep4_party_2_corridor_gg_3a997ff9:

#   gg "Haha. You're the personification of all that's evil?"
    gg "Jaja ¿Eres la personificación de todo lo malo?"

# game/episodes/Ep4/episode4.rpy:2313
translate HZIlle ep4_party_2_corridor_gg_f87581d9:

#   mc "In her eyes? Evil and lame."
    mc "¿A sus ojos? Malvada y coja."

# game/episodes/Ep4/episode4.rpy:2315
translate HZIlle ep4_party_2_corridor_gg_5a315c3b:

#   gg "Such a terrible combo."
    gg "Una combinación terrible."

# game/episodes/Ep4/episode4.rpy:2316
translate HZIlle ep4_party_2_corridor_gg_283923e1:

#   gg "Anyway, I'm glad she's ok."
    gg "De todos modos, me alegro de que esté bien."

# game/episodes/Ep4/episode4.rpy:2318
translate HZIlle ep4_party_2_corridor_gg_38a8db45:

#   mc "Thanks for saving our asses."
    mc "Gracias por salvarnos el culo."

# game/episodes/Ep4/episode4.rpy:2319
translate HZIlle ep4_party_2_corridor_gg_44d0e5a6:

#   gg "Anytime."
    gg "En cualquier momento."

# game/episodes/Ep4/episode4.rpy:2326
translate HZIlle ep4_party_2_corridor_gg_9a096115:

#   mc "Good luck with your business!"
    mc "¡Buena suerte con tu negocio!"

# game/episodes/Ep4/episode4.rpy:2327
translate HZIlle ep4_party_2_corridor_gg_8f5ac21d:

#   mc "See you around."
    mc "Nos vemos."

# game/episodes/Ep4/episode4.rpy:2332
translate HZIlle ep4_party_2_corridor_gg_1365b575:

#   mc "Business aside, what's your game plan for the pleasure part of the evening?"
    mc "Dejando a un lado los negocios, ¿cuál es tu plan para la parte placentera de la velada?"

# game/episodes/Ep4/episode4.rpy:2333
translate HZIlle ep4_party_2_corridor_gg_528d4435:

#   gg "Hmmm... Many, many things."
    gg "Hmmm... Muchas, muchas cosas."

# game/episodes/Ep4/episode4.rpy:2335
translate HZIlle ep4_party_2_corridor_gg_574a4435:

#   mc "Drinking, dancing... Anything else?"
    mc "Beber, bailar... ¿Algo más?"

# game/episodes/Ep4/episode4.rpy:2336
translate HZIlle ep4_party_2_corridor_gg_a000a70f:

#   gg "No drinking."
    gg "No beber."

# game/episodes/Ep4/episode4.rpy:2338
translate HZIlle ep4_party_2_corridor_gg_c6fb1b00:

#   gg "And no fucking dancing."
    gg "Y nada de bailar, joder."

# game/episodes/Ep4/episode4.rpy:2339
translate HZIlle ep4_party_2_corridor_gg_de9e1897:

#   mc "Oh. Such a shame!"
    mc "¡Qué pena!"

# game/episodes/Ep4/episode4.rpy:2341
translate HZIlle ep4_party_2_corridor_gg_db5b7d9d:

#   gg "If you want to see my body move, there are other ways. Just so you know."
    gg "Si quieres ver cómo se mueve mi cuerpo, hay otras formas, para que lo sepas."

# game/episodes/Ep4/episode4.rpy:2342
translate HZIlle ep4_party_2_corridor_gg_984008c9:

#   mc "Count me in!"
    mc "¡Cuenta conmigo!"

# game/episodes/Ep4/episode4.rpy:2344
translate HZIlle ep4_party_2_corridor_gg_85507a27:

#   gg "But that's still not all."
    gg "Pero eso no es todo."

# game/episodes/Ep4/episode4.rpy:2345
translate HZIlle ep4_party_2_corridor_gg_d9af6597:

#   mc "No?"
    mc "¿No?"

# game/episodes/Ep4/episode4.rpy:2347
translate HZIlle ep4_party_2_corridor_gg_4d3fb942:

#   gg "I see your innocent, excited face and I already know you're not gonna like the answer."
    gg "Veo tu cara inocente y excitada y ya sé que no te va a gustar la respuesta."

# game/episodes/Ep4/episode4.rpy:2348
translate HZIlle ep4_party_2_corridor_gg_eeff9a0b:

#   gg "Drugs."
    gg "Drogas."

# game/episodes/Ep4/episode4.rpy:2350
translate HZIlle ep4_party_2_corridor_gg_cb242a8e:

#   mc "What kind?"
    mc "¿De qué tipo?"

# game/episodes/Ep4/episode4.rpy:2351
translate HZIlle ep4_party_2_corridor_gg_0c7bedfd:

#   gg "All kinds. The stronger, the better."
    gg "De todo tipo. Cuanto más fuerte, mejor."

# game/episodes/Ep4/episode4.rpy:2357
translate HZIlle ep4_party_2_corridor_gg_ad909a8e:

#   mc "Hmmm..."
    mc "Hmmm..."

# game/episodes/Ep4/episode4.rpy:2358
translate HZIlle ep4_party_2_corridor_gg_23d78a00:

#   gg "Still deciding?"
    gg "¿Todavía te estás decidiendo?"

# game/episodes/Ep4/episode4.rpy:2360
translate HZIlle ep4_party_2_corridor_gg_c3e2184f:

#   mc "Yeah, I'm in."
    mc "Sí, me apunto."

# game/episodes/Ep4/episode4.rpy:2362
translate HZIlle ep4_party_2_corridor_gg_f882fae1:

#   gg "Haha. But I didn't mean YOU taking part..."
    gg "Jaja, pero no me refería a que participaras TÚ..."

# game/episodes/Ep4/episode4.rpy:2363
translate HZIlle ep4_party_2_corridor_gg_befae213:

#   mc "There is always a first time for everything."
    mc "Siempre hay una primera vez para todo."

# game/episodes/Ep4/episode4.rpy:2368
translate HZIlle ep4_party_2_corridor_gg_e2666a35:

#   mc "Oh. That's a big no-no for me."
    mc "Eso es un gran no-no para mí."

# game/episodes/Ep4/episode4.rpy:2369
translate HZIlle ep4_party_2_corridor_gg_3e1bef35:

#   gg "I get it."
    gg "Lo entiendo."

# game/episodes/Ep4/episode4.rpy:2375
translate HZIlle ep4_party_2_corridor_gg_edf1b5e3:

#   mc "I mean, it's your choice. You do you."
    mc "Es tu elección, hazlo tú."

# game/episodes/Ep4/episode4.rpy:2376
translate HZIlle ep4_party_2_corridor_gg_6761e399:

#   gg "Thanks for letting me do what I would do anyway, boyfriend."
    gg "Gracias por dejarme hacer lo que haría de todos modos, novio."

# game/episodes/Ep4/episode4.rpy:2383
translate HZIlle ep4_party_2_corridor_gg_5f10d56f:

#   mc "You're way too smoking hot to let hard drugs mess you up."
    mc "Estás demasiado buena para dejar que las drogas duras te estropeen."

# game/episodes/Ep4/episode4.rpy:2384
translate HZIlle ep4_party_2_corridor_gg_d5d3a8b9:

#   gg "Thanks. I don't need your approval, tho."
    gg "Gracias, aunque no necesito tu aprobación."

# game/episodes/Ep4/episode4.rpy:2386
translate HZIlle ep4_party_2_corridor_gg_4b666cd3:

#   mc "How about a counter-offer?"
    mc "¿Qué tal una contraoferta?"

# game/episodes/Ep4/episode4.rpy:2387
translate HZIlle ep4_party_2_corridor_gg_5a24ba4a:

#   gg "Shoot."
    gg "Dispara."

# game/episodes/Ep4/episode4.rpy:2389
translate HZIlle ep4_party_2_corridor_gg_a89d79d4:

#   mc "No hard drugs tonight in exchange for Morph... and some fun with me."
    mc "Nada de drogas duras esta noche a cambio de Morph... y un poco de diversión conmigo."

