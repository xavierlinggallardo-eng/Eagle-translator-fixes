#   ti "YES!"
    ti "¡SÍ!"

# game/episodes/Ep4/episode4.rpy:1070
translate HZIlle ep4_party_table_ti_f13315b5:

#   ti "I mean, no... I'm just here to party, my man."
    ti "Quiero decir, no... Sólo estoy aquí para divertirme, amigo."

# game/episodes/Ep4/episode4.rpy:1071
translate HZIlle ep4_party_table_ti_8477d713:

#   mc "Which is it, then? Party or [hns]?"
    mc "¿Qué es, entonces? ¿Partido o [hns]?"

