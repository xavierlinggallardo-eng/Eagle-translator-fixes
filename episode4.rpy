#   ti "And I don't?!"
    ti "¿Y yo no?"

# game/episodes/Ep4/episode4.rpy:1049
translate HZIlle ep4_party_table_lucti_894d6de3:

#   luc "That's not what I said... What I was trying to say..."
    luc "Eso no es lo que he dicho... Lo que intentaba decir..."

# game/episodes/Ep4/episode4.rpy:1051
translate HZIlle ep4_party_table_lucti_e16ac57f:

#   ti "Just... shut up. Please. Before I beat you up."
    ti "Cállate, por favor, antes de que te dé una paliza."

# game/episodes/Ep4/episode4.rpy:1053
translate HZIlle ep4_party_table_lucti_f8195bc9:

#   luc "I'm positive that there's someone who will be willing to lend us a helping hand. I truly believe it!"
    luc "Estoy segura de que habrá alguien dispuesto a echarnos una mano, ¡lo creo de verdad!"

# game/episodes/Ep4/episode4.rpy:1055
translate HZIlle ep4_party_table_lucti_92b1eacb:

#   ti "I'm fucked."
    ti "Estoy jodido."

# game/episodes/Ep4/episode4.rpy:1066
translate HZIlle ep4_party_table_ti_d6d3a778:

#   mc "Looking for a way to get back into the game?"
    mc "¿Buscas una forma de volver al juego?"

