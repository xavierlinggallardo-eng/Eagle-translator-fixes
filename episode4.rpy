# game/episodes/Ep4/episode4.rpy:7160
translate HZIlle ep4_planning_z_c57ee995:

#   l "Morph units - at least 2 and ZC."
    l "Unidades Morph - al menos 2 y ZC."

# game/episodes/Ep4/episode4.rpy:7162
translate HZIlle ep4_planning_z_93bd531d:

#   r "Do we even need drugs?"
    r "¿Necesitamos siquiera drogas?"

# game/episodes/Ep4/episode4.rpy:7164
translate HZIlle ep4_planning_z_935427a7:

#   z "We might not use it, but it's safer in our hands than in [hns]'s."
    z "Puede que no la utilicemos, pero está más segura en nuestras manos que en las de [hns]."

# game/episodes/Ep4/episode4.rpy:7165
translate HZIlle ep4_planning_z_bba6aae1:

#   z "And the truck? I doubt the military would grant it access without oversight."
    z "¿Y el camión? Dudo que los militares le permitieran el acceso sin supervisión."

# game/episodes/Ep4/episode4.rpy:7167
translate HZIlle ep4_planning_z_714a3e98:

#   r "The fucking drugs fly under the radar. No chance they send tanks and choppers."
    r "Las putas drogas vuelan bajo el radar. No hay posibilidad de que envíen tanques y helicópteros."

# game/episodes/Ep4/episode4.rpy:7169
translate HZIlle ep4_planning_z_0851bb33:

#   z "Still, we have to expect backup."
    z "Aun así, tenemos que esperar refuerzos."

# game/episodes/Ep4/episode4.rpy:7171
translate HZIlle ep4_planning_z_17eea772:

#   l "Oh, yes, yes. One patrol, according to the data."
    l "Sí, sí. Una patrulla, según los datos."

# game/episodes/Ep4/episode4.rpy:7172
translate HZIlle ep4_planning_z_05cf1fd7:

#   z "Not enough. Even if the plan says one, expect two. Minimum."
    z "No es suficiente. Aunque el plan diga uno, espera dos. Mínimo."

# game/episodes/Ep4/episode4.rpy:7174
translate HZIlle ep4_planning_z_da6eca5c:

#   mc "Should we get in touch with [pol1]? She's not gonna be happy about this."
    mc "¿Deberíamos ponernos en contacto con [pol1]? No se va a alegrar de esto."

# game/episodes/Ep4/episode4.rpy:7176
translate HZIlle ep4_planning_z_4a16add8:

#   z "She never is."
    z "Nunca lo está."

# game/episodes/Ep4/episode4.rpy:7178
translate HZIlle ep4_planning_z_ea65b45e:

#   r "How much time do we have?"
    r "¿De cuánto tiempo disponemos?"

# game/episodes/Ep4/episode4.rpy:7180
translate HZIlle ep4_planning_z_1e4cb594:

#   l "7 hours."
    l "7 horas."

# game/episodes/Ep4/episode4.rpy:7182
translate HZIlle ep4_planning_z_e6c59350:

#   r "Fuck!"
    r "¡Joder!"

# game/episodes/Ep4/episode4.rpy:7184
translate HZIlle ep4_planning_z_bcf4ccd4:

#   l "We'll be ready, 100%%."
    l "Estaremos preparados, al 100%%."

# game/episodes/Ep4/episode4.rpy:7186
translate HZIlle ep4_planning_z_bf48c9fe:

#   z "Just the two of you?"
    z "¿Sólo vosotros dos?"

# game/episodes/Ep4/episode4.rpy:7188
translate HZIlle ep4_planning_z_69b4ab5c:

#   l "We'll handle the app, right [mc]?"
    l "Nosotros nos encargaremos de la aplicación, ¿verdad [mc]?"

# game/episodes/Ep4/episode4.rpy:7190
translate HZIlle ep4_planning_z_9fc135e4:

#   mc "If we get automatic weapons."
    mc "Si conseguimos armas automáticas."

# game/episodes/Ep4/episode4.rpy:7191
translate HZIlle ep4_planning_z_cf1c662f:

#   z "You will."
    z "Lo harás."

# game/episodes/Ep4/episode4.rpy:7193
translate HZIlle ep4_planning_z_a2f4270b:

#   r "Nah, nah, nah! I want [sa] there, too."
    r "No, no, no! Yo también quiero [sa] allí."

# game/episodes/Ep4/episode4.rpy:7195
translate HZIlle ep4_planning_z_814646a7:

#   z "An exceptional shooter. Higher chances of success, right?"
    z "Un tirador excepcional. Mayores posibilidades de éxito, ¿no?"

# game/episodes/Ep4/episode4.rpy:7197
translate HZIlle ep4_planning_z_c1ceb4d4:

#   r "And keeping an eye on the rookies."
    r "Y vigila a los novatos."

# game/episodes/Ep4/episode4.rpy:7199
translate HZIlle ep4_planning_z_ff3b4c33:

#   mc "I don't mind."
    mc "No me importa."

# game/episodes/Ep4/episode4.rpy:7201
translate HZIlle ep4_planning_z_04b2ddd2:

#   l "Oh, well. It's not like we have a choice..."
    l "Bueno, no es que tengamos elección..."

# game/episodes/Ep4/episode4.rpy:7203
translate HZIlle ep4_planning_z_8b1c3b52:

#   z "So, three of us, against... at least 10 Slayers?"
    z "Entonces, ¿tres de nosotros, contra... al menos 10 Cazadoras?"

# game/episodes/Ep4/episode4.rpy:7204
translate HZIlle ep4_planning_z_fafae0aa:

#   r "Need me to round up more guys?"
    r "¿Necesitas que reúna a más chicos?"

# game/episodes/Ep4/episode4.rpy:7206
translate HZIlle ep4_planning_z_c361df47:

#   l "Absolutely no need."
    l "No es necesario en absoluto."

# game/episodes/Ep4/episode4.rpy:7208
translate HZIlle ep4_planning_z_8a2154a1:

#   mc "Construction workers, plumbers... these are not soldiers."
    mc "Los obreros de la construcción, los fontaneros... no son soldados."

# game/episodes/Ep4/episode4.rpy:7210
translate HZIlle ep4_planning_z_a351472c:

#   z "It's never smart to underestimate the enemy, son."
    z "Nunca es inteligente subestimar al enemigo, hijo."

# game/episodes/Ep4/episode4.rpy:7211
translate HZIlle ep4_planning_z_4972108b:

#   l "[r], maybe you feel like making a comeback?"
    l "[r], ¿quizá tengas ganas de volver?"

# game/episodes/Ep4/episode4.rpy:7213
translate HZIlle ep4_planning_z_9f563d2d:

#   z "Absoutely not!"
    z "Por supuesto que no."

# game/episodes/Ep4/episode4.rpy:7214
translate HZIlle ep4_planning_z_66024f47:

#   r "I... I would kill to put a few bullets in the phone people..."
    r "Yo... mataría por meterle unas cuantas balas a la gente del teléfono..."

# game/episodes/Ep4/episode4.rpy:7216
translate HZIlle ep4_planning_z_2ac271ab:

#   z "You also made a promise to your daughter."
    z "También hiciste una promesa a tu hija."

# game/episodes/Ep4/episode4.rpy:7218
translate HZIlle ep4_planning_z_5a9928b5:

#   r "I miss the fucking action, alright?! I haven't been in a proper shootout in decades."
    r "Echo de menos la puta acción, ¿vale? Hace décadas que no participo en un tiroteo de verdad."

# game/episodes/Ep4/episode4.rpy:7219
translate HZIlle ep4_planning_z_06aaa75e:

#   z "Just like me. Time to pass the torch, [r]. Let the youngsters do the dirty work."
    z "Como yo. Es hora de pasar la antorcha, [r] Deja que los jóvenes hagan el trabajo sucio."

# game/episodes/Ep4/episode4.rpy:7221
translate HZIlle ep4_planning_z_e0640360:

#   z "Three of you against the app... I'm not convinced."
    z "Tres de vosotros en contra de la aplicación... No me convence."

# game/episodes/Ep4/episode4.rpy:7223
translate HZIlle ep4_planning_z_ed344ef9:

#   l "No offense, but three soldiers as a unit are better than herding a bunch of meatheads, right?"
    l "No te ofendas, pero tres soldados como unidad son mejores que arrear a un puñado de cabezas huecas, ¿no?"

# game/episodes/Ep4/episode4.rpy:7225
translate HZIlle ep4_planning_z_7ec6ca9d:

#   z "Your heads are on the line. Quite literally."
    z "Vuestras cabezas están en juego, literalmente."

# game/episodes/Ep4/episode4.rpy:7227
translate HZIlle ep4_planning_z_5df0130e:

#   l "We'll keep our heads exactly where they belong! On our necks! Right?"
    l "Mantendremos nuestras cabezas exactamente donde deben estar! ¡En nuestros cuellos! ¿Verdad?"

# game/episodes/Ep4/episode4.rpy:7229
translate HZIlle ep4_planning_z_3c0bbbee:

#   mc "Absolutely!"
    mc "Por supuesto."

# game/episodes/Ep4/episode4.rpy:7231
translate HZIlle ep4_planning_z_13773b85:

#   r "Let's plan the damn thing!"
    r "¡Planifiquemos la maldita cosa!"

# game/episodes/Ep4/episode4.rpy:7233
translate HZIlle ep4_planning_z_6121584a:

#   z "[cl], stay with the team as they strategize. Document everything. We don't have the luxury of time for redundant questions. "
    z "[cl], quédate con el equipo mientras elaboran la estrategia. Documéntalo todo. No podemos permitirnos el lujo de tener tiempo para preguntas redundantes. "

# game/episodes/Ep4/episode4.rpy:7234
translate HZIlle ep4_planning_z_41db1e27:

#   z "Use the mansion and finish planning before [k] comes back."
    z "Utiliza la mansión y termina la planificación antes de que vuelva [k]."

# game/episodes/Ep4/episode4.rpy:7236
translate HZIlle ep4_planning_z_07f05a36:

#   z "Also..."
    z "Además..."

# game/episodes/Ep4/episode4.rpy:7237
translate HZIlle ep4_planning_z_4845f375:

#   z "If you need to contact anyone, let me know. I'll make a call."
    z "Si necesitas contactar con alguien, dímelo. Haré una llamada."

# game/episodes/Ep4/episode4.rpy:7239
translate HZIlle ep4_planning_z_bc497b0b:

#   cl "If I may..."
    cl "Si me permites..."

# game/episodes/Ep4/episode4.rpy:7240
translate HZIlle ep4_planning_z_f97a30d2:

#   cl "If we know the truck's entry point, why won't just take the car and leave the app empty-handed?"
    cl "Si conocemos el punto de entrada del camión, ¿por qué no coger el coche y dejar la aplicación con las manos vacías?"

# game/episodes/Ep4/episode4.rpy:7242
translate HZIlle ep4_planning_z_617aea09:

#   z "Hmm."
    z "Hmm."

# game/episodes/Ep4/episode4.rpy:7244
translate HZIlle ep4_planning_z_37594e1e:

#   r "Huh..."
    r "Eh..."

# game/episodes/Ep4/episode4.rpy:7246
translate HZIlle ep4_planning_z_14708cd7:

#   l "Running scared is not the way to hit the app. If they can't get this transport, they'll get another. Let's hit them where it hurts."
    l "Huir despavoridos no es la forma de golpear la aplicación. Si no consiguen este transporte, conseguirán otro. Golpeémosles donde les duele."

# game/episodes/Ep4/episode4.rpy:7247
translate HZIlle ep4_planning_z_3d9c7235:

#   l "Dead Slayers on the street? Fuck up their reputation!"
    l "¿Cazadores muertos en la calle? ¡Que se joda su reputación!"

# game/episodes/Ep4/episode4.rpy:7249
translate HZIlle ep4_planning_z_9f0574f5:

#   l "And fuck with their heads!"
    l "¡Y que les jodan la cabeza!"

# game/episodes/Ep4/episode4.rpy:7250
translate HZIlle ep4_planning_z_4ed3a8b6:

#   l "Sending a message is what we're after, not the drug."
    l "Lo que buscamos es enviar un mensaje, no la droga."

# game/episodes/Ep4/episode4.rpy:7252
translate HZIlle ep4_planning_z_3d87fbba:

#   r "Sounds solid to me."
    r "A mí me parece sólido."

# game/episodes/Ep4/episode4.rpy:7254
translate HZIlle ep4_planning_z_5a0fef8b:

#   cl "In that case, we've got the upper hand knowing their every move, right? Let's position our men strategically, wipe them out."
    cl "En ese caso, tenemos ventaja conociendo cada uno de sus movimientos, ¿no? Posicionemos a nuestros hombres estratégicamente, acabemos con ellos."

# game/episodes/Ep4/episode4.rpy:7256
translate HZIlle ep4_planning_z_8fd07122:

#   cl "One army versus the other."
    cl "Un ejército contra el otro."

# game/episodes/Ep4/episode4.rpy:7258
translate HZIlle ep4_planning_z_316152b9:

#   mc "Kill them all, absolutely. But no need for an army. [l], [sa] and myself are enough."
    mc "Mátalos a todos, desde luego. Pero no hace falta un ejército. [l], [sa] y yo mismo somos suficientes."

# game/episodes/Ep4/episode4.rpy:7259
translate HZIlle ep4_planning_z_bc1c6400:

#   cl "[mz]?"
    cl "[mz]?"

# game/episodes/Ep4/episode4.rpy:7261
translate HZIlle ep4_planning_z_faed09af:

#   z "This is the single craziest idea I have ever heard... [r]?"
    z "Esta es la idea más loca que he oído nunca... [r]?"

# game/episodes/Ep4/episode4.rpy:7263
translate HZIlle ep4_planning_z_17d98d37:

#   r "Hector, you're the man with a plan."
    r "Héctor, tú eres el hombre con un plan."

# game/episodes/Ep4/episode4.rpy:7265
translate HZIlle ep4_planning_z_23ddb6b8:

#   r "The plan [l] cooked up is seriously the dumbest plan I've ever heard."
    r "El plan que ha preparado [l] es en serio el plan más tonto que he oído nunca."

# game/episodes/Ep4/episode4.rpy:7267
translate HZIlle ep4_planning_z_e84f465f:

#   l "Oh, come on! It's solid!"
    l "¡Oh, vamos! ¡Es sólido!"

# game/episodes/Ep4/episode4.rpy:7269
translate HZIlle ep4_planning_z_523c1c56:

#   r "HOWEVER..."
    r "SIN EMBARGO..."

# game/episodes/Ep4/episode4.rpy:7270
translate HZIlle ep4_planning_z_812a211e:

#   r "Remember us storming the city hall as a trio? Me, you and [op]? We killed a dozen people."
    r "¿Recuerdas cuando asaltamos el ayuntamiento en trío? ¿Tú, [op] y yo? Matamos a una docena de personas."

# game/episodes/Ep4/episode4.rpy:7272
translate HZIlle ep4_planning_z_ede8c13c:

#   z "Two dozen, at least!"
    z "¡Dos docenas, por lo menos!"

# game/episodes/Ep4/episode4.rpy:7274
translate HZIlle ep4_planning_z_b3c12124:

#   r "Right! It's been 20 years and people still talk about it."
    r "Ya han pasado 20 años y la gente sigue hablando de ello."

# game/episodes/Ep4/episode4.rpy:7275
translate HZIlle ep4_planning_z_c1543933:

#   r "No way they fix that level of damage. If it works, they're done for."
    r "Si funciona, están acabados."

# game/episodes/Ep4/episode4.rpy:7277
translate HZIlle ep4_planning_z_7acbb7ba:

#   z "Fuck them up as a trio."
    z "Que se jodan como trío."

# game/episodes/Ep4/episode4.rpy:7279
translate HZIlle ep4_planning_z_09f3682b:

#   l "Fuck yes!"
    l "Joder, ¡sí!"

# game/episodes/Ep4/episode4.rpy:7281
translate HZIlle ep4_planning_z_1a89056b:

#   mc "Yeaaah!"
    mc "¡Yeaaah!"

# game/episodes/Ep4/episode4.rpy:7282
translate HZIlle ep4_planning_z_436f64de:

#   z "Why would you risk your lives for me?"
    z "¿Por qué arriesgaríais vuestras vidas por mí?"

# game/episodes/Ep4/episode4.rpy:7284
translate HZIlle ep4_planning_z_a2057219:

#   l "For you? Maybe..."
    l "¿Para ti? Tal vez..."

# game/episodes/Ep4/episode4.rpy:7285
translate HZIlle ep4_planning_z_2ff3b9d6:

#   l "But mostly for eternal glory."
    l "Pero sobre todo por la gloria eterna."

# game/episodes/Ep4/episode4.rpy:7290
translate HZIlle ep4_planning_z_52b8164d:

#   r "Let's get fucking to it, then!"
    r "¡Pues vamos a ello, joder!"

# game/episodes/Ep4/episode4.rpy:7296
translate HZIlle ep4_planning_team_8f164b24:

#   mc "You look terrible."
    mc "Tienes un aspecto horrible."

# game/episodes/Ep4/episode4.rpy:7298
translate HZIlle ep4_planning_team_2c8f1016:

#   sa "Thanks."
    sa "Gracias."

# game/episodes/Ep4/episode4.rpy:7300
translate HZIlle ep4_planning_team_ba459c92:

#   l "You know what we're doing?"
    l "¿Sabes lo que estamos haciendo?"

# game/episodes/Ep4/episode4.rpy:7302
translate HZIlle ep4_planning_team_e2a69b29:

#   sa "Uh-huh. [r] clued me in."
    sa "Ajá, [r] me ha dado una pista."

# game/episodes/Ep4/episode4.rpy:7307
translate HZIlle ep4_planning_team_3710037d:

#   mc "Well?"
    mc "¿Y bien?"

# game/episodes/Ep4/episode4.rpy:7308
translate HZIlle ep4_planning_team_48d2ae9d:

#   l "Let's get planning... team!"
    l "A planificar... ¡equipo!"

# game/episodes/Ep4/episode4.rpy:7341
translate HZIlle ep4_heist_loc1_650f36bc:

#   mct "Sandswept Ridge Road, the starting point of our operation."
    mct "Sandswept Ridge Road, el punto de partida de nuestra operación."

# game/episodes/Ep4/episode4.rpy:7342
translate HZIlle ep4_heist_loc1_1f5747f7:

#   mct "Empty space. No reception."
    mct "Espacio vacío, sin recepción."

# game/episodes/Ep4/episode4.rpy:7344
translate HZIlle ep4_heist_loc1_a8d6fe11:

#   mct "And no way out."
    mct "Y sin salida."

# game/episodes/Ep4/episode4.rpy:7345
translate HZIlle ep4_heist_loc1_7efcd33a:

#   mct "Here's where we grab the armored truck."
    mct "Aquí es donde cogemos el camión blindado."

# game/episodes/Ep4/episode4.rpy:7353
translate HZIlle ep4_heist_loc2_67422919:

#   mct "Odyssey Way is where the Hack'n'Slay action goes down."
    mct "Odyssey Way es donde se desarrolla la acción Hack'n'Slay."

# game/episodes/Ep4/episode4.rpy:7354
translate HZIlle ep4_heist_loc2_9d161253:

#   mct "Expect heightened traffic conditions as Hack'n'Slay prepares to reclaim control of the hijacked armored truck."
    mct "Prepárate para un tráfico intenso mientras Hack'n'Slay se prepara para recuperar el control del camión blindado secuestrado."

# game/episodes/Ep4/episode4.rpy:7356
translate HZIlle ep4_heist_loc2_ae409ac9:

#   mct "Intelligence reports indicate the presence of 5-10 Slayers. Gotta be on our toes."
    mct "Los informes de inteligencia indican la presencia de 5-10 Cazadoras. Tenemos que estar alerta."

# game/episodes/Ep4/episode4.rpy:7358
translate HZIlle ep4_heist_loc2_400c6fbb:

#   mct "Our sniper up high, keeping an eye on everything. Think of the shooter as our eyes in the sky, guiding us through the shootout that's about to go down."
    mct "Nuestro francotirador en lo alto, vigilándolo todo. Piensa en el tirador como nuestros ojos en el cielo, guiándonos por el tiroteo que está a punto de producirse."

# game/episodes/Ep4/episode4.rpy:7360
translate HZIlle ep4_heist_loc2_110826d9:

#   mct "Odyssey Way is a critical phase in our heist preparations. We fail here, the entire operation is doomed."
    mct "El Camino de la Odisea es una fase crítica en los preparativos de nuestro atraco. Si fallamos aquí, toda la operación estará condenada al fracaso."

# game/episodes/Ep4/episode4.rpy:7368
translate HZIlle ep4_heist_loc3_01d09ca7:

#   mct "Ebon Alley, our final meetup spot – the place where all our hard work pays off."
    mct "El Callejón del Ébano, nuestro punto de encuentro final, el lugar donde todo nuestro duro trabajo da sus frutos."

# game/episodes/Ep4/episode4.rpy:7369
translate HZIlle ep4_heist_loc3_8eac8871:

#   mct "This is where we split the loot."
    mct "Aquí es donde nos repartimos el botín."

# game/episodes/Ep4/episode4.rpy:7371
translate HZIlle ep4_heist_loc3_de4c472b:

#   mct "After the split, we're off to the Glass for some well-deserved security. No drama expected, just a chill exit."
    mct "Después de la separación, nos vamos al Cristal para una merecida seguridad. No se espera ningún drama, sólo una salida tranquila."

# game/episodes/Ep4/episode4.rpy:7372
translate HZIlle ep4_heist_loc3_1fc51ce9:

#   mct "*Unofficial* Expected one more event with Nina's involvement. [sa] doesn't need to know."
    mct "* Extraoficial * Esperaba un acontecimiento más con la participación de Nina. [sa] No necesita saberlo."

# game/episodes/Ep4/episode4.rpy:7382
translate HZIlle ep4_heist_int1_bd7b3ac7:

#   pol1 "What's so urgent that you suddenly want to see me?!"
    pol1 "¿Qué es tan urgente para que de repente quieras verme?"

# game/episodes/Ep4/episode4.rpy:7386
translate HZIlle ep4_heist_int1_9eabbed0:

#   mc "What do you mean?! I always want to see you!"
    mc "¡¿Qué quieres decir?! ¡Siempre quiero verte!"

# game/episodes/Ep4/episode4.rpy:7387
translate HZIlle ep4_heist_int1_da8ce11e:

#   pol1 "Get to the point!"
    pol1 "¡Ve al grano!"

# game/episodes/Ep4/episode4.rpy:7392
translate HZIlle ep4_heist_int1_6439f3ab:

#   mc "We're in the loop about the Morph transport. We've got all the details, down to the minute and spot."
