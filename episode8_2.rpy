translate HZIlle ep8_2_lfz_gg_a87062ae:

#   mct "It’s all ending anyway. I’ll probably never see [gg] again… but maybe? Who knows?"
    mct "De todas formas, todo se acaba. Probablemente no vuelva a ver a [gg] ... pero tal vez... ¿quién sabe?"

# game/episodes/Ep8_2/episode8_2.rpy:4000
translate HZIlle ep8_2_lfz_gg_8e15e4fc:

#   mct "If I survive the critical failure long enough, it might actually matter."
    mct "Si sobrevivo al fallo crítico el tiempo suficiente, puede que realmente importe."

# game/episodes/Ep8_2/episode8_2.rpy:4006
translate HZIlle ep8_2_lfz_gg_f882335d:

#   mc "Yeah, fuck it. Why not? I always have a blast with you, [gg]."
    mc "Sí, a la mierda. ¿Por qué no? Siempre me lo paso bomba contigo, [gg]."

# game/episodes/Ep8_2/episode8_2.rpy:4007
translate HZIlle ep8_2_lfz_gg_0281bba5:

#   mc "Even if you didn’t throw money at me, I’d still show up."
    mc "Aunque no me echaras dinero, seguiría apareciendo."

# game/episodes/Ep8_2/episode8_2.rpy:4009
translate HZIlle ep8_2_lfz_gg_995c2852:

#   gg "Holy hell, remind me never to send you into negotiations with women. You fold too easy."
    gg "Santo cielo, recuérdame que nunca te envíe a negociar con mujeres. Te pliegas demasiado fácil."

# game/episodes/Ep8_2/episode8_2.rpy:4011
translate HZIlle ep8_2_lfz_gg_3c7d1da7:

#   mc "Just calling it how it is."
    mc "Sólo lo digo como es."

# game/episodes/Ep8_2/episode8_2.rpy:4013
translate HZIlle ep8_2_lfz_gg_3060c875:

#   gg "Then stop calling it."
    gg "Entonces deja de llamarlo."

# game/episodes/Ep8_2/episode8_2.rpy:4017
translate HZIlle ep8_2_lfz_gg_e43a7476:

#   mc "I’m getting out of this whole mess tonight."
    mc "Esta noche saldré de todo este lío."

# game/episodes/Ep8_2/episode8_2.rpy:4019
translate HZIlle ep8_2_lfz_gg_4f72ece1:

#   gg "Really? For good? That’s a shame. I kinda liked having you around."
    gg "¿De verdad? ¿Para siempre? Es una pena, me gustaba tenerte cerca."

# game/episodes/Ep8_2/episode8_2.rpy:4020
translate HZIlle ep8_2_lfz_gg_7de8b26a:

#   mc "Yeah… same. But I can’t stay in one place too long."
    mc "Sí... lo mismo. Pero no puedo quedarme mucho tiempo en un sitio."

# game/episodes/Ep8_2/episode8_2.rpy:4022
translate HZIlle ep8_2_lfz_gg_ae17fc0b:

#   gg "Figures. Way too many self-destructive habits for you to ever settle anywhere."
    gg "Demasiados hábitos autodestructivos para que te establezcas en algún sitio."

# game/episodes/Ep8_2/episode8_2.rpy:4025
translate HZIlle ep8_2_lfz_gg_c00b9602:

#   mc "Seriously now… do you have any idea where [z] might be? I need to find him tonight."
    mc "Ahora en serio... ¿tienes idea de dónde puede estar [z] ? Necesito encontrarlo esta noche."

# game/episodes/Ep8_2/episode8_2.rpy:4026
translate HZIlle ep8_2_lfz_gg_48fe559a:

#   gg "Maybe I do, maybe I don’t. Why are you hunting him?"
    gg "Puede que sí, puede que no. ¿Por qué le das caza?"

# game/episodes/Ep8_2/episode8_2.rpy:4028
translate HZIlle ep8_2_lfz_gg_271be6e5:

#   mc "He has something I need."
    mc "Tiene algo que necesito."

# game/episodes/Ep8_2/episode8_2.rpy:4029
translate HZIlle ep8_2_lfz_gg_0d6eacaf:

#   gg "Keys to his vault?"
    gg "¿Llaves de su cámara acorazada?"

# game/episodes/Ep8_2/episode8_2.rpy:4031
translate HZIlle ep8_2_lfz_gg_d9067ec2:

#   mc "…In a way. Does he even have a vault?"
    mc "...En cierto modo. ¿Tiene siquiera una cámara acorazada?"

# game/episodes/Ep8_2/episode8_2.rpy:4033
translate HZIlle ep8_2_lfz_gg_f0f97ac8:

#   gg "No clue, man. I’m just throwing shit out there to see what sticks."
    gg "Ni idea, tío. Sólo estoy tirando mierda por ahí a ver qué se pega."

# game/episodes/Ep8_2/episode8_2.rpy:4035
translate HZIlle ep8_2_lfz_gg_d5350812:

#   mc "If there was a vault, I’m not after his money or whatever he’s hiding. I only need one thing. The rest could be yours."
    mc "Si había una cámara acorazada, no voy detrás de su dinero ni de lo que esconda. Sólo necesito una cosa, el resto podría ser tuyo."

# game/episodes/Ep8_2/episode8_2.rpy:4036
translate HZIlle ep8_2_lfz_gg_0744fed0:

#   mc "If you help me find it."
    mc "Si me ayudas a encontrarlo."

# game/episodes/Ep8_2/episode8_2.rpy:4038
translate HZIlle ep8_2_lfz_gg_02ff80a1:

#   gg "I’m not interested either. I could’ve used his lab, but he’s not running that anymore. That [law] freak is. So there goes my brilliant plan."
    gg "A mí tampoco me interesa. Podría haber utilizado su laboratorio, pero ya no lo dirige ese engendro de [law] . Así que ahí va mi brillante plan."

# game/episodes/Ep8_2/episode8_2.rpy:4039
translate HZIlle ep8_2_lfz_gg_c09f6f7a:

#   mc "Is this your way of saying I’ve got nothing to offer you?"
    mc "¿Es tu forma de decir que no tengo nada que ofrecerte?"

# game/episodes/Ep8_2/episode8_2.rpy:4041
translate HZIlle ep8_2_lfz_gg_d3397202:

#   gg "Sadly, yeah."
    gg "Lamentablemente, sí."

# game/episodes/Ep8_2/episode8_2.rpy:4043
translate HZIlle ep8_2_lfz_gg_62bc46a8:

#   mc "What if I… take care of [law]?"
    mc "¿Y si... me ocupo de [law]?"

# game/episodes/Ep8_2/episode8_2.rpy:4045
translate HZIlle ep8_2_lfz_gg_ded4d5d3:

#   gg "Hell no! Killing a federal agent gets the government crawling all over my business. They’d shut me down in a day. So, no killing. Got it?"
    gg "¡Diablos, no! Matar a un agente federal hace que el gobierno se arrastre a mi negocio. Me cerrarían en un día. Así que nada de matar, ¿entendido?"

# game/episodes/Ep8_2/episode8_2.rpy:4046
translate HZIlle ep8_2_lfz_gg_67d9d8b8:

#   mc "Crystal clear."
    mc "Cristalina."

# game/episodes/Ep8_2/episode8_2.rpy:4049
translate HZIlle ep8_2_lfz_gg_d76e32c1:

#   gg "Relax. Your cock is enough of an offer. I got used to it… and I wouldn’t mind more of it."
    gg "Relájate. Tu polla es suficiente oferta. Me acostumbré a ella... y no me importaría tener más."

# game/episodes/Ep8_2/episode8_2.rpy:4051
translate HZIlle ep8_2_lfz_gg_50ed86d5:

#   gg "Sorry, babe. You’ve got nothing interesting on the table."
    gg "Lo siento, nena, no tienes nada interesante sobre la mesa."

# game/episodes/Ep8_2/episode8_2.rpy:4054
translate HZIlle ep8_2_lfz_gg_1b6e76dc:

#   gg "But even so… I like you. If [z] pops up, calls someone, sneezes too loud, whatever... I’ll let you know first."
    gg "Pero aun así... me caes bien. Si [z] aparece, llama a alguien, estornuda demasiado fuerte, lo que sea... te lo haré saber antes."

# game/episodes/Ep8_2/episode8_2.rpy:4056
translate HZIlle ep8_2_lfz_gg_55310c42:

#   mc "Seriously?"
    mc "¿En serio?"

# game/episodes/Ep8_2/episode8_2.rpy:4058
translate HZIlle ep8_2_lfz_gg_6ce2db48:

#   gg "On one condition."
    gg "Con una condición."

# game/episodes/Ep8_2/episode8_2.rpy:4059
translate HZIlle ep8_2_lfz_gg_a49ed4f8:

#   mc "Okay."
    mc "De acuerdo."

# game/episodes/Ep8_2/episode8_2.rpy:4061
translate HZIlle ep8_2_lfz_gg_b43dffeb:

#   gg "Who the fuck are you?"
    gg "¿Quién coño eres tú?"

# game/episodes/Ep8_2/episode8_2.rpy:4063
translate HZIlle ep8_2_lfz_gg_5d9f22ac:

#   mc "I…"
    mc "I..."

# game/episodes/Ep8_2/episode8_2.rpy:4066
translate HZIlle ep8_2_lfz_gg_c1e9cbf2:

#   gg "Don’t tell me you’re just some random guy. No one buys that shit anymore. You’re always in the middle of the action for a reason."
    gg "No me digas que eres un tipo cualquiera. Ya nadie se traga esa mierda. Siempre estás en medio de la acción por alguna razón."

# game/episodes/Ep8_2/episode8_2.rpy:4067
translate HZIlle ep8_2_lfz_gg_438de8dc:

#   gg "I want to know what that reason is."
    gg "Quiero saber cuál es esa razón."

# game/episodes/Ep8_2/episode8_2.rpy:4069
translate HZIlle ep8_2_lfz_gg_411f5289:

#   mc "I’m an agent. NO— not a government one."
    mc "Soy agente, NO del gobierno."

# game/episodes/Ep8_2/episode8_2.rpy:4071
translate HZIlle ep8_2_lfz_gg_dbef4b6b:

#   mc "A private military contractor. I’m supposed to take something from [z]. Something important."
    mc "Un contratista militar privado. Debo llevarme algo de [z] Algo importante."

# game/episodes/Ep8_2/episode8_2.rpy:4073
translate HZIlle ep8_2_lfz_gg_fb39c7c5:

#   gg "What kind of something?"
    gg "¿Qué clase de algo?"

# game/episodes/Ep8_2/episode8_2.rpy:4074
translate HZIlle ep8_2_lfz_gg_5cac0e79:

#   mc "Data. That’s all I know. I either steal it or… well, you can guess the alternative."
    mc "Datos. Es todo lo que sé. O lo robo o... bueno, puedes adivinar la alternativa."

# game/episodes/Ep8_2/episode8_2.rpy:4076
translate HZIlle ep8_2_lfz_gg_d4f3b166:

#   gg "Steal or die."
    gg "Roba o muere."

# game/episodes/Ep8_2/episode8_2.rpy:4077
translate HZIlle ep8_2_lfz_gg_8ca02f77:

#   gg "Why the hell didn’t you say so sooner?"
    gg "¿Por qué demonios no lo dijiste antes?"

# game/episodes/Ep8_2/episode8_2.rpy:4078
translate HZIlle ep8_2_lfz_gg_1b291a91:

#   mc "Would you have helped me? I just… I didn’t want to drag you into it."
    mc "¿Me habrías ayudado? Es que... no quería arrastrarte a ello."

# game/episodes/Ep8_2/episode8_2.rpy:4080
translate HZIlle ep8_2_lfz_gg_997008f6:

#   gg "Are you planning to kill him?"
    gg "¿Planeas matarle?"

# game/episodes/Ep8_2/episode8_2.rpy:4082
translate HZIlle ep8_2_lfz_gg_c5bde8c5:

#   mc "I don’t know yet. Depends on how big of a problem he becomes."
    mc "Aún no lo sé. Depende de lo problemático que llegue a ser."

# game/episodes/Ep8_2/episode8_2.rpy:4085
translate HZIlle ep8_2_lfz_gg_9dc387ca:

#   gg "Do it. My business would love that."
    gg "Hazlo, a mi empresa le encantaría."

# game/episodes/Ep8_2/episode8_2.rpy:4086
translate HZIlle ep8_2_lfz_gg_f3052a3e:

#   mc "So I can count on you because you… like me?"
    mc "¿Así que puedo contar contigo porque... te gusto?"

# game/episodes/Ep8_2/episode8_2.rpy:4088
translate HZIlle ep8_2_lfz_gg_9d89a835:

#   gg "Oh, babe. The things we do for love."
    gg "Las cosas que hacemos por amor."

# game/episodes/Ep8_2/episode8_2.rpy:4089
translate HZIlle ep8_2_lfz_gg_a457b571:

#   gg "Anyway, my contact’s here. Gotta run."
    gg "De todas formas, mi contacto está aquí. Tengo que irme."

# game/episodes/Ep8_2/episode8_2.rpy:4091
translate HZIlle ep8_2_lfz_gg_56514394:

#   mct "Shit. I didn’t install the tracker. But… I trust [gg]. I really do. She’ll deliver."
    mct "Mierda. No instalé el rastreador. Pero... confío en [gg]. De verdad. Cumplirá."

# game/episodes/Ep8_2/episode8_2.rpy:4095
translate HZIlle ep8_2_lfz_gg_a731cd71:

#   gg "Hey, [mc]?"
    gg "¿Eh, [mc]?"

# game/episodes/Ep8_2/episode8_2.rpy:4096
translate HZIlle ep8_2_lfz_gg_f49fff8f:

#   mc "Yeah?"
    mc "¿Sí?"

# game/episodes/Ep8_2/episode8_2.rpy:4098
translate HZIlle ep8_2_lfz_gg_792bdce6:

#   gg "I’ll see you around."
    gg "Nos vemos."

# game/episodes/Ep8_2/episode8_2.rpy:4099
translate HZIlle ep8_2_lfz_gg_3ecea73b:

#   gg "... in another world."
    gg "... en otro mundo."

# game/episodes/Ep8_2/episode8_2.rpy:4101
translate HZIlle ep8_2_lfz_gg_61a5ee76:

#   mc "Huh?! [gg]?!"
    mc "¿Eh? [gg]¡?!"

# game/episodes/Ep8_2/episode8_2.rpy:4102
translate HZIlle ep8_2_lfz_gg_6b7ac38d:

#   gg "Find me."
    gg "Encuéntrame."

# game/episodes/Ep8_2/episode8_2.rpy:4104
translate HZIlle ep8_2_lfz_gg_ad6da3a9:

#   mct "The virus is screwing with the simulation again!"
    mct "¡El virus vuelve a fastidiar la simulación!"

# game/episodes/Ep8_2/episode8_2.rpy:4105
translate HZIlle ep8_2_lfz_gg_ec269cde:

#   mct "Did I just talk to [gg]? Dream her up? Or was that the real—outside-the-simulation—[gg]?"
    mct "¿Acabo de hablar con [gg]? ¿La he soñado? ¿O ha sido la verdadera [gg] fuera-de-la-simulación</b0>?"

# game/episodes/Ep8_2/episode8_2.rpy:4114
translate HZIlle ep8_2_lfz_cl_0615fd0b:

#   cl "Holy shit, you made it!"
    cl "Joder, ¡lo has conseguido!"

# game/episodes/Ep8_2/episode8_2.rpy:4116
translate HZIlle ep8_2_lfz_cl_685dd4fa:

#   mc "Barely. Things have been… insane lately."
    mc "Apenas. Las cosas han sido... una locura últimamente."

# game/episodes/Ep8_2/episode8_2.rpy:4117
translate HZIlle ep8_2_lfz_cl_ed6de220:

#   mc "[z]’s mansion burning down, [k] getting kidnapped, another goddamn shootout..."
    mc "La mansión de [z] quemándose, [k] secuestrada, otro maldito tiroteo..."

# game/episodes/Ep8_2/episode8_2.rpy:4119
translate HZIlle ep8_2_lfz_cl_6a48f54c:

#   cl "You’ve been busy."
    cl "Has estado ocupada."

# game/episodes/Ep8_2/episode8_2.rpy:4120
translate HZIlle ep8_2_lfz_cl_623c0307:

#   mc "Yeah. What about you? How are you holding up?"
    mc "Sí. ¿Y tú? ¿Cómo lo llevas?"

# game/episodes/Ep8_2/episode8_2.rpy:4122
translate HZIlle ep8_2_lfz_cl_688847b0:

#   cl "Physically? Fine. Mentally? I honestly have no idea."
    cl "¿Físicamente? Bien. ¿Mentalmente? Sinceramente, no tengo ni idea."

# game/episodes/Ep8_2/episode8_2.rpy:4123
translate HZIlle ep8_2_lfz_cl_1f308465:

#   cl "Part of me keeps thinking [z] is gone. Like… gone-gone."
    cl "Una parte de mí sigue pensando que [z] se ha ido... se ha ido... se ha ido."

# game/episodes/Ep8_2/episode8_2.rpy:4124
translate HZIlle ep8_2_lfz_cl_290b6d6d:

#   cl "Have a seat."
    cl "Toma asiento."

# game/episodes/Ep8_2/episode8_2.rpy:4126
translate HZIlle ep8_2_lfz_cl_4579aab8:

#   mc "He’s not home, but he’s definitely alive. For now."
    mc "No está en casa, pero definitivamente está vivo, por ahora."

# game/episodes/Ep8_2/episode8_2.rpy:4128
translate HZIlle ep8_2_lfz_cl_c2969e37:

#   cl "You think he’s still coming after me?"
    cl "¿Crees que todavía viene a por mí?"

# game/episodes/Ep8_2/episode8_2.rpy:4130
translate HZIlle ep8_2_lfz_cl_1e6f543e:

#   mc "He’s got bigger shit to deal with... like staying alive himself. He’s hiding somewhere and I’m trying to figure out where."
    mc "Tiene cosas más importantes de las que ocuparse... como mantenerse vivo él mismo. Se esconde en alguna parte y estoy intentando averiguar dónde."

# game/episodes/Ep8_2/episode8_2.rpy:4131
translate HZIlle ep8_2_lfz_cl_1e19edba:

#   mc "I just need to finish this job once and for all."
    mc "Necesito terminar este trabajo de una vez por todas."

# game/episodes/Ep8_2/episode8_2.rpy:4133
translate HZIlle ep8_2_lfz_cl_c974db2d:

#   cl "And you think he’d contact me? Or that I reached out to him?"
    cl "¿Y crees que se pondría en contacto conmigo? ¿O que yo me pondría en contacto con él?"

# game/episodes/Ep8_2/episode8_2.rpy:4134
translate HZIlle ep8_2_lfz_cl_1d32914d:

#   cl "Seriously?"
    cl "¿En serio?"

# game/episodes/Ep8_2/episode8_2.rpy:4136
translate HZIlle ep8_2_lfz_cl_a3648507:

#   mc "Look, I’m scraping the bottom here. I have no idea where he is and I NEED to find him before midnight."
    mc "No tengo ni idea de dónde está y NECESITO encontrarlo antes de medianoche."

# game/episodes/Ep8_2/episode8_2.rpy:4137
translate HZIlle ep8_2_lfz_cl_13fb7e7e:

#   cl "That’s… oddly specific."
    cl "Eso es... extrañamente específico."

# game/episodes/Ep8_2/episode8_2.rpy:4139
translate HZIlle ep8_2_lfz_cl_ee91e32a:

#   mc "[z] may be off the grid, but Lawson is still running the show. If anyone wants a life that isn’t fucked, both of them need to be out of the picture."
    mc "[z] Puede que esté fuera de la red, pero Lawson sigue dirigiendo el cotarro. Si alguien quiere una vida que no esté jodida, ambos tienen que estar fuera de juego."

# game/episodes/Ep8_2/episode8_2.rpy:4141
translate HZIlle ep8_2_lfz_cl_3db4c5d0:

#   cl "Look, I’m sorry… but he’d never call me. I’m basically his number one enemy right now."
    cl "Mira, lo siento... pero nunca me llamaría. Soy básicamente su enemigo número uno ahora mismo."

# game/episodes/Ep8_2/episode8_2.rpy:4142
translate HZIlle ep8_2_lfz_cl_8acd69b7:

#   cl "Even if I tried provoking him, it wouldn’t work."
    cl "Aunque intentara provocarle, no funcionaría."

# game/episodes/Ep8_2/episode8_2.rpy:4144
translate HZIlle ep8_2_lfz_cl_69d672ba:

#   cl "Like you said...he’s busy trying not to get killed."
    cl "Como has dicho... está ocupado intentando que no le maten."

# game/episodes/Ep8_2/episode8_2.rpy:4145
translate HZIlle ep8_2_lfz_cl_eded679a:

#   cl "Shit. Give me a sec. I need to pee again."
    cl "Mierda, dame un segundo, tengo que volver a mear."

# game/episodes/Ep8_2/episode8_2.rpy:4147
translate HZIlle ep8_2_lfz_cl_6157ac85:

#   cl "Ever since I got shot I’ve had to go constantly. Maybe your laser healing wasn’t that top-tier after all."
    cl "Desde que me dispararon tengo que ir constantemente. Quizá tu curación por láser no era tan de primera después de todo."

# game/episodes/Ep8_2/episode8_2.rpy:4149
translate HZIlle ep8_2_lfz_cl_45db5058:

#   mc "Better to pee than to hurt."
    mc "Mejor mear que hacer daño."

# game/episodes/Ep8_2/episode8_2.rpy:4151
translate HZIlle ep8_2_lfz_cl_dee5f33a:

#   cl "Fair enough. That’s my new motto."
    cl "Me parece justo, es mi nuevo lema."

# game/episodes/Ep8_2/episode8_2.rpy:4155
translate HZIlle ep8_2_lfz_cl_8bff56ba:

#   mct "Tracker installed."
    mct "Rastreador instalado."

# game/episodes/Ep8_2/episode8_2.rpy:4156
translate HZIlle ep8_2_lfz_cl_059eadd6:

#   mct "[cl] is probably a dead end… but at this point, anything helps."
    mct "[cl] es probablemente un callejón sin salida... pero llegados a este punto, cualquier cosa ayuda."

# game/episodes/Ep8_2/episode8_2.rpy:4158
translate HZIlle ep8_2_lfz_cl_e7915115:

#   cl "I'm back!"
    cl "¡Ya estoy de vuelta!"

# game/episodes/Ep8_2/episode8_2.rpy:4163
translate HZIlle ep8_2_lfz_cl_759da1f3:

#   mc "Umm… how’s your [gb] situation?"
    mc "Umm... ¿cómo está tu situación [gb]?"

# game/episodes/Ep8_2/episode8_2.rpy:4165
translate HZIlle ep8_2_lfz_cl_250d5a5b:

#   cl "Fuck… I got rid of my sister."
    cl "Joder... me he librado de mi hermana."

# game/episodes/Ep8_2/episode8_2.rpy:4166
translate HZIlle ep8_2_lfz_cl_1b394b62:

#   cl "I… actually killed her."
    cl "Yo... realmente la maté."

# game/episodes/Ep8_2/episode8_2.rpy:4168
translate HZIlle ep8_2_lfz_cl_828ae62c:

#   cl "She earned it though, didn’t she? That’s the price of playing both sides, stabbing everyone in the back, even your own blood."
    cl "Pero se lo ha ganado, ¿no? Ése es el precio de jugar a dos bandas, apuñalar a todo el mundo por la espalda, incluso a tu propia sangre."

# game/episodes/Ep8_2/episode8_2.rpy:4169
translate HZIlle ep8_2_lfz_cl_c37d74d7:

#   cl "That kind of life ends one way. She must’ve known."
    cl "Ese tipo de vida acaba de una manera, ella debía saberlo."

# game/episodes/Ep8_2/episode8_2.rpy:4171
translate HZIlle ep8_2_lfz_cl_1895eb16:

#   mc "You’re still processing all of it. Anyone would."
    mc "Aún estás procesándolo todo. Cualquiera lo haría."

# game/episodes/Ep8_2/episode8_2.rpy:4173
translate HZIlle ep8_2_lfz_cl_cb51bb3e:

#   cl "It’s weird… you spend years chasing one thing... hating someone, needing them gone, making that your whole purpose."
    cl "Es extraño... pasas años persiguiendo una cosa... odiando a alguien, necesitando que se vaya, haciendo de eso todo tu propósito."

# game/episodes/Ep8_2/episode8_2.rpy:4174
translate HZIlle ep8_2_lfz_cl_57bc55c9:

#   cl "You want it with every breath."
    cl "Lo deseas con cada respiración."

# game/episodes/Ep8_2/episode8_2.rpy:4176
translate HZIlle ep8_2_lfz_cl_82388a7d:

#   cl "And when it finally happens? Everything inside just… collapses. There’s no victory. Just emptiness."
    cl "¿Y cuando por fin ocurre? Todo en el interior simplemente... se derrumba. No hay victoria, sólo vacío."

# game/episodes/Ep8_2/episode8_2.rpy:4177
translate HZIlle ep8_2_lfz_cl_59fe3b2a:

#   cl "So what now? [z] is out of my life. My sister is dead. What the hell is left?"
    cl "¿Y ahora qué? [z] Está fuera de mi vida. Mi hermana está muerta. ¿Qué demonios queda?"

# game/episodes/Ep8_2/episode8_2.rpy:4179
translate HZIlle ep8_2_lfz_cl_7de80cbb:

#   mc "You wait until you’re healed. Safe."
    mc "Espera hasta que estés curado. A salvo."

# game/episodes/Ep8_2/episode8_2.rpy:4180
translate HZIlle ep8_2_lfz_cl_90ba5982:

#   mc "Then, and I know it sounds insane, you start over. No mob boss hanging over you, no psycho sister. Just you, and a life that could actually move somewhere good."
    mc "Entonces, y sé que parece una locura, empiezas de nuevo. Sin jefe de la mafia pendiente de ti, ni hermana psicópata. Sólo tú, y una vida que podría ir a algún sitio bueno."

# game/episodes/Ep8_2/episode8_2.rpy:4182
translate HZIlle ep8_2_lfz_cl_d59ecb42:

#   mc "Preferably far away from this city."
    mc "Preferiblemente lejos de esta ciudad."

# game/episodes/Ep8_2/episode8_2.rpy:4183
translate HZIlle ep8_2_lfz_cl_2d2228eb:

#   mc "Yeah, you’ll feel empty for a while… but filling that space is up to you."
    mc "Sí, te sentirás vacía durante un tiempo... pero llenar ese espacio depende de ti."

# game/episodes/Ep8_2/episode8_2.rpy:4185
translate HZIlle ep8_2_lfz_cl_2d89df21:

#   cl "Thank you, [mc]… I wouldn’t have made it through any of this without you."
    cl "Gracias, [mc]... No habría superado nada de esto sin ti."

# game/episodes/Ep8_2/episode8_2.rpy:4186
translate HZIlle ep8_2_lfz_cl_941bddfc:

#   cl "I appreciate everything you did for me. I wish I could repay you somehow."
    cl "Te agradezco todo lo que hiciste por mí. Ojalá pudiera pagártelo de alguna manera."

# game/episodes/Ep8_2/episode8_2.rpy:4188
translate HZIlle ep8_2_lfz_cl_48569549:

#   mc "You can."
    mc "Puedes hacerlo."

# game/episodes/Ep8_2/episode8_2.rpy:4189
translate HZIlle ep8_2_lfz_cl_64b4e296:

#   mc "I know you can’t help with [z], but you can still settle that debt."
    mc "Sé que no puedes ayudar con [z], pero aún puedes saldar esa deuda."

# game/episodes/Ep8_2/episode8_2.rpy:4190
translate HZIlle ep8_2_lfz_cl_5f7e62ea:

#   mc "Just live your life. As happily as you can. Do that, and we’re even."
    mc "Vive tu vida. Tan feliz como puedas. Haz eso, y estamos en paz."

# game/episodes/Ep8_2/episode8_2.rpy:4192
translate HZIlle ep8_2_lfz_cl_e39c3a54:

#   cl "Why does that sound like a goodbye? You’re hiding something."
    cl "¿Por qué suena a despedida? Estás ocultando algo."

# game/episodes/Ep8_2/episode8_2.rpy:4193
translate HZIlle ep8_2_lfz_cl_d6fe8cac:

#   mc "It’s… fuck. It might be the last time we see each other."
    mc "Es... joder. Puede que sea la última vez que nos veamos."

# game/episodes/Ep8_2/episode8_2.rpy:4195
translate HZIlle ep8_2_lfz_cl_b3c1425c:

#   cl "You’re leaving…?"
    cl "¿Te vas...?"

# game/episodes/Ep8_2/episode8_2.rpy:4196
translate HZIlle ep8_2_lfz_cl_2fec2b43:

#   mc "In a way, yeah."
    mc "En cierto modo, sí."

# game/episodes/Ep8_2/episode8_2.rpy:4198
translate HZIlle ep8_2_lfz_cl_6f294674:

#   cl "After you deal with [z]… that’s been the plan the whole time?"
    cl "Después de ocuparte de [z]... ¿ese ha sido el plan todo el tiempo?"

# game/episodes/Ep8_2/episode8_2.rpy:4199
translate HZIlle ep8_2_lfz_cl_f800bed0:

#   mc "Yes."
    mc "Sí."

# game/episodes/Ep8_2/episode8_2.rpy:4201
translate HZIlle ep8_2_lfz_cl_35c31d8d:

#   cl "I wish you could be there when I start over. When I finally have something clean."
    cl "Ojalá pudieras estar ahí cuando vuelva a empezar, cuando por fin tenga algo limpio."

# game/episodes/Ep8_2/episode8_2.rpy:4203
translate HZIlle ep8_2_lfz_cl_ca358428:

#   cl "But… I get it. I do."
    cl "Pero... lo entiendo, de verdad."

# game/episodes/Ep8_2/episode8_2.rpy:4205
translate HZIlle ep8_2_lfz_cl_675bec12:

#   cl "Good luck, [mc]. Wherever the hell you end up… I hope it’s someplace better."
    cl "Buena suerte, [mc]. Dondequiera que acabes... espero que sea en un lugar mejor."

# game/episodes/Ep8_2/episode8_2.rpy:4213
translate HZIlle ep8_2_lfz_cl_cd695d18:

#   gb "Sis! You’re talking to yourself again!"
    gb "¡Hermana! ¡Estás hablando sola otra vez!"

# game/episodes/Ep8_2/episode8_2.rpy:4214
translate HZIlle ep8_2_lfz_cl_463c401b:

#   gb "Oh? [mc]! Well, look who showed up! Took you long enough, you bastard!"
    gb "¿Oh? [mc] ¡Bueno, mira quién ha aparecido! ¡Ya has tardado bastante, cabrón!"

# game/episodes/Ep8_2/episode8_2.rpy:4216
translate HZIlle ep8_2_lfz_cl_fc43f862:

#   mc "It’s been a hell of a day."
    mc "Ha sido un día infernal."

# game/episodes/Ep8_2/episode8_2.rpy:4217
translate HZIlle ep8_2_lfz_cl_cfbbfa08:

#   mc "But I missed my favorite chaotic duo."
    mc "Pero echaba de menos a mi dúo caótico favorito."

# game/episodes/Ep8_2/episode8_2.rpy:4219
translate HZIlle ep8_2_lfz_cl_be834258:

#   gb "Damn right we’re the favorites!"
    gb "Maldita sea, ¡somos los favoritos!"

# game/episodes/Ep8_2/episode8_2.rpy:4220
translate HZIlle ep8_2_lfz_cl_44b6be21:

#   cl "…Speak for yourself."
    cl "...Habla por ti."

# game/episodes/Ep8_2/episode8_2.rpy:4222
translate HZIlle ep8_2_lfz_cl_03f2c61c:

#   gb "Ahem. Anyway, what brings you?"
    gb "En fin, ¿qué te trae por aquí?"

# game/episodes/Ep8_2/episode8_2.rpy:4223
translate HZIlle ep8_2_lfz_cl_37ea7333:

#   mc "[z]. Did the old man try contacting you after the masquerade?"
    mc "[z]. ¿Intentó el viejo ponerse en contacto contigo después de la mascarada?"

# game/episodes/Ep8_2/episode8_2.rpy:4225
translate HZIlle ep8_2_lfz_cl_764fb391:

#   gb "Hell no."
    gb "Por supuesto que no."

# game/episodes/Ep8_2/episode8_2.rpy:4226
translate HZIlle ep8_2_lfz_cl_0ca1e12d:

#   gb "I was a hair away from getting strangled... and not in the fun way. You think I’m dying to get involved with him again?"
    gb "Estuve a un pelo de que me estrangularan... y no de la forma divertida. ¿Crees que me muero por volver a liarme con él?"

# game/episodes/Ep8_2/episode8_2.rpy:4228
translate HZIlle ep8_2_lfz_cl_d676b363:

#   mc "Somehow I doubt that would stop you."
    mc "Dudo que eso te detenga."

# game/episodes/Ep8_2/episode8_2.rpy:4229
translate HZIlle ep8_2_lfz_cl_ad7f9a2b:

#   gb "Well, depends on the benefits. Anyway! No, he hasn’t contacted me."
    gb "Bueno, depende de los beneficios. ¡De todos modos! No, no se ha puesto en contacto conmigo."

# game/episodes/Ep8_2/episode8_2.rpy:4231
translate HZIlle ep8_2_lfz_cl_d70af008:

#   gb "But my adorable sister and I will let you know if he does. Sounds fair?"
    gb "Pero mi adorable hermana y yo te avisaremos si lo hace. ¿Te parece justo?"

# game/episodes/Ep8_2/episode8_2.rpy:4232
translate HZIlle ep8_2_lfz_cl_4ca7a96d:

#   mc "Suspiciously fair. What’s the catch?"
    mc "Sospechosamente justo. ¿Cuál es el truco?"

# game/episodes/Ep8_2/episode8_2.rpy:4234
translate HZIlle ep8_2_lfz_cl_43452eb1:

#   gb "I’m offended."
    gb "Me siento ofendido."

# game/episodes/Ep8_2/episode8_2.rpy:4235
translate HZIlle ep8_2_lfz_cl_62043866:

#   gb "…"
    gb "..."

# game/episodes/Ep8_2/episode8_2.rpy:4237
translate HZIlle ep8_2_lfz_cl_d1e43e7c:

#   mc "Tell me what you want."
    mc "Dime lo que quieres."

# game/episodes/Ep8_2/episode8_2.rpy:4239
translate HZIlle ep8_2_lfz_cl_2d5ecdb1:

#   gb "Share [mc] with me?"
    gb "¿Compartir [mc] conmigo?"

# game/episodes/Ep8_2/episode8_2.rpy:4241
translate HZIlle ep8_2_lfz_cl_a3b76049:

#   cl "WHAT?! Absolutely fucking NOT!"
    cl "¿¡QUÉ!? ¡De ninguna manera!"

# game/episodes/Ep8_2/episode8_2.rpy:4242
translate HZIlle ep8_2_lfz_cl_3fe9d98e:

#   cl "WE’RE SISTERS!"
    cl "¡SOMOS HERMANAS!"

# game/episodes/Ep8_2/episode8_2.rpy:4244
translate HZIlle ep8_2_lfz_cl_40168e82:

#   cl "SIS-TERS, YOU FREAK!"
    cl "SIS-TERS, ¡LOCO!"

# game/episodes/Ep8_2/episode8_2.rpy:4246
translate HZIlle ep8_2_lfz_cl_807f9272:

#   gb "The laws should be more flexible! Really! What exactly stops two sisters from having a little fun together?!"
    gb "Las leyes deberían ser más flexibles! ¡En serio! ¿Qué impide exactamente que dos hermanas se diviertan un poco juntas?"

# game/episodes/Ep8_2/episode8_2.rpy:4247
translate HZIlle ep8_2_lfz_cl_9e976fbc:

#   gb "Brothers and sisters? Sure, bad genetics. Horror movie material."
    gb "¿Hermanos y hermanas? Claro, mala genética, material de película de terror."

# game/episodes/Ep8_2/episode8_2.rpy:4249
translate HZIlle ep8_2_lfz_cl_667fe29b:

#   gb "But two sisters? What’s the worst that happens? Nothing!"
    gb "¿Pero dos hermanas? ¿Qué es lo peor que puede pasar? ¡Nada!"

# game/episodes/Ep8_2/episode8_2.rpy:4250
translate HZIlle ep8_2_lfz_cl_be9b75a5:

#   gb "Come on, right?!"
    gb "Vamos, ¿verdad?"

# game/episodes/Ep8_2/episode8_2.rpy:4252
translate HZIlle ep8_2_lfz_cl_ece63c8d:

#   mc "…"
    mc "..."

# game/episodes/Ep8_2/episode8_2.rpy:4253
translate HZIlle ep8_2_lfz_cl_0ede6037:

#   cl "…"
    cl "..."

# game/episodes/Ep8_2/episode8_2.rpy:4255
translate HZIlle ep8_2_lfz_cl_da6d05a1:

#   gb "I can’t be the only one thinking this!"
    gb "¡No puedo ser el único que piensa esto!"

# game/episodes/Ep8_2/episode8_2.rpy:4257
translate HZIlle ep8_2_lfz_cl_9b4e1e0a:

#   mc "You absolutely are."
    mc "Desde luego que sí."

# game/episodes/Ep8_2/episode8_2.rpy:4260
translate HZIlle ep8_2_lfz_cl_5b0932ef:

#   gb "You two are boring as hell!"
    gb "¡Sois aburridísimos!"

# game/episodes/Ep8_2/episode8_2.rpy:4261
translate HZIlle ep8_2_lfz_cl_c810d74d:

#   cl "Please, for fuck’s sake, change the topic."
    cl "Por favor, joder, cambia de tema."

# game/episodes/Ep8_2/episode8_2.rpy:4263
translate HZIlle ep8_2_lfz_cl_e736444b:

#   mc "What are your plans? You know… immediate future?"
    mc "¿Cuáles son tus planes? Ya sabes... ¿futuro inmediato?"

# game/episodes/Ep8_2/episode8_2.rpy:4265
translate HZIlle ep8_2_lfz_cl_e792ef58:

#   gb "Bonding!"
    gb "¡Vinculación!"

# game/episodes/Ep8_2/episode8_2.rpy:4266
translate HZIlle ep8_2_lfz_cl_ad43329e:

#   gb "We’re doing great, aren’t we, [cl]?"
    gb "Lo estamos haciendo muy bien, ¿verdad, [cl]?"

# game/episodes/Ep8_2/episode8_2.rpy:4268
translate HZIlle ep8_2_lfz_cl_f8392e68:

#   cl "…Yeah. I think so."
    cl "...Sí, creo que sí."

# game/episodes/Ep8_2/episode8_2.rpy:4270
translate HZIlle ep8_2_lfz_cl_3978b330:

#   gb "REALLY?!"
    gb "¿DE VERDAD?"

# game/episodes/Ep8_2/episode8_2.rpy:4272
translate HZIlle ep8_2_lfz_cl_7120cabc:

#   cl "You’re just putting on this obsessed horny clown act to impress [mc] and bait him into a threesome that’s never happening."
    cl "Sólo estás montando este numerito de payaso cachondo obsesionado para impresionar a [mc] y atraerle a un trío que nunca se va a hacer."

# game/episodes/Ep8_2/episode8_2.rpy:4273
translate HZIlle ep8_2_lfz_cl_e437e957:

#   cl "But when he’s not around, you’re… nice. Actually nice."
    cl "Pero cuando no está, eres... agradable, realmente agradable."

# game/episodes/Ep8_2/episode8_2.rpy:4275
translate HZIlle ep8_2_lfz_cl_54c6d6e4:

#   gb "Our plan is simple... Wait until you take down [z], skip town, and leave this dumpster fire behind. Start fresh."
    gb "Nuestro plan es sencillo... Esperar a que acabes con [z], huir de la ciudad y dejar atrás este basurero. Empezar de cero."

# game/episodes/Ep8_2/episode8_2.rpy:4276
translate HZIlle ep8_2_lfz_cl_622ccc71:

#   gb "Like a normal, totally functional family."
    gb "Como una familia normal y totalmente funcional."

# game/episodes/Ep8_2/episode8_2.rpy:4277
translate HZIlle ep8_2_lfz_cl_41c2fb9b:

#   mc "And what if [cl] finds love… and that love isn’t you?"
    mc "¿Y si [cl] encuentra el amor... y ese amor no eres tú?"

# game/episodes/Ep8_2/episode8_2.rpy:4279
translate HZIlle ep8_2_lfz_cl_146300c8:

#   gb "I'm not worried. I’ll just slice his wrists and hang him like a bat until he drains out any thought of touching my sister."
    gb "No me preocupa. Le cortaré las muñecas y le colgaré como a un murciélago hasta que se le pase por la cabeza cualquier idea de tocar a mi hermana."

# game/episodes/Ep8_2/episode8_2.rpy:4280
translate HZIlle ep8_2_lfz_cl_5e77c0c0:

#   cl "..."
    cl "..."

# game/episodes/Ep8_2/episode8_2.rpy:4282
translate HZIlle ep8_2_lfz_cl_8a636252:

#   gb "I WAS JOKING!"
    gb "¡ESTABA BROMEANDO!"

# game/episodes/Ep8_2/episode8_2.rpy:4284
translate HZIlle ep8_2_lfz_cl_00bd386f:

#   mc "Were you?"
    mc "¿De verdad?"

# game/episodes/Ep8_2/episode8_2.rpy:4286
translate HZIlle ep8_2_lfz_cl_0054293c:

#   gb "YES!"
    gb "¡SÍ!"

# game/episodes/Ep8_2/episode8_2.rpy:4288
translate HZIlle ep8_2_lfz_cl_1b822128:

#   gb "And you’re invited to join us!"
    gb "¡Y estás invitado a unirte a nosotros!"

# game/episodes/Ep8_2/episode8_2.rpy:4291
translate HZIlle ep8_2_lfz_cl_b8663055:

#   mc "Trust me, I’d love to."
    mc "Créeme, me encantaría."

# game/episodes/Ep8_2/episode8_2.rpy:4292
translate HZIlle ep8_2_lfz_cl_b511a31f:

#   cl "But?"
    cl "¿Pero?"

# game/episodes/Ep8_2/episode8_2.rpy:4294
translate HZIlle ep8_2_lfz_cl_e69756fa:

#   mc "I don’t think I can."
    mc "No creo que pueda."

# game/episodes/Ep8_2/episode8_2.rpy:4296
translate HZIlle ep8_2_lfz_cl_cb55c153:

#   cl "So… this is goodbye?"
    cl "Entonces... ¿esto es el adiós?"

# game/episodes/Ep8_2/episode8_2.rpy:4297
translate HZIlle ep8_2_lfz_cl_e112866e:

#   mc "Yeah. Tonight I’m going after [z]. If I manage to find him… odds are we won’t see each other again."
    mc "Sí. Esta noche iré tras [z]. Si consigo encontrarle... lo más probable es que no volvamos a vernos."

# game/episodes/Ep8_2/episode8_2.rpy:4299
translate HZIlle ep8_2_lfz_cl_2462b9d9:

#   cl "Why?"
    cl "¿Por qué?"

# game/episodes/Ep8_2/episode8_2.rpy:4300
translate HZIlle ep8_2_lfz_cl_fe883dac:

#   mc "Let’s just say the road splits after tonight."
    mc "Digamos que el camino se divide después de esta noche."

# game/episodes/Ep8_2/episode8_2.rpy:4302
translate HZIlle ep8_2_lfz_cl_ebc997ab:

#   cl "Alright… no details then."
    cl "De acuerdo... no hay detalles entonces."

# game/episodes/Ep8_2/episode8_2.rpy:4303
translate HZIlle ep8_2_lfz_cl_8ea711cc:

#   mc "Maybe one day, somewhere different... we’ll run into each other again."
    mc "Quizá algún día, en algún lugar diferente... volvamos a encontrarnos."

# game/episodes/Ep8_2/episode8_2.rpy:4305
translate HZIlle ep8_2_lfz_cl_d2a26f4d:

#   cl "Another town by accident?"
    cl "¿Otra ciudad por accidente?"

# game/episodes/Ep8_2/episode8_2.rpy:4306
translate HZIlle ep8_2_lfz_cl_18eef424:

#   mc "Another world, maybe."
    mc "Otro mundo, tal vez."

# game/episodes/Ep8_2/episode8_2.rpy:4308
translate HZIlle ep8_2_lfz_cl_e86b102e:

#   gb "Ugh, gross. I’m getting nauseous."
    gb "Qué asco, me están entrando náuseas."

# game/episodes/Ep8_2/episode8_2.rpy:4318
translate HZIlle ep8_2_lfz_cl_af3f5977:

#   mc "I still need to find [z]..."
    mc "Todavía tengo que encontrar [z]..."

# game/episodes/Ep8_2/episode8_2.rpy:4320
translate HZIlle ep8_2_lfz_cl_49a3f727:

#   cl "Sorry I couldn't be of help. I hope you succeed."
    cl "Siento no haberte podido ayudar, espero que lo consigas."

# game/episodes/Ep8_2/episode8_2.rpy:4322
translate HZIlle ep8_2_lfz_cl_abd6df80:

#   cl "Good luck, [mc]."
    cl "Buena suerte, [mc]."

# game/episodes/Ep8_2/episode8_2.rpy:4334
translate HZIlle ep8_2_clss_1049e2d5:

#   mc "I’m honestly shocked she’s not crouched behind the couch watching us."
    mc "Sinceramente, me sorprende que no esté agazapada detrás del sofá observándonos."

# game/episodes/Ep8_2/episode8_2.rpy:4335
translate HZIlle ep8_2_clss_754c53e9:

#   cl "Shhh. Keep your voice down."
    cl "Baja la voz."

# game/episodes/Ep8_2/episode8_2.rpy:4337
translate HZIlle ep8_2_clss_0426737c:

#   cl "I think she assumed you were heading out. You did look like you were about to."
    cl "Creo que supuso que te ibas, pues parecía que estabas a punto de hacerlo."

# game/episodes/Ep8_2/episode8_2.rpy:4338
translate HZIlle ep8_2_clss_3816056b:

