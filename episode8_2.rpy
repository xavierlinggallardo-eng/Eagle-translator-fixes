translate HZIlle ep8_2_clss_4a3e0b24:

#   mc "Just make sure she doesn’t turn on you."
    mc "Sólo asegúrate de que no se vuelva contra ti."

# game/episodes/Ep8_2/episode8_2.rpy:4536
translate HZIlle ep8_2_clss_bc1dac28:

#   cl "She won’t."
    cl "No lo hará."

# game/episodes/Ep8_2/episode8_2.rpy:4537
translate HZIlle ep8_2_clss_57fc5e04:

#   cl "See you soon?"
    cl "¿Nos vemos pronto?"

# game/episodes/Ep8_2/episode8_2.rpy:4539
translate HZIlle ep8_2_clss_65c4a4ef:

#   mc "Yeah. See you, [cl]."
    mc "Sí. Nos vemos, [cl]."

# game/episodes/Ep8_2/episode8_2.rpy:4483
translate HZIlle ep8_2_clss_62043866_1:

#   gb "…"
    gb "..."

# game/episodes/Ep8_2/episode8_2.rpy:4551
translate HZIlle ep8_2_lfz_gb_49a51d61:

#   gb "Shhhh! [cl]’s still out cold. Let her sleep."
    gb "¡Shhhh! [cl] Todavía está inconsciente. Déjala dormir."

# game/episodes/Ep8_2/episode8_2.rpy:4552
translate HZIlle ep8_2_lfz_gb_92c2b79f:

#   mc "How’s she doing?"
    mc "¿Cómo está?"

# game/episodes/Ep8_2/episode8_2.rpy:4554
translate HZIlle ep8_2_lfz_gb_a2c7d276:

#   gb "Alive, mostly because of that laser toy you gave me. That thing’s magic. I appreciate it."
    gb "Vivo, sobre todo gracias al juguete láser que me regalaste. Esa cosa es mágica, te lo agradezco."

# game/episodes/Ep8_2/episode8_2.rpy:4555
translate HZIlle ep8_2_lfz_gb_ec47889b:

#   mc "Lent. I lent it to you."
    mc "Cuaresma. Te lo presté."

# game/episodes/Ep8_2/episode8_2.rpy:4557
translate HZIlle ep8_2_lfz_gb_7ac84354:

#   gb "Semantics."
    gb "Semántica."

# game/episodes/Ep8_2/episode8_2.rpy:4558
translate HZIlle ep8_2_lfz_gb_8054d045:

#   mc "Did it fix her properly?"
    mc "¿La arregló bien?"

# game/episodes/Ep8_2/episode8_2.rpy:4560
translate HZIlle ep8_2_lfz_gb_e8c9ff5f:

#   gb "Umm… depends on your definition of ‘proper.’"
    gb "Umm... depende de tu definición de \"adecuado\"."

# game/episodes/Ep8_2/episode8_2.rpy:4561
translate HZIlle ep8_2_lfz_gb_deae286a:

#   mc "How the hell do you mess up a medical laser?! It’s idiot-proof!"
    mc "¿Cómo demonios se puede estropear un láser médico? ¡Es a prueba de idiotas!"

# game/episodes/Ep8_2/episode8_2.rpy:4563
translate HZIlle ep8_2_lfz_gb_cb2bb464:

#   gb "I burned one spot too long. She screamed, I freaked out, and then I pointed it somewhere completely unrelated—"
    gb "Quemé un punto demasiado tiempo. Ella gritó, yo me asusté y luego lo apunté a un sitio que no tenía nada que ver-."

# game/episodes/Ep8_2/episode8_2.rpy:4564
translate HZIlle ep8_2_lfz_gb_3ec16f7e:

#   mc "But she’s still breathing?"
    mc "¿Pero sigue respirando?"

# game/episodes/Ep8_2/episode8_2.rpy:4566
translate HZIlle ep8_2_lfz_gb_f5dbf0ef:

#   gb "I just told you she’s sleeping."
    gb "Acabo de decirte que está durmiendo."

# game/episodes/Ep8_2/episode8_2.rpy:4567
translate HZIlle ep8_2_lfz_gb_9ded7e37:

#   mc "Eternally?"
    mc "¿Eternamente?"

# game/episodes/Ep8_2/episode8_2.rpy:4569
translate HZIlle ep8_2_lfz_gb_007870de:

#   gb "No! The wound’s gone. I think her guts survived too."
    gb "¡No! La herida ha desaparecido. Creo que sus tripas también han sobrevivido."

# game/episodes/Ep8_2/episode8_2.rpy:4570
translate HZIlle ep8_2_lfz_gb_862137dd:

#   gb "She’s sore but alive. That counts, right?"
    gb "Está dolorida pero viva. Eso cuenta, ¿no?"

# game/episodes/Ep8_2/episode8_2.rpy:4571
translate HZIlle ep8_2_lfz_gb_683696a5:

#   mc "Please tell me you didn’t make her worse."
    mc "Por favor, dime que no la has empeorado."

# game/episodes/Ep8_2/episode8_2.rpy:4573
translate HZIlle ep8_2_lfz_gb_f0a44335:

#   gb "I helped. I get points for trying."
    gb "He ayudado. Me dan puntos por intentarlo."

# game/episodes/Ep8_2/episode8_2.rpy:4574
translate HZIlle ep8_2_lfz_gb_bb6dc375:

#   mc "Can I see her?"
    mc "¿Puedo verla?"

# game/episodes/Ep8_2/episode8_2.rpy:4576
translate HZIlle ep8_2_lfz_gb_bce11c64:

#   gb "For the THIRD time... she’s sleeping."
    gb "Por TERCERA vez... está durmiendo."

# game/episodes/Ep8_2/episode8_2.rpy:4577
translate HZIlle ep8_2_lfz_gb_a15e5cfd:

#   gb "Since when do you care, anyway?"
    gb "¿Desde cuándo te importa?"

# game/episodes/Ep8_2/episode8_2.rpy:4579
translate HZIlle ep8_2_lfz_gb_cc37dbf2:

#   mc "Jealous?"
    mc "¿Celoso?"

# game/episodes/Ep8_2/episode8_2.rpy:4580
translate HZIlle ep8_2_lfz_gb_c58052ae:

#   gb "Pft. My sister’s cute, but she’s not me."
    gb "Mi hermana es guapa, pero no soy yo."

# game/episodes/Ep8_2/episode8_2.rpy:4582
translate HZIlle ep8_2_lfz_gb_34858c57:

#   gb "Face it! We’re a fucking power duo."
    gb "¡Afróntalo! Somos un puto dúo de poder."

# game/episodes/Ep8_2/episode8_2.rpy:4583
translate HZIlle ep8_2_lfz_gb_6091b57d:

#   mc "Your sister went from hating your guts to tolerating you. In days."
    mc "Tu hermana pasó de odiarte a muerte a tolerarte, en días."

# game/episodes/Ep8_2/episode8_2.rpy:4584
translate HZIlle ep8_2_lfz_gb_b22253f8:

#   mc "Not bad."
    mc "No está mal."

# game/episodes/Ep8_2/episode8_2.rpy:4586
translate HZIlle ep8_2_lfz_gb_8db31416:

#   gb "All she had to do was almost die a couple times."
    gb "Sólo tuvo que estar a punto de morir un par de veces."

# game/episodes/Ep8_2/episode8_2.rpy:4587
translate HZIlle ep8_2_lfz_gb_190e1b25:

#   mc "You didn’t plan that, did you?"
    mc "No lo habrás planeado, ¿verdad?"

# game/episodes/Ep8_2/episode8_2.rpy:4589
translate HZIlle ep8_2_lfz_gb_757d8723:

#   gb "How fucking dare—"
    gb "¿Cómo coño te atreves?"

# game/episodes/Ep8_2/episode8_2.rpy:4590
translate HZIlle ep8_2_lfz_gb_0ac6ec80:

#   mc "Just be honest."
    mc "Sé sincera."

# game/episodes/Ep8_2/episode8_2.rpy:4592
translate HZIlle ep8_2_lfz_gb_c2dc4562:

#   gb "You think I staged a [hns] attack on my own sister?!"
    gb "¡¿Crees que organicé un ataque [hns] contra mi propia hermana?!"

# game/episodes/Ep8_2/episode8_2.rpy:4593
translate HZIlle ep8_2_lfz_gb_2cff61f5:

#   gb "And then sent [z] to finish her off just so I could swoop in looking like a hero?!"
    gb "¡¿Y luego enviaste a [z] para acabar con ella sólo para que yo pudiera abalanzarme como un héroe?!"

# game/episodes/Ep8_2/episode8_2.rpy:4595
translate HZIlle ep8_2_lfz_gb_7d7de6ae:

#   mc "Wouldn’t put it past you."
    mc "No te extrañaría."

# game/episodes/Ep8_2/episode8_2.rpy:4596
translate HZIlle ep8_2_lfz_gb_dea53b96:

#   gb "Then you don’t know me at all."
    gb "Entonces no me conoces en absoluto."

# game/episodes/Ep8_2/episode8_2.rpy:4598
translate HZIlle ep8_2_lfz_gb_06cac4a0:

#   mc "Sounds like I know you exactly."
    mc "Parece que te conozco perfectamente."

# game/episodes/Ep8_2/episode8_2.rpy:4599
translate HZIlle ep8_2_lfz_gb_290ac2ac:

#   gb "Fine. Yes, I could pull something like that off."
    gb "Bien. Sí, podría hacer algo así."

# game/episodes/Ep8_2/episode8_2.rpy:4600
translate HZIlle ep8_2_lfz_gb_bb0eeaf4:

#   mc "Thank you."
    mc "Gracias."

# game/episodes/Ep8_2/episode8_2.rpy:4602
translate HZIlle ep8_2_lfz_gb_80c2083e:

#   gb "But did I?"
    gb "¿Pero lo hice?"

# game/episodes/Ep8_2/episode8_2.rpy:4603
translate HZIlle ep8_2_lfz_gb_d8ae0743:

#   gb "Fuck. No."
    gb "Joder, no."

# game/episodes/Ep8_2/episode8_2.rpy:4605
translate HZIlle ep8_2_lfz_gb_03220b59:

#   mc "I believe you."
    mc "Te creo."

# game/episodes/Ep8_2/episode8_2.rpy:4606
translate HZIlle ep8_2_lfz_gb_686dcfca:

#   mc "So what now? [cl]’s healing. What’s next for you two?"
    mc "¿Y ahora qué? [cl] La curación. ¿Qué os espera a vosotros dos?"

# game/episodes/Ep8_2/episode8_2.rpy:4608
translate HZIlle ep8_2_lfz_gb_f0f88a03:

#   gb "[z]’s mansion is rubble, but he’s alive. Same with [law]."
    gb "La mansión de [z] está hecha escombros, pero él está vivo. Lo mismo ocurre con [law]."

# game/episodes/Ep8_2/episode8_2.rpy:4609
translate HZIlle ep8_2_lfz_gb_76e83eaa:

#   gb "What the hell else is there to do except run?"
    gb "¿Qué más se puede hacer aparte de correr?"

# game/episodes/Ep8_2/episode8_2.rpy:4611
translate HZIlle ep8_2_lfz_gb_1332ba62:

#   mc "[z]’s got bigger problems than you."
    mc "[z] tiene problemas mayores que tú."

# game/episodes/Ep8_2/episode8_2.rpy:4612
translate HZIlle ep8_2_lfz_gb_d375d966:

#   gb "[law] doesn’t. He’d shoot me for sport."
    gb "[law] No lo hace. Me pegaría un tiro por deporte."

# game/episodes/Ep8_2/episode8_2.rpy:4614
translate HZIlle ep8_2_lfz_gb_dfaaa4d3:

#   mc "I really don’t think either of them has you on their radar."
    mc "Realmente no creo que ninguno de ellos te tenga en su radar."

# game/episodes/Ep8_2/episode8_2.rpy:4615
translate HZIlle ep8_2_lfz_gb_08fcf27c:

#   gb "What makes you so sure?"
    gb "¿Por qué estás tan seguro?"

# game/episodes/Ep8_2/episode8_2.rpy:4617
translate HZIlle ep8_2_lfz_gb_47daa566:

#   mc "Cause I am the target."
    mc "Porque yo soy el objetivo."

# game/episodes/Ep8_2/episode8_2.rpy:4619
translate HZIlle ep8_2_lfz_gb_faa4d85b:

#   gb "AND YOU CAME STRAIGHT HERE?! WHAT THE FUCK IS WRONG WITH YOU?! WHAT IF HE FOLLOWED YOU?!"
    gb "¿Y HAS VENIDO DIRECTAMENTE AQUÍ? ¿QUÉ COÑO TE PASA? ¿Y SI TE HA SEGUIDO?"

# game/episodes/Ep8_2/episode8_2.rpy:4620
translate HZIlle ep8_2_lfz_gb_9330e618:

#   mc "Relax. He didn’t."
    mc "Tranquilo, no lo hizo."

# game/episodes/Ep8_2/episode8_2.rpy:4621
translate HZIlle ep8_2_lfz_gb_c5a957c0:

#   mc "[z] is done tonight. Same with [law]."
    mc "[z] ha terminado esta noche. Lo mismo con [law]."

# game/episodes/Ep8_2/episode8_2.rpy:4623
translate HZIlle ep8_2_lfz_gb_fd4c51c3:

#   gb "You’re gonna kill them?"
    gb "¿Vas a matarlos?"

# game/episodes/Ep8_2/episode8_2.rpy:4625
translate HZIlle ep8_2_lfz_gb_e0681f74:

#   mc "If the chance pops up? Yeah. They’ve earned it."
    mc "¿Si surge la oportunidad? Sí, se lo han ganado."

# game/episodes/Ep8_2/episode8_2.rpy:4628
translate HZIlle ep8_2_lfz_gb_bbf86aa8:

#   gb "But instead of hunting them, you’re here with me. Why?"
    gb "Pero en lugar de cazarlos, estás aquí conmigo. ¿Por qué?"

# game/episodes/Ep8_2/episode8_2.rpy:4629
translate HZIlle ep8_2_lfz_gb_559f1e81:

#   mc "I need [z]’s location."
    mc "Necesito la ubicación de [z]."

# game/episodes/Ep8_2/episode8_2.rpy:4631
translate HZIlle ep8_2_lfz_gb_fd8effbb:

#   gb "How the fuck would I know that?"
    gb "¿Cómo coño voy a saberlo?"

# game/episodes/Ep8_2/episode8_2.rpy:4632
translate HZIlle ep8_2_lfz_gb_501916c0:

#   gb "The guy tried murdering me. You think he’s texting me his hideouts on the side?"
    gb "El tipo intentó asesinarme. ¿Crees que me envía mensajes de texto con sus escondites?"

# game/episodes/Ep8_2/episode8_2.rpy:4634
translate HZIlle ep8_2_lfz_gb_306cff86:

#   mc "Come on, work with me. Anything? A rumor? A guess?"
    mc "Vamos, colabora conmigo. ¿Algo? ¿Un rumor? ¿Una suposición?"

# game/episodes/Ep8_2/episode8_2.rpy:4635
translate HZIlle ep8_2_lfz_gb_070e136d:

#   gb "Nothing. Honest truth."
    gb "Nada, la pura verdad."

# game/episodes/Ep8_2/episode8_2.rpy:4637
translate HZIlle ep8_2_lfz_gb_3aac42ae:

#   gb "What do you want me to do? You saved my sister’s life. I owe you. I’ll pay you back however I can."
    gb "¿Qué quieres que haga? Has salvado la vida de mi hermana. Te lo debo. Te lo devolveré como pueda."

# game/episodes/Ep8_2/episode8_2.rpy:4638
translate HZIlle ep8_2_lfz_gb_c44d64c1:

#   mc "[gb]… you saying shit like that instantly makes me hard. That’s not why I’m here."
    mc "[gb]... que digas gilipolleces como esa me la pone dura al instante, no es por eso por lo que estoy aquí."

# game/episodes/Ep8_2/episode8_2.rpy:4639
translate HZIlle ep8_2_lfz_gb_2b4a792c:

#   mc "Well, it's not the only reason."
    mc "No es la única razón."

# game/episodes/Ep8_2/episode8_2.rpy:4641
translate HZIlle ep8_2_lfz_gb_8aabc596:

#   gb "I could call him or... text him."
    gb "Podría llamarle o... enviarle un mensaje de texto."

# game/episodes/Ep8_2/episode8_2.rpy:4642
translate HZIlle ep8_2_lfz_gb_ed253185:

#   mc "Try texting. I doubt he’ll answer."
    mc "Prueba a mandarle un mensaje. Dudo que te conteste."

# game/episodes/Ep8_2/episode8_2.rpy:4644
translate HZIlle ep8_2_lfz_gb_4c666389:

#   gb "What do I even say?"
    gb "¿Qué digo?"

# game/episodes/Ep8_2/episode8_2.rpy:4645
translate HZIlle ep8_2_lfz_gb_ec884b59:

#   mc "Provoke him?"
    mc "¿Provocarle?"

# game/episodes/Ep8_2/episode8_2.rpy:4647
translate HZIlle ep8_2_lfz_gb_5dfc6df0:

#   gb "Nah. Negotiation is more my style."
    gb "No, la negociación es más mi estilo."

# game/episodes/Ep8_2/episode8_2.rpy:4648
translate HZIlle ep8_2_lfz_gb_5ad26adb:

#   gb "You look wired as hell."
    gb "Pareces muy conectado."

# game/episodes/Ep8_2/episode8_2.rpy:4649
translate HZIlle ep8_2_lfz_gb_b750bbbf:

#   mc "Yeah, because I’ve got until midnight to put him down."
    mc "Sí, porque tengo hasta medianoche para acostarlo."

# game/episodes/Ep8_2/episode8_2.rpy:4651
translate HZIlle ep8_2_lfz_gb_33e85be0:

#   gb "Why? Midnight’s not a magical hour. Deal with him tomorrow."
    gb "¿Por qué? La medianoche no es una hora mágica. Trata con él mañana."

# game/episodes/Ep8_2/episode8_2.rpy:4652
translate HZIlle ep8_2_lfz_gb_b5f5630f:

#   mc "There is no tomorrow for me. I have to finish this tonight."
    mc "No hay mañana para mí. Tengo que terminar esto esta noche."

# game/episodes/Ep8_2/episode8_2.rpy:4654
translate HZIlle ep8_2_lfz_gb_815f9e82:

#   gb "What... your military overlords gonna put you down if you don’t?"
    gb "¿Qué... tus señores militares van a acabar contigo si no lo haces?"

# game/episodes/Ep8_2/episode8_2.rpy:4655
translate HZIlle ep8_2_lfz_gb_19be5ef4:

#   mc "Wait! How do you...?"
    mc "¡Espera! ¿Cómo...?"

# game/episodes/Ep8_2/episode8_2.rpy:4657
translate HZIlle ep8_2_lfz_gb_15647fc2:

#   gb "I worked with [law], genius. I asked questions."
    gb "Trabajé con [law], genio. Hice preguntas."

# game/episodes/Ep8_2/episode8_2.rpy:4659
translate HZIlle ep8_2_lfz_gb_057a8aa4:

#   gb "Your whole mission was to infiltrate [z], fuck everyone in his orbit, and steal whatever it is he’s hiding."
    gb "Toda tu misión consistía en infiltrarte en [z], joder a todos los que estuvieran en su órbita y robar lo que fuera que escondiera."

# game/episodes/Ep8_2/episode8_2.rpy:4660
translate HZIlle ep8_2_lfz_gb_634a48eb:

#   gb "You didn’t, and this is your last chance."
    gb "No lo hiciste, y ésta es tu última oportunidad."

# game/episodes/Ep8_2/episode8_2.rpy:4662
translate HZIlle ep8_2_lfz_gb_5d47c895:

#   mc "And you’re just okay with that?"
    mc "¿Y te parece bien?"

# game/episodes/Ep8_2/episode8_2.rpy:4664
translate HZIlle ep8_2_lfz_gb_36d251c1:

#   gb "Why wouldn’t I be? We helped each other. I’ve already got my sister back."
    gb "¿Por qué no iba a estarlo? Nos ayudamos mutuamente. Ya he recuperado a mi hermana."

# game/episodes/Ep8_2/episode8_2.rpy:4665
translate HZIlle ep8_2_lfz_gb_bdf2c310:

#   gb "I’d like you to win too. As long as I’m not paying the price for it."
    gb "A mí también me gustaría que ganaras, siempre y cuando no pague el precio por ello."

# game/episodes/Ep8_2/episode8_2.rpy:4666
translate HZIlle ep8_2_lfz_gb_d844dc6d:

#   gb "Sounds fair?"
    gb "¿Te parece justo?"

# game/episodes/Ep8_2/episode8_2.rpy:4668
translate HZIlle ep8_2_lfz_gb_35c1fbee:

#   mc "Yeah. You just want [z] and [law] gone. Doesn’t matter who takes them out."
    mc "Sí. Sólo quieres que [z] y [law] se vayan. No importa quién los elimine."

# game/episodes/Ep8_2/episode8_2.rpy:4670
translate HZIlle ep8_2_lfz_gb_5e8f6d4a:

#   gb "Yup."
    gb "Sí."

# game/episodes/Ep8_2/episode8_2.rpy:4671
translate HZIlle ep8_2_lfz_gb_ed0c9c8b:

#   mc "God, [gb]… don’t ever change."
    mc "Dios, [gb]... no cambies nunca."

# game/episodes/Ep8_2/episode8_2.rpy:4673
translate HZIlle ep8_2_lfz_gb_f1caa6fb:

#   gb "Wouldn’t dream of it."
    gb "Ni lo sueñes."

# game/episodes/Ep8_2/episode8_2.rpy:4675
translate HZIlle ep8_2_lfz_gb_1a15400f:

#   gb "Sooo… while we wait for his reply…?"
    gb "Así que... mientras esperamos su respuesta..."

# game/episodes/Ep8_2/episode8_2.rpy:4684
translate HZIlle ep8_2_lfz_gb_0778c8f9:

#   mc "Trust me, I want you so fucking badly right now… but I can’t."
    mc "Créeme, te deseo tanto ahora mismo... pero no puedo."

# game/episodes/Ep8_2/episode8_2.rpy:4686
translate HZIlle ep8_2_lfz_gb_d6aeffa7:

#   gb "Then there’s something else you want more. That’s fine. Go get it."
    gb "Entonces hay otra cosa que deseas más, está bien, ve a por ella."

# game/episodes/Ep8_2/episode8_2.rpy:4687
translate HZIlle ep8_2_lfz_gb_3836d029:

#   gb "Good luck, [mc]."
    gb "Buena suerte, [mc]."

# game/episodes/Ep8_2/episode8_2.rpy:4689
translate HZIlle ep8_2_lfz_gb_6f36be4b:

#   mc "See you around?"
    mc "¿Nos vemos?"

# game/episodes/Ep8_2/episode8_2.rpy:4691
translate HZIlle ep8_2_lfz_gb_afcd6722:

#   gb "Yeah… and if not here, maybe somewhere else. Who the fuck knows?"
    gb "Sí... y si no es aquí, quizá en otro sitio. ¿Quién coño sabe?"

