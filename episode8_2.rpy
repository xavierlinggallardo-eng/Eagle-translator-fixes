# game/episodes/Ep8_2/episode8_2.rpy:5059
translate HZIlle ep8_2_lfz_saj_9dc68b45:

#   sa "He also told me to never contact him again. No calls. No texts. Ever."
    sa "También me dijo que no volviera a contactar con él, ni llamadas, ni mensajes, nunca."

# game/episodes/Ep8_2/episode8_2.rpy:5061
translate HZIlle ep8_2_lfz_saj_43a58ef8:

#   mc "I mean… I’m happy for you. You deserve that. But fuck, this is why I’m here. I need to find [z]."
    mc "Quiero decir... me alegro por ti, te lo mereces. Pero joder, por esto estoy aquí, necesito encontrar a [z]."

# game/episodes/Ep8_2/episode8_2.rpy:5062
translate HZIlle ep8_2_lfz_saj_c06f1adc:

#   mc "You sure you don’t know anything?"
    mc "¿Seguro que no sabes nada?"

# game/episodes/Ep8_2/episode8_2.rpy:5064
translate HZIlle ep8_2_lfz_saj_46ea3954:

#   sa "I don’t."
    sa "Yo no."

# game/episodes/Ep8_2/episode8_2.rpy:5065
translate HZIlle ep8_2_lfz_saj_78efcc6b:

#   sa "Only thing I caught was wind noise. Pretty strong. Probably far away. Connection kept dropping. Doesn’t help you much, does it?"
    sa "Lo único que capté fue el ruido del viento. Bastante fuerte. Probablemente muy lejos. La conexión seguía cayendo. No te ayuda mucho, ¿verdad?"

# game/episodes/Ep8_2/episode8_2.rpy:5067
translate HZIlle ep8_2_lfz_saj_ca9a8b15:

#   mc "Sadly… no."
    mc "Lamentablemente... no."

# game/episodes/Ep8_2/episode8_2.rpy:5071
translate HZIlle ep8_2_lfz_saj_2f69855f:

#   j "[mc]! Holy shit! I haven’t seen you in so long!"
    j "[mc] ¡Mierda! ¡Hacía mucho que no te veía!"

# game/episodes/Ep8_2/episode8_2.rpy:5072
translate HZIlle ep8_2_lfz_saj_38349168:

#   j "I missed you like crazy!"
    j "¡Te he echado mucho de menos!"

# game/episodes/Ep8_2/episode8_2.rpy:5074
translate HZIlle ep8_2_lfz_saj_90b8c1d5:

#   mc "Hah! [j]. Good to see you too."
    mc "¡Ja! [j]Yo también me alegro de verte."

# game/episodes/Ep8_2/episode8_2.rpy:5075
translate HZIlle ep8_2_lfz_saj_f7e68355:

#   mc "How are you holding up?"
    mc "¿Cómo lo llevas?"

# game/episodes/Ep8_2/episode8_2.rpy:5078
translate HZIlle ep8_2_lfz_saj_886de3b0:

#   j "Better. A lot better."
    j "Mejor, mucho mejor."

# game/episodes/Ep8_2/episode8_2.rpy:5079
translate HZIlle ep8_2_lfz_saj_e66e64a4:

#   j "Mostly thanks to the little demon right here."
    j "Sobre todo gracias al pequeño demonio de aquí."

# game/episodes/Ep8_2/episode8_2.rpy:5081
translate HZIlle ep8_2_lfz_saj_e07ccfc9:

#   mc "Glad to hear it."
    mc "Me alegro de oírlo."

# game/episodes/Ep8_2/episode8_2.rpy:5082
translate HZIlle ep8_2_lfz_saj_9ed7a637:

#   j "So, what dragged you all the way here?"
    j "¿Qué te ha arrastrado hasta aquí?"

# game/episodes/Ep8_2/episode8_2.rpy:5085
translate HZIlle ep8_2_lfz_saj_bf433f34:

#   mc "Missing an old friend isn’t enough?"
    mc "¿Echar de menos a un viejo amigo no es suficiente?"

# game/episodes/Ep8_2/episode8_2.rpy:5086
translate HZIlle ep8_2_lfz_saj_beca6394:

#   j "It is. But you always come with some insane mission hanging off your back. Tell me I’m wrong."
    j "Lo es. Pero siempre vienes con alguna misión descabellada colgando de la espalda. Dime que me equivoco."

# game/episodes/Ep8_2/episode8_2.rpy:5088
translate HZIlle ep8_2_lfz_saj_6c1e6c87:

#   mc "…You’re not."
    mc "...No lo eres."

# game/episodes/Ep8_2/episode8_2.rpy:5089
translate HZIlle ep8_2_lfz_saj_8d3888bb:

#   mc "You wouldn’t happen to know where [z] is hiding?"
    mc "¿Por casualidad no sabrás dónde se esconde [z]?"

# game/episodes/Ep8_2/episode8_2.rpy:5091
translate HZIlle ep8_2_lfz_saj_e1bc7165:

#   j "I’m totally out of the loop. Sorry."
    j "Estoy totalmente fuera de onda, lo siento."

# game/episodes/Ep8_2/episode8_2.rpy:5092
translate HZIlle ep8_2_lfz_saj_e6843e83:

#   j "The only thing I heard was about the mansion. [z] bailed, everything went to hell overnight."
    j "Lo único que oí fue lo de la mansión. [z] se largó, todo se fue al infierno de la noche a la mañana."

# game/episodes/Ep8_2/episode8_2.rpy:5094
translate HZIlle ep8_2_lfz_saj_118c24a8:

#   j "Insane, right? Man built an empire his whole damn life just to watch it burn in a single night."
    j "Una locura, ¿verdad? El hombre construyó un imperio toda su maldita vida sólo para verlo arder en una sola noche."

# game/episodes/Ep8_2/episode8_2.rpy:5095
translate HZIlle ep8_2_lfz_saj_a00125ab:

#   mc "He earned it. It wasn’t some one-night screwup. It was a chain of shitty choices that finally bit him."
    mc "Se lo ganó a pulso. No fue una metedura de pata de una noche, sino una cadena de decisiones de mierda que acabaron por morderle."

# game/episodes/Ep8_2/episode8_2.rpy:5097
translate HZIlle ep8_2_lfz_saj_342759d2:

#   j "Starting with [r]… and everything he chose."
    j "Empezando por [r]... y todo lo que eligió."

# game/episodes/Ep8_2/episode8_2.rpy:5098
translate HZIlle ep8_2_lfz_saj_2dfce04d:

#   mc "Seriously… how are you?"
    mc "En serio... ¿cómo estás?"

# game/episodes/Ep8_2/episode8_2.rpy:5100
translate HZIlle ep8_2_lfz_saj_d7d0f65b:

#   j "It’s been rough. Sleepless nights. Random anger. That feeling like you want to smash anything within reach."
    j "Ha sido duro. Noches sin dormir. Enfados aleatorios. Esa sensación de querer destrozar todo lo que esté a tu alcance."

# game/episodes/Ep8_2/episode8_2.rpy:5102
translate HZIlle ep8_2_lfz_saj_0bbe93de:

#   mc "It’s still fresh. That’s normal. Give it time."
    mc "Aún está fresco, es normal, dale tiempo."

# game/episodes/Ep8_2/episode8_2.rpy:5103
translate HZIlle ep8_2_lfz_saj_dd7f550c:

#   mc "Stick with people like [sa], and one morning you’ll wake up and realize you didn’t think about it once."
    mc "Quédate con gente como [sa], y una mañana te despertarás y te darás cuenta de que no lo pensaste ni una sola vez."

# game/episodes/Ep8_2/episode8_2.rpy:5105
translate HZIlle ep8_2_lfz_saj_240eff97:

#   j "Are there more people like [sa]?"
    j "¿Hay más gente como [sa]?"

# game/episodes/Ep8_2/episode8_2.rpy:5106
translate HZIlle ep8_2_lfz_saj_df00cd6f:

#   mc "She's rare species."
    mc "Es una especie rara."

# game/episodes/Ep8_2/episode8_2.rpy:5108
translate HZIlle ep8_2_lfz_saj_d7b26671:

#   j "What about… people like you?"
    j "¿Qué pasa con... la gente como tú?"

# game/episodes/Ep8_2/episode8_2.rpy:5109
translate HZIlle ep8_2_lfz_saj_f9c8f678:

#   mc "Oh, you can find assholes like me anywhere."
    mc "Puedes encontrar gilipollas como yo en cualquier sitio."

# game/episodes/Ep8_2/episode8_2.rpy:5111
translate HZIlle ep8_2_lfz_saj_60c68a4b:

#   j "I don’t want to hate [r] forever. I don’t think I can."
    j "No quiero odiar a [r] para siempre, no creo que pueda."

# game/episodes/Ep8_2/episode8_2.rpy:5112
translate HZIlle ep8_2_lfz_saj_279cce89:

#   mc "That’s a pretty big sign you’re healing."
    mc "Eso es una señal bastante grande de que te estás curando."

# game/episodes/Ep8_2/episode8_2.rpy:5114
translate HZIlle ep8_2_lfz_saj_31c928ad:

#   j "I like to think he changed. Not fully. You can’t erase who he was. But he was trying."
    j "Me gusta pensar que cambió. No del todo. No se puede borrar lo que era, pero lo intentaba."

# game/episodes/Ep8_2/episode8_2.rpy:5115
translate HZIlle ep8_2_lfz_saj_67d79269:

#   j "If he were still here, I think he’d try to take care of me. Keep me safe."
    j "Si aún estuviera aquí, creo que intentaría cuidarme, mantenerme a salvo."

# game/episodes/Ep8_2/episode8_2.rpy:5117
translate HZIlle ep8_2_lfz_saj_89bc0084:

#   j "At least… that’s what I keep telling myself."
    j "Al menos... eso es lo que me digo a mí mismo."

# game/episodes/Ep8_2/episode8_2.rpy:5118
translate HZIlle ep8_2_lfz_saj_e664fac8:

#   j "But is that even okay? He murdered my parents. Thinking this way... feels unfair to them."
    j "¿Pero eso está bien? Asesinó a mis padres. Pensar así... me parece injusto para ellos."

# game/episodes/Ep8_2/episode8_2.rpy:5119
translate HZIlle ep8_2_lfz_saj_d22a4440:

#   j "I don’t know what to feel. Whatever I choose just seems… wrong."
    j "No sé qué sentir. Cualquier cosa que elija me parece... equivocada."

# game/episodes/Ep8_2/episode8_2.rpy:5121
translate HZIlle ep8_2_lfz_saj_d7d20527:

#   mc "Since when is life fair to anyone?"
    mc "¿Desde cuándo la vida es justa para alguien?"

# game/episodes/Ep8_2/episode8_2.rpy:5122
translate HZIlle ep8_2_lfz_saj_348add7d:

#   mc "Say what you really feel. There’s no crime in believing he cared for you. Or that he tried to change because of you."
    mc "Di lo que sientes de verdad. No hay delito en creer que se preocupaba por ti. O que intentaba cambiar por ti."

# game/episodes/Ep8_2/episode8_2.rpy:5123
translate HZIlle ep8_2_lfz_saj_d81d8769:

#   mc "He died so you could live. That means something."
    mc "Murió para que tú pudieras vivir, eso significa algo."

# game/episodes/Ep8_2/episode8_2.rpy:5125
translate HZIlle ep8_2_lfz_saj_90227dc7:

#   j "God… I hate that bastard even more now."
    j "Dios... ahora odio aún más a ese bastardo."

# game/episodes/Ep8_2/episode8_2.rpy:5126
translate HZIlle ep8_2_lfz_saj_0065332f:

#   mc "You’ll get through this. You’re built for survival. Doesn’t matter what gets thrown at you... you’ll get past it."
    mc "Lo superarás. Estás hecho para sobrevivir. No importa lo que te echen... lo superarás."

# game/episodes/Ep8_2/episode8_2.rpy:5128
translate HZIlle ep8_2_lfz_saj_a3a2eff4:

#   j "Thank you, [mc]."
    j "Gracias, [mc]."

# game/episodes/Ep8_2/episode8_2.rpy:5131
translate HZIlle ep8_2_lfz_saj_6a0c36bb:

#   j "And… good luck with [z]."
    j "Y... buena suerte con [z]."

# game/episodes/Ep8_2/episode8_2.rpy:5137
translate HZIlle ep8_2_lfz_saj_eb365a02:

#   sa "You’re not going anywhere."
    sa "No irás a ninguna parte."

# game/episodes/Ep8_2/episode8_2.rpy:5138
translate HZIlle ep8_2_lfz_saj_05500ff6:

#   mc "Huh?"
    mc "¿Eh?"

# game/episodes/Ep8_2/episode8_2.rpy:5140
translate HZIlle ep8_2_lfz_saj_b6727ce2:

#   sa "You heard me."
    sa "Ya me has oído."

# game/episodes/Ep8_2/episode8_2.rpy:5141
translate HZIlle ep8_2_lfz_saj_0df2d116:

#   sa "You’re lying to me. You’ve been lying to me from the start."
    sa "Me has estado mintiendo desde el principio."

# game/episodes/Ep8_2/episode8_2.rpy:5143
translate HZIlle ep8_2_lfz_saj_6ab91029:

#   mc "About what? I told you... I’m an agent for a private military company, and I’m here to steal from [z]. That’s not a lie."
    mc "¿Sobre qué? Ya te lo he dicho... Soy agente de una empresa militar privada y estoy aquí para robar a [z]. Eso no es mentira."

# game/episodes/Ep8_2/episode8_2.rpy:5145
translate HZIlle ep8_2_lfz_saj_54cfce0b:

#   sa "No. But it’s not the full truth either."
    sa "No. Pero tampoco es toda la verdad."

# game/episodes/Ep8_2/episode8_2.rpy:5146
translate HZIlle ep8_2_lfz_saj_94ef8b58:

#   sa "And I want the full truth."
    sa "Y quiero toda la verdad."

# game/episodes/Ep8_2/episode8_2.rpy:5148
translate HZIlle ep8_2_lfz_saj_76b0a68e:

#   mc "There’s nothing else. That’s it!"
    mc "No hay nada más. ¡Eso es!"

# game/episodes/Ep8_2/episode8_2.rpy:5150
translate HZIlle ep8_2_lfz_saj_9ba6f3a1:

#   sa "Okay. Fuck you."
    sa "Vale, que te den."

# game/episodes/Ep8_2/episode8_2.rpy:5152
translate HZIlle ep8_2_lfz_saj_3fc3c3c6:

#   mc "[sa], wait!"
    mc "[sa], ¡espera!"

# game/episodes/Ep8_2/episode8_2.rpy:5155
translate HZIlle ep8_2_lfz_saj_426f2f21:

#   mc "[sa], stop! Can you just... stop!"
    mc "[sa], ¡para! ¡Puedes... parar!"

# game/episodes/Ep8_2/episode8_2.rpy:5157
translate HZIlle ep8_2_lfz_saj_825350bb:

#   sa "If any of this was real for you, you’ll tell me everything."
    sa "Si algo de esto fue real para ti, me lo contarás todo."

# game/episodes/Ep8_2/episode8_2.rpy:5159
translate HZIlle ep8_2_lfz_saj_81ba2d32:

#   sa "If not... if you just wanted my ass... then get the hell out of my sight."
    sa "Si no... si sólo querías mi culo... entonces lárgate de mi vista."

# game/episodes/Ep8_2/episode8_2.rpy:5166
translate HZIlle ep8_2_lfz_saj_f46e8568:

#   mc "Listen. Whatever we are... it’s real."
    mc "Escucha, seamos lo que seamos... es real."

# game/episodes/Ep8_2/episode8_2.rpy:5168
translate HZIlle ep8_2_lfz_saj_0ebe21bd:

#   sa "And that’s not just because you like my ass?"
    sa "¿Y eso no es sólo porque te gusta mi culo?"

# game/episodes/Ep8_2/episode8_2.rpy:5170
translate HZIlle ep8_2_lfz_saj_bcd600d4:

#   mc "It is… a little bit."
    mc "Lo es... un poco."

# game/episodes/Ep8_2/episode8_2.rpy:5172
translate HZIlle ep8_2_lfz_saj_397a0a40:

#   sa "My ass appreciates being acknowledged."
    sa "Mi culo agradece que se le reconozca."

# game/episodes/Ep8_2/episode8_2.rpy:5173
translate HZIlle ep8_2_lfz_saj_05c3362f:

#   sa "Now tell me."
    sa "Ahora dime."

# game/episodes/Ep8_2/episode8_2.rpy:5175
translate HZIlle ep8_2_lfz_saj_725ee396:

#   mc "None of this is real. The world, the city... everything is part of a simulation built by a giant corporation."
    mc "Nada de esto es real. El mundo, la ciudad... todo forma parte de una simulación construida por una corporación gigante."

# game/episodes/Ep8_2/episode8_2.rpy:5176
translate HZIlle ep8_2_lfz_saj_7efa9ab3:

#   mc "I’m here with my team to extract data from [z]. Me, [n], [l]… we’re the real ones."
    mc "Estoy aquí con mi equipo para extraer datos de [z]. Yo, [n], [l]... somos los auténticos."

# game/episodes/Ep8_2/episode8_2.rpy:5178
translate HZIlle ep8_2_lfz_saj_0cc58170:

#   mc "You’re… not. You’re a projection. A version of someone who exists outside."
    mc "Eres... no. Eres una proyección. Una versión de alguien que existe fuera."

# game/episodes/Ep8_2/episode8_2.rpy:5179
translate HZIlle ep8_2_lfz_saj_244b985e:

#   mc "So yeah, call me crazy."
    mc "Así que sí, llámame loca."

# game/episodes/Ep8_2/episode8_2.rpy:5181
translate HZIlle ep8_2_lfz_saj_499d013c:

#   sa "You are crazy."
    sa "Estás loca."

# game/episodes/Ep8_2/episode8_2.rpy:5182
translate HZIlle ep8_2_lfz_saj_32bc1470:

#   sa "But for once, you’re actually telling me something truthful."
    sa "Pero, por una vez, me dices algo de verdad."

# game/episodes/Ep8_2/episode8_2.rpy:5185
translate HZIlle ep8_2_lfz_saj_3466ae0f:

#   mc "Try leaving the city borders. You won’t get far. There’s nothing outside them."
    mc "Intenta salir de los límites de la ciudad. No llegarás lejos. No hay nada fuera de ellos."

# game/episodes/Ep8_2/episode8_2.rpy:5186
translate HZIlle ep8_2_lfz_saj_cca42a44:

#   mc "You’re ‘free’ only when someone pulls you out. Me or another agent."
    mc "Sólo eres \"libre\" cuando alguien te saca: yo u otro agente."

# game/episodes/Ep8_2/episode8_2.rpy:5189
translate HZIlle ep8_2_lfz_saj_5a8507c2:

#   sa "Free… as in dead?"
    sa "¿Libre... como muerto?"

# game/episodes/Ep8_2/episode8_2.rpy:5191
translate HZIlle ep8_2_lfz_saj_8285cd08:

#   mc "Free as in saved."
    mc "Libre como en salvado."

# game/episodes/Ep8_2/episode8_2.rpy:5193
translate HZIlle ep8_2_lfz_saj_aa4c9e0f:

#   sa "My head hurts."
    sa "Me duele la cabeza."

# game/episodes/Ep8_2/episode8_2.rpy:5194
translate HZIlle ep8_2_lfz_saj_f0e1a972:

#   mc "It should. I’m pretty sure I wasn’t supposed to tell you any of this…"
    mc "Debería. Estoy bastante seguro de que no debía decirte nada de esto..."

# game/episodes/Ep8_2/episode8_2.rpy:5196
translate HZIlle ep8_2_lfz_saj_f932d39c:

#   sa "In the real world… if I saw you… would I know you?"
    sa "En el mundo real... si te viera... ¿te reconocería?"

# game/episodes/Ep8_2/episode8_2.rpy:5198
translate HZIlle ep8_2_lfz_saj_20d0d2ca:

#   mc "I don’t know. Maybe. If we’re lucky."
    mc "No sé, tal vez, si tenemos suerte."

# game/episodes/Ep8_2/episode8_2.rpy:5200
translate HZIlle ep8_2_lfz_saj_f0121111:

#   sa "So the real me doesn’t know I’m here?"
    sa "¿Así que mi verdadero yo no sabe que estoy aquí?"

# game/episodes/Ep8_2/episode8_2.rpy:5201
translate HZIlle ep8_2_lfz_saj_53a5d8ff:

#   mc "Not even a little."
    mc "Ni siquiera un poco."

# game/episodes/Ep8_2/episode8_2.rpy:5203
translate HZIlle ep8_2_lfz_saj_221d7bac:

#   sa "Then find me. Out there. Wherever the hell I am."
    sa "Entonces encuéntrame, ahí fuera, donde demonios esté."

# game/episodes/Ep8_2/episode8_2.rpy:5204
translate HZIlle ep8_2_lfz_saj_2d416d56:

#   sa "Pull me out of this cage. I don’t want to stay here."
    sa "Sácame de esta jaula, no quiero quedarme aquí."

# game/episodes/Ep8_2/episode8_2.rpy:5206
translate HZIlle ep8_2_lfz_saj_31261ed1:

#   mc "I’ll try. I’ll do everything I can."
    mc "Lo intentaré. Haré todo lo que pueda."

# game/episodes/Ep8_2/episode8_2.rpy:5208
translate HZIlle ep8_2_lfz_saj_3eb75cde:

#   sa "Don’t ‘try.’ Do it."
    sa "No lo \"intentes\", hazlo."

# game/episodes/Ep8_2/episode8_2.rpy:5209
translate HZIlle ep8_2_lfz_saj_2308a15f:

#   mc "I will. I promise."
    mc "Lo haré, te lo prometo."

# game/episodes/Ep8_2/episode8_2.rpy:5215
translate HZIlle ep8_2_lfz_saj_952c673e:

#   mc "I don’t know what to tell you."
    mc "No sé qué decirte."

# game/episodes/Ep8_2/episode8_2.rpy:5217
translate HZIlle ep8_2_lfz_saj_f99b57a1:

#   sa "Then don’t tell me anything. Just leave me alone."
    sa "Entonces no me digas nada, déjame en paz."

# game/episodes/Ep8_2/episode8_2.rpy:5226
translate HZIlle ep8_2_saj_ss_menu_164c12c5:

#   mct "I just poured my soul out to [sa], told her shit I wasn’t even allowed to say."
    mct "Acabo de derramar mi alma ante [sa], le he dicho cosas que ni siquiera me estaba permitido decir."

# game/episodes/Ep8_2/episode8_2.rpy:5227
translate HZIlle ep8_2_saj_ss_menu_de269419:

