translate HZIlle ep8_2_penthouse_after_5588b866:

#   k "We do."
    k "Lo hacemos."

# game/episodes/Ep8_2/episode8_2.rpy:3173
translate HZIlle ep8_2_penthouse_after_74dbceb7:

#   f "Well. This isn’t awkward at all. Anyway, [k]… you must have a thousand questions, and I’m here to answer every single one."
    f "Bueno, esto no es incómodo en absoluto. De todos modos, [k]... debes de tener mil preguntas, y yo estoy aquí para responder a todas y cada una de ellas."

