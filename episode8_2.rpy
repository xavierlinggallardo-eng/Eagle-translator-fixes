# game/episodes/Ep8_2/episode8_2.rpy:5847
translate HZIlle ep8_2_lfz_after_53aa065f:

#   l "Right, but hear me out... what if we use [law] to draw [z] out?"
    l "Vale, pero escúchame... ¿y si utilizamos [law] para sacar [z]?"

# game/episodes/Ep8_2/episode8_2.rpy:5849
translate HZIlle ep8_2_lfz_after_7347df6b:

#   n "We’ve already killed him once in this sim. He’s basically one death away from becoming a final boss."
    n "Ya lo hemos matado una vez en esta simulación. Está básicamente a una muerte de convertirse en jefe final."

# game/episodes/Ep8_2/episode8_2.rpy:5851
translate HZIlle ep8_2_lfz_after_8035b7d5:

#   l "Yeah, but who cares? We’re not fighting him."
    l "Sí, pero ¿a quién le importa? No vamos a luchar contra él."

# game/episodes/Ep8_2/episode8_2.rpy:5853
translate HZIlle ep8_2_lfz_after_b445079c:

#   mc "That… actually makes sense. Okay, I like this. So how do we use him?"
    mc "Eso... en realidad tiene sentido. Vale, me gusta. Entonces, ¿cómo lo utilizamos?"

# game/episodes/Ep8_2/episode8_2.rpy:5855
translate HZIlle ep8_2_lfz_after_e945e7b4:

#   n "Well… our genius over here didn’t think that far."
    n "Bueno... nuestro genio de aquí no pensó tan lejos."

# game/episodes/Ep8_2/episode8_2.rpy:5857
translate HZIlle ep8_2_lfz_after_a8521aeb:

#   mc "Hmm… Lady in Black. She’s connected to [law]. Somehow."
    mc "Hmm... La Dama de Negro. Está conectada con [law]. De alguna manera."

# game/episodes/Ep8_2/episode8_2.rpy:5858
translate HZIlle ep8_2_lfz_after_5236eae1:

#   mc "Either she works with him or she works for him."
    mc "O trabaja con él o trabaja para él."

# game/episodes/Ep8_2/episode8_2.rpy:5859
translate HZIlle ep8_2_lfz_after_ee466a17:

#   mc "That whole ‘kicking me in the head’ bullshit? Revenge for robbing her? Yeah, right."
    mc "¿Esa gilipollez de \"darme una patada en la cabeza\"? ¿Venganza por robarle? Sí, claro."

# game/episodes/Ep8_2/episode8_2.rpy:5861
translate HZIlle ep8_2_lfz_after_3a2413e9:

#   mc "Her real job was delivering me straight into his hands so he could stab me with that shit."
    mc "Su verdadero trabajo era entregarme directamente en sus manos para que me apuñalara con esa mierda."

# game/episodes/Ep8_2/episode8_2.rpy:5862
translate HZIlle ep8_2_lfz_after_0acf946c:

#   mc "If we want to get to [law], she’s our way in."
    mc "Si queremos llegar a [law], ella es nuestra vía de entrada."

# game/episodes/Ep8_2/episode8_2.rpy:5865
translate HZIlle ep8_2_lfz_after_766b02df:

#   n "You good?"
    n "¿Estás bien?"

# game/episodes/Ep8_2/episode8_2.rpy:5867
translate HZIlle ep8_2_lfz_after_5830ee1e:

#   mc "Y-yeah? I mean… tell me that doesn’t make sense."
    mc "¿Sí? Quiero decir... dime que no tiene sentido."

# game/episodes/Ep8_2/episode8_2.rpy:5869
translate HZIlle ep8_2_lfz_after_f6d60af8:

#   n "It does."
    n "Así es."

# game/episodes/Ep8_2/episode8_2.rpy:5871
translate HZIlle ep8_2_lfz_after_09f33f63:

#   mc "Then what’s the problem?"
    mc "Entonces, ¿cuál es el problema?"

# game/episodes/Ep8_2/episode8_2.rpy:5873
translate HZIlle ep8_2_lfz_after_cb2770a0:

#   n "You being this smart. It’s unnatural."
    n "Que seas tan inteligente no es natural."

# game/episodes/Ep8_2/episode8_2.rpy:5875
translate HZIlle ep8_2_lfz_after_0ef941cc:

#   mc "Oh, fuck off. I’m fine."
    mc "Vete a la mierda, estoy bien."

# game/episodes/Ep8_2/episode8_2.rpy:5876
translate HZIlle ep8_2_lfz_after_53f4e79d:

#   mc "Everyone on board?"
    mc "¿Todos a bordo?"

# game/episodes/Ep8_2/episode8_2.rpy:5878
translate HZIlle ep8_2_lfz_after_64d35993:

#   l "Hell yeah!"
    l "¡Claro que sí!"

# game/episodes/Ep8_2/episode8_2.rpy:5880
translate HZIlle ep8_2_lfz_after_50ab0b57:

#   n "How do we get Lady in Black on our side?"
    n "¿Cómo ponemos a la Dama de Negro de nuestro lado?"

# game/episodes/Ep8_2/episode8_2.rpy:5881
translate HZIlle ep8_2_lfz_after_8bad73c2:

#   mc "I already got a plan for that. Follow me."
    mc "Ya tengo un plan para eso, sígueme."

# game/episodes/Ep8_2/episode8_2.rpy:5883
translate HZIlle ep8_2_lfz_after_70643cd2:

#   n "Is that so?"
    n "¿Es así?"

# game/episodes/Ep8_2/episode8_2.rpy:5884
translate HZIlle ep8_2_lfz_after_8c0a0044:

#   l "Lead the way, almighty [mc]!"
    l "¡Guía el camino, todopoderoso [mc]!"

# game/episodes/Ep8_2/episode8_2.rpy:5893
translate HZIlle ep8_2_fv_520dc53d:

#   law "[z] has the third key. It won’t reveal itself until one of the agents gets close enough to pull it out."
    law "[z] tiene la tercera llave. No se revelará hasta que uno de los agentes se acerque lo suficiente para sacarla."

# game/episodes/Ep8_2/episode8_2.rpy:5897
translate HZIlle ep8_2_fv_4a9c3047:

#   law "Get to the station."
    law "Llega a la estación."

# game/episodes/Ep8_2/episode8_2.rpy:5898
translate HZIlle ep8_2_fv_7901d9ff:

#   law "I’ve got something I need you to assist me with."
    law "Tengo algo en lo que necesito que me ayudes."

# game/episodes/Ep8_2/episode8_2.rpy:5904
translate HZIlle ep8_2_fv_a15d334c:

#   mc "Hey..."
    mc "Oye..."

# game/episodes/Ep8_2/episode8_2.rpy:5909
translate HZIlle ep8_2_fv_926b9aef:

#   mc "Ugh! This woman’s a goddamn headache. Can’t she do one thing without getting under my skin?"
    mc "Esta mujer es un maldito dolor de cabeza. ¿No puede hacer una cosa sin meterse en mi piel?"

# game/episodes/Ep8_2/episode8_2.rpy:5911
translate HZIlle ep8_2_fv_f07fe657:

#   n "She feeds off your reaction. Haven’t you noticed? The more pissed you get, the more she loves it. Play it cool."
    n "Se alimenta de tu reacción. ¿No te has dado cuenta? Cuanto más cabreado te pones, más le gusta. Tranquilízate."

# game/episodes/Ep8_2/episode8_2.rpy:5912
translate HZIlle ep8_2_fv_c52115c6:

#   n "Remember, this is our last scam. Tell her you’ll hand-deliver your dick on a silver platter. Whatever gets her on board."
    n "Recuerda que es nuestra última estafa. Dile que le entregarás tu polla en bandeja de plata. Lo que sea que la haga subir a bordo."

# game/episodes/Ep8_2/episode8_2.rpy:5914
translate HZIlle ep8_2_fv_2b35b6fe:

#   mc "..."
    mc "..."

# game/episodes/Ep8_2/episode8_2.rpy:5915
translate HZIlle ep8_2_fv_55d904fc:

#   mc "She’s dragging this on just to piss me off."
    mc "Está alargando esto sólo para cabrearme."

# game/episodes/Ep8_2/episode8_2.rpy:5918
translate HZIlle ep8_2_fv_6fe64dce:

#   n "And I repeat… Calm. The fuck. Down."
    n "Y repito... Calma, joder."

# game/episodes/Ep8_2/episode8_2.rpy:5921
translate HZIlle ep8_2_fv_91dffcb9:

#   mc "[n], while we're waiting..."
    mc "[n], mientras esperamos..."

# game/episodes/Ep8_2/episode8_2.rpy:5922
translate HZIlle ep8_2_fv_c3100b99:

#   mc "Are you planning to fuck us over?"
    mc "¿Planeas jodernos?"

# game/episodes/Ep8_2/episode8_2.rpy:5924
translate HZIlle ep8_2_fv_6a908319:

#   n "What?!"
    n "¿Qué?"

# game/episodes/Ep8_2/episode8_2.rpy:5926
translate HZIlle ep8_2_fv_696dd50e:

#   mc "You’ve been clawing for freedom from Aegis. You’ll burn the world down if you have to."
    mc "Has estado arañando la libertad de Aegis. Quemarás el mundo si es necesario."

# game/episodes/Ep8_2/episode8_2.rpy:5928
translate HZIlle ep8_2_fv_53ce1e17:

#   n "Shut—"
    n "Cierra-"

# game/episodes/Ep8_2/episode8_2.rpy:5929
translate HZIlle ep8_2_fv_274da870:

#   n "Shut your damn mouth."
    n "Cierra la maldita boca."

# game/episodes/Ep8_2/episode8_2.rpy:5931
translate HZIlle ep8_2_fv_cfb0879f:

#   mc "Tell me about the side job with [msd]."
    mc "Háblame del trabajo paralelo con [msd]."

# game/episodes/Ep8_2/episode8_2.rpy:5933
translate HZIlle ep8_2_fv_22465620:

#   n "Where are you getting this bullshit from?"
    n "¿De dónde sacas esas gilipolleces?"

# game/episodes/Ep8_2/episode8_2.rpy:5935
translate HZIlle ep8_2_fv_811354b6:

#   mc "Your previous mission. You went rogue. Daniel got his head blown off by [exe]."
    mc "Tu misión anterior. Te hiciste el pícaro. A Daniel le voló la cabeza [exe]."

# game/episodes/Ep8_2/episode8_2.rpy:5936
translate HZIlle ep8_2_fv_dea7d055:

#   mc "The mission was done. Yet you stayed behind. For something else. Something [msd] wanted."
    mc "La misión estaba cumplida. Sin embargo, te quedaste atrás. Por algo más. Por algo [msd] querido</b0>."

# game/episodes/Ep8_2/episode8_2.rpy:5938
translate HZIlle ep8_2_fv_be59fc22:

#   mc "What was it?"
    mc "¿Qué era?"

# game/episodes/Ep8_2/episode8_2.rpy:5940
translate HZIlle ep8_2_fv_9422e03b:

#   n "Say one more goddamn word—"
    n "Di una maldita palabra más-"

# game/episodes/Ep8_2/episode8_2.rpy:5942
translate HZIlle ep8_2_fv_d593d78f:

#   mc "Kill me? Sure. And that magically buys you freedom how?"
    mc "¿Matarme? Claro. ¿Y eso cómo te compra mágicamente la libertad?"

# game/episodes/Ep8_2/episode8_2.rpy:5943
translate HZIlle ep8_2_fv_19a02689:

#   mc "What did you find?"
    mc "¿Qué has encontrado?"

# game/episodes/Ep8_2/episode8_2.rpy:5945
translate HZIlle ep8_2_fv_0b675970:

#   n "Some tiny device. Letters glowing. ‘Low’? ‘R-low’? Something like that."
    n "Algún dispositivo diminuto. Letras brillantes. ¿'Bajo'? ¿'R-bajo'? Algo así."

# game/episodes/Ep8_2/episode8_2.rpy:5947
translate HZIlle ep8_2_fv_4eb693ed:

#   mc "R-low… Harlow?"
    mc "R-bajo... ¿Harlow?"

# game/episodes/Ep8_2/episode8_2.rpy:5949
translate HZIlle ep8_2_fv_ce878889:

#   n "Maybe?"
    n "¿Tal vez?"

# game/episodes/Ep8_2/episode8_2.rpy:5951
translate HZIlle ep8_2_fv_3a856119:

#   mc "My full name is [mc] Harlow."
    mc "Mi nombre completo es [mc] Harlow."

# game/episodes/Ep8_2/episode8_2.rpy:5953
translate HZIlle ep8_2_fv_23feeabb:

#   n "How the fuck was I supposed to know that?!"
    n "¿Cómo coño iba a saberlo?"

# game/episodes/Ep8_2/episode8_2.rpy:5954
translate HZIlle ep8_2_fv_e9999d03:

#   mc "You worked with my father. You didn’t know his last name?"
    mc "Trabajaste con mi padre. ¿No sabías su apellido?"

# game/episodes/Ep8_2/episode8_2.rpy:5956
translate HZIlle ep8_2_fv_a151df7d:

#   n "He was just agent [fa] to me!"
    n "¡Para mí sólo era el agente [fa]!"

# game/episodes/Ep8_2/episode8_2.rpy:5957
translate HZIlle ep8_2_fv_db0ab2c5:

#   n "In that case, you’re here because of me. So maybe shut up and thank me."
    n "En ese caso, estás aquí gracias a mí, así que cállate y dame las gracias."

# game/episodes/Ep8_2/episode8_2.rpy:5959
translate HZIlle ep8_2_fv_beb71647:

#   mc "What else do they want from you before you're ‘free’?"
    mc "¿Qué más quieren de ti para que seas \"libre\"?"

# game/episodes/Ep8_2/episode8_2.rpy:5961
translate HZIlle ep8_2_fv_95476cb3:

#   n "Finish this mission. Wipe their security. Then I’m out. Free. Done."
    n "Termina esta misión. Borra su seguridad. Luego me largo. Gratis. Hecho."

# game/episodes/Ep8_2/episode8_2.rpy:5962
translate HZIlle ep8_2_fv_591e3fe0:

#   n "Happy now?"
    n "¿Ya estás contento?"

# game/episodes/Ep8_2/episode8_2.rpy:5964
translate HZIlle ep8_2_fv_4dcc4278:

#   mc "You can’t honestly believe that. They’re not letting you go. [msd] is stringing you along. They’ll kill you the second you’re no longer useful."
    mc "No puedes creerlo sinceramente. No te van a dejar marchar. [msd] te están tomando el pelo. Te matarán en cuanto dejes de ser útil."

# game/episodes/Ep8_2/episode8_2.rpy:5965
translate HZIlle ep8_2_fv_b0801fd3:

#   n "I’m not listening to this."
    n "No voy a escuchar esto."

# game/episodes/Ep8_2/episode8_2.rpy:5967
translate HZIlle ep8_2_fv_cc061279:

#   mc "Don’t be stupid. Please."
    mc "No seas estúpida, por favor."

# game/episodes/Ep8_2/episode8_2.rpy:5968
translate HZIlle ep8_2_fv_26f8deb7:

#   n "You fell in love? Cute. I didn’t. I don’t. I can’t."
    n "¿Te enamoraste? Bonito. No lo hice. No lo hago. No puedo."

# game/episodes/Ep8_2/episode8_2.rpy:5970
translate HZIlle ep8_2_fv_53ee27cc:

#   n "You know why? Because there’s nothing in here."
    n "¿Sabes por qué? Porque aquí no hay nada."

# game/episodes/Ep8_2/episode8_2.rpy:5972
translate HZIlle ep8_2_fv_82f9da5d:

#   n "Empty. Broken. Useless. I kill, I complete missions, I move on."
    n "Vacío, roto, inútil. Mato, cumplo misiones, sigo adelante."

# game/episodes/Ep8_2/episode8_2.rpy:5973
translate HZIlle ep8_2_fv_f6dad73d:

#   n "If I have a one percent chance at a normal life, I’m taking it. With or without you."
    n "Si tengo un uno por ciento de posibilidades de tener una vida normal, las aprovecho. Con o sin ti."

# game/episodes/Ep8_2/episode8_2.rpy:5979
translate HZIlle ep8_2_fv_e6fa8b1c:

#   mc "Let me help you."
    mc "Deja que te ayude."

# game/episodes/Ep8_2/episode8_2.rpy:5981
translate HZIlle ep8_2_fv_33a1ccf1:

#   n "And what makes you think you have that kind of pull?"
    n "¿Y qué te hace pensar que tienes tanto tirón?"

# game/episodes/Ep8_2/episode8_2.rpy:5983
translate HZIlle ep8_2_fv_a1cb06a6:

#   mc "If that device said ‘Harlow,’ then there’s shit here only I can do."
    mc "Si ese aparato decía \"Harlow\", aquí hay mierda que sólo yo puedo hacer."

# game/episodes/Ep8_2/episode8_2.rpy:5984
translate HZIlle ep8_2_fv_f95bc638:

#   mc "That gives me leverage. I’ll use it... for you."
    mc "Eso me da ventaja. La usaré... para ti."

# game/episodes/Ep8_2/episode8_2.rpy:5986
translate HZIlle ep8_2_fv_eabec665:

#   n "…"
    n "..."

# game/episodes/Ep8_2/episode8_2.rpy:5988
translate HZIlle ep8_2_fv_1f7bbd8c:

#   n "Shut up. Lady in Black is coming."
    n "Cállate, viene la Dama de Negro."

# game/episodes/Ep8_2/episode8_2.rpy:5992
translate HZIlle ep8_2_fv_5a02cf24:

#   n "Enough. Shut up. She’s coming."
    n "Basta, cállate, que ya viene."

# game/episodes/Ep8_2/episode8_2.rpy:5998
translate HZIlle ep8_2_fv_8ca37586:

#   fv "I didn’t expect to see you strolling around this soon."
    fv "No esperaba verte pasear tan pronto."

# game/episodes/Ep8_2/episode8_2.rpy:6000
translate HZIlle ep8_2_fv_728dd66e:

#   mc "You damn near broke my jaw, and I almost ended up in a cell... or a coffin."
    mc "Casi me rompes la mandíbula y casi acabo en una celda... o en un ataúd."

# game/episodes/Ep8_2/episode8_2.rpy:6002
translate HZIlle ep8_2_fv_6ed88c92:

#   fv "Almost. Stop being dramatic."
    fv "Casi. Deja de ponerte dramático."

# game/episodes/Ep8_2/episode8_2.rpy:6003
translate HZIlle ep8_2_fv_3a5f3618:

#   fv "I warned you there’d be payback. You agreed. Cry to someone else."
    fv "Te advertí de que habría venganza. Aceptaste. Llora a otro."

# game/episodes/Ep8_2/episode8_2.rpy:6005
translate HZIlle ep8_2_fv_01a8d84e:

#   mc "Yeah, well, I paid. I got stabbed by—"
    mc "Sí, bueno, pagué. Me apuñalaron..."

# game/episodes/Ep8_2/episode8_2.rpy:6006
translate HZIlle ep8_2_fv_f9a21392:

#   n "Ahem."
    n "Ejem."

# game/episodes/Ep8_2/episode8_2.rpy:6008
translate HZIlle ep8_2_fv_cbee0006:

#   fv "You were in no real danger. Believe it or don’t."
    fv "No corrías ningún peligro real, lo creas o no."

# game/episodes/Ep8_2/episode8_2.rpy:6009
translate HZIlle ep8_2_fv_55989201:

#   mc "And you magically know that how?"
    mc "¿Y cómo lo sabes mágicamente?"

# game/episodes/Ep8_2/episode8_2.rpy:6011
translate HZIlle ep8_2_fv_ff36f591:

#   fv "Not your concern. And if you’re here to bitch, I’m already bored."
    fv "No es asunto tuyo. Y si estás aquí para quejarte, ya me aburro."

# game/episodes/Ep8_2/episode8_2.rpy:6013
translate HZIlle ep8_2_fv_98829e28:

#   mc "You're working for [law]. I bet that’s exactly where you're heading right now."
    mc "Trabajas para [law]. Apuesto a que es exactamente hacia donde te diriges ahora mismo."

# game/episodes/Ep8_2/episode8_2.rpy:6014
translate HZIlle ep8_2_fv_c86f5672:

#   fv "…What did you just say?"
    fv "...¿Qué acabas de decir?"

# game/episodes/Ep8_2/episode8_2.rpy:6016
translate HZIlle ep8_2_fv_f042aaf0:

#   mc "I said you're Lawson’s little pet. Big talk, big power, and still on your knees for him."
    mc "He dicho que eres la pequeña mascota de Lawson. Gran palabrería, gran poder y aún de rodillas ante él."

# game/episodes/Ep8_2/episode8_2.rpy:6017
translate HZIlle ep8_2_fv_52bda7f6:

#   fv "What do you want?"
    fv "¿Qué quieres?"

# game/episodes/Ep8_2/episode8_2.rpy:6019
translate HZIlle ep8_2_fv_4cf73af4:

#   mc "Help me take him down."
    mc "Ayúdame a acabar con él."

# game/episodes/Ep8_2/episode8_2.rpy:6021
translate HZIlle ep8_2_fv_687343bc:

#   fv "Not going to happen."
    fv "No va a ocurrir."

# game/episodes/Ep8_2/episode8_2.rpy:6023
translate HZIlle ep8_2_fv_5ba55339:

#   mc "He threw me in an interrogation room, rambled like he’d lost his mind, and then shoved a fucking needle into my neck!"
    mc "Me metió en una sala de interrogatorios, divagó como si hubiera perdido la cabeza, ¡y luego me clavó una puta aguja en el cuello!"

# game/episodes/Ep8_2/episode8_2.rpy:6025
translate HZIlle ep8_2_fv_7f71dbc4:

#   mc "Ah... fuck!"
    mc "Ah... ¡joder!"

# game/episodes/Ep8_2/episode8_2.rpy:6026
translate HZIlle ep8_2_fv_45ed2cd6:

#   fv "Are you hurt?"
    fv "¿Estás herido?"

# game/episodes/Ep8_2/episode8_2.rpy:6028
translate HZIlle ep8_2_fv_9ca7a579:

#   mc "You tell me. I’ve got until midnight before this shit kills me."
    mc "Dímelo tú. Tengo hasta medianoche antes de que esta mierda me mate."

# game/episodes/Ep8_2/episode8_2.rpy:6030
translate HZIlle ep8_2_fv_8af5dd36:

#   fv "Show me."
    fv "Enséñamelo."

# game/episodes/Ep8_2/episode8_2.rpy:6032
translate HZIlle ep8_2_fv_c882ba11:

#   mc "There’s nothing to look at. It’s invisible. And patched over. I know how insane this sounds."
    mc "No hay nada que mirar, es invisible y está remendado. Sé lo descabellado que suena esto."

# game/episodes/Ep8_2/episode8_2.rpy:6033
translate HZIlle ep8_2_fv_0d4b08bf:

#   fv "Stop talking. Show me."
    fv "Deja de hablar, enséñamelo."

