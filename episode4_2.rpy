translate HZIlle ep4_wh_comeback_d2ec48ca:

#   v "Let me know if this happens again, ok?"
    v "Avísame si vuelve a ocurrir, ¿vale?"

# game/episodes/Ep4_2/episode4_2.rpy:4102
translate HZIlle ep4_wh_comeback_0cf71cc6:

#   mc "Will do!"
    mc "¡Lo haré!"

# game/episodes/Ep4_2/episode4_2.rpy:4108
translate HZIlle ep4_wh_comeback_menu_651f8431:

#   mc "Anything upbeat aside from our failed Relaxation Phase?"
    mc "¿Algo optimista aparte de nuestra fallida Fase de Relajación?"

# game/episodes/Ep4_2/episode4_2.rpy:4110
translate HZIlle ep4_wh_comeback_menu_61dc27de:

#   v "Yes. Big news."
    v "Sí, una gran noticia."

# game/episodes/Ep4_2/episode4_2.rpy:4111
translate HZIlle ep4_wh_comeback_menu_1d26dfef:

#   v "We're eyeing two suspects for the [z] affair case. It's either [gb] or [mi]."
    v "Estamos barajando dos sospechosos para el caso del asunto [z] . O es [gb] o es [mi]."

# game/episodes/Ep4_2/episode4_2.rpy:4113
translate HZIlle ep4_wh_comeback_menu_a5155750:

#   v "I've been doing a bit of snooping, but it's just surface-level stuff. I need direct access. Just 10-15 minutes to download all the data."
    v "He estado husmeando un poco, pero sólo es material superficial. Necesito acceso directo. Sólo 10-15 minutos para descargar todos los datos."

# game/episodes/Ep4_2/episode4_2.rpy:4115
translate HZIlle ep4_wh_comeback_menu_bfe585a7:

#   mc "Kinda like what we did at the [hns] party?"
    mc "¿Algo parecido a lo que hicimos en la fiesta [hns]?"

# game/episodes/Ep4_2/episode4_2.rpy:4116
translate HZIlle ep4_wh_comeback_menu_6ee60a72:

#   v "Exactly like that."
    v "Exactamente así."

# game/episodes/Ep4_2/episode4_2.rpy:4118
translate HZIlle ep4_wh_comeback_menu_546cf5fa:

#   mc "And what's our status report?"
    mc "¿Y cuál es nuestro informe de situación?"

# game/episodes/Ep4_2/episode4_2.rpy:4120
translate HZIlle ep4_wh_comeback_menu_53433cb6:

#   v "Bits and pieces. But it's not enough to point fingers yet. Need to go deeper."
    v "Pero aún no es suficiente para señalar con el dedo. Hay que profundizar más."

