translate HZIlle ep4_wh_comeback_a565684a:

#   v "How have you been, [mc]?"
    v "¿Cómo has estado, [mc]?"

# game/episodes/Ep4_2/episode4_2.rpy:4071
translate HZIlle ep4_wh_comeback_c0114e49:

#   mc "All good here. Why?"
    mc "Todo bien aquí. ¿Por qué?"

# game/episodes/Ep4_2/episode4_2.rpy:4073
translate HZIlle ep4_wh_comeback_90e0743e:

#   v "Just making sure."
    v "Sólo para asegurarme."

# game/episodes/Ep4_2/episode4_2.rpy:4074
translate HZIlle ep4_wh_comeback_6eed5fc8:

#   v "Did you enter Relaxation Phase last night?"
    v "¿Anoche entraste en Fase de Relajación?"

# game/episodes/Ep4_2/episode4_2.rpy:4076
translate HZIlle ep4_wh_comeback_95b537b4:

#   mc "I had some crazy dreams about my childhood. Hmmm..."
    mc "Tuve unos sueños locos sobre mi infancia. Hmmm..."

