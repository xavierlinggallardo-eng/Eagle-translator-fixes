#   fa "Yes."
    fa "Sí."

# game/episodes/Ep4_2/episode4_2.rpy:3996
translate HZIlle ep4_dream_686e090a:

#   mo "Then undo it! No shame in backtracking."
    mo "No hay que avergonzarse de dar marcha atrás."

# game/episodes/Ep4_2/episode4_2.rpy:3998
translate HZIlle ep4_dream_b3243f67:

#   fa "It's a binding contract. There's no turning back now. If I break it, we'd be fugitives."
    fa "Es un contrato vinculante. Ya no hay vuelta atrás. Si lo rompo, seríamos fugitivos."

# game/episodes/Ep4_2/episode4_2.rpy:3999
translate HZIlle ep4_dream_3808ee9d:

#   fa "I need you on my side, love. It's the only way to keep us safe!"
    fa "Te necesito a mi lado, amor. ¡Es la única forma de mantenernos a salvo!"

# game/episodes/Ep4_2/episode4_2.rpy:4001
translate HZIlle ep4_dream_75be0a12:

#   fa "This way, [mc] won't have to endure what we did!"
    fa "¡Así, [mc] no tendrá que pasar lo que pasamos nosotros!"

# game/episodes/Ep4_2/episode4_2.rpy:4002
translate HZIlle ep4_dream_5de8f458:

#   fa "You must see the bigger picture!"
    fa "¡Debes ver el panorama general!"

# game/episodes/Ep4_2/episode4_2.rpy:4004
translate HZIlle ep4_dream_2085a0f9:

#   mo "Get out, [fa]. Now!"
    mo "Fuera, [fa] ¡Ahora!"

# game/episodes/Ep4_2/episode4_2.rpy:4005
translate HZIlle ep4_dream_3d60ef4d:

#   fa "Darling... Please. Try to understand... I need you for this!"
    fa "Cariño... Por favor. Intenta comprender... ¡Te necesito para esto!"

# game/episodes/Ep4_2/episode4_2.rpy:4007
translate HZIlle ep4_dream_4907dcac:

#   mo "I can't even bear to look at you anymore!"
    mo "¡Ya ni siquiera soporto mirarte!"

# game/episodes/Ep4_2/episode4_2.rpy:4010
translate HZIlle ep4_dream_f4781194:

#   mc "Dad, is this because of our treasure hunts?"
    mc "Papá, ¿esto se debe a nuestras búsquedas del tesoro?"

# game/episodes/Ep4_2/episode4_2.rpy:4012
translate HZIlle ep4_dream_cc86ede0:

#   fa "Hmm?"
    fa "¿Eh?"

# game/episodes/Ep4_2/episode4_2.rpy:4013
translate HZIlle ep4_dream_27735105:

#   fa "Oh, no, not at all, kiddo. Our adventures are just fine."
    fa "No, en absoluto, chiquilla. Nuestras aventuras están muy bien."

# game/episodes/Ep4_2/episode4_2.rpy:4015
translate HZIlle ep4_dream_002da555:

#   fa "So, how's our map looking? Making any progress?"
    fa "¿Cómo va nuestro mapa? ¿Haciendo algún progreso?"

# game/episodes/Ep4_2/episode4_2.rpy:4016
translate HZIlle ep4_dream_a15780bf:

#   mc "I don't know what this means. I... I just don't."
    mc "No sé lo que esto significa. Yo... simplemente no lo sé."

# game/episodes/Ep4_2/episode4_2.rpy:4018
translate HZIlle ep4_dream_212efa6d:

#   mc "I wanted to ask Mom, but I'm kinda scared."
    mc "Quería preguntarle a mamá, pero tengo un poco de miedo."

# game/episodes/Ep4_2/episode4_2.rpy:4019
translate HZIlle ep4_dream_32f8fa2c:

#   fa "Hey, you've got this. Take a closer look at the map. You're a smart kid, you'll figure it out."
    fa "Mira bien el mapa. Eres un chico listo, ya lo descubrirás."

# game/episodes/Ep4_2/episode4_2.rpy:4021
translate HZIlle ep4_dream_7505059a:

#   mc "But what if I get it wrong?"
    mc "Pero, ¿y si me equivoco?"

# game/episodes/Ep4_2/episode4_2.rpy:4022
translate HZIlle ep4_dream_b1427c36:

#   fa "So what?"
    fa "¿Y qué?"

# game/episodes/Ep4_2/episode4_2.rpy:4024
translate HZIlle ep4_dream_b42d928f:

#   fa "We'll have a little detour, find nothing, and then try again."
    fa "Daremos un pequeño rodeo, no encontraremos nada y volveremos a intentarlo."

# game/episodes/Ep4_2/episode4_2.rpy:4028
translate HZIlle ep4_dream_61756b2e:

#   fa "Don't worry about messing up. Mistakes help us learn and grow."
    fa "No te preocupes por meter la pata. Los errores nos ayudan a aprender y a crecer."

# game/episodes/Ep4_2/episode4_2.rpy:4034
translate HZIlle ep4_wh_comeback_c79bc193:

#   mct "Home sweet home."
    mct "Hogar, dulce hogar."

# game/episodes/Ep4_2/episode4_2.rpy:4039
translate HZIlle ep4_wh_comeback_5e1c76c7:

#   n "Leaving me in the dark again! No message?! Where were you?"
    n "¡Dejándome a oscuras otra vez! ¡¿Sin mensaje?! ¿Dónde estabas?"

# game/episodes/Ep4_2/episode4_2.rpy:4040
translate HZIlle ep4_wh_comeback_c3309546:

#   mc "Oh, come on! We talked at the Glass! Do I need to give you a daily report?"
    mc "¡Vamos! ¡Hablamos en el Vaso! ¿Tengo que darte un informe diario?"

# game/episodes/Ep4_2/episode4_2.rpy:4042
translate HZIlle ep4_wh_comeback_e588e987:

#   n "I'm the boss here. You report to me, lil bro."
    n "Yo soy el jefe aquí. Tú me informas a mí, hermanito."

# game/episodes/Ep4_2/episode4_2.rpy:4043
translate HZIlle ep4_wh_comeback_173041bf:

#   mc "I'm not telling."
    mc "No te lo voy a decir."

# game/episodes/Ep4_2/episode4_2.rpy:4045
translate HZIlle ep4_wh_comeback_76964cb4:

#   n "I wasn't asking."
    n "No te lo estaba preguntando."

# game/episodes/Ep4_2/episode4_2.rpy:4046
translate HZIlle ep4_wh_comeback_2d921c13:

#   mc "Feeling bored again?"
    mc "¿Te vuelves a aburrir?"

# game/episodes/Ep4_2/episode4_2.rpy:4048
translate HZIlle ep4_wh_comeback_694ac062:

#   n "Yup."
    n "Sí."

# game/episodes/Ep4_2/episode4_2.rpy:4049
translate HZIlle ep4_wh_comeback_d6ce1dac:

#   n "Lighten up my day a bit, will you, lil bro?"
    n "Alégrame un poco el día, ¿quieres, hermanito?"

# game/episodes/Ep4_2/episode4_2.rpy:4052
translate HZIlle ep4_wh_comeback_9d674c17:

#   mc "I ended up in a threesome."
    mc "Acabé en un trío."

# game/episodes/Ep4_2/episode4_2.rpy:4054
translate HZIlle ep4_wh_comeback_5ad886b0:

#   n "You did WHAT?!"
    n "¡¿Hiciste QUÉ?!"

# game/episodes/Ep4_2/episode4_2.rpy:4056
translate HZIlle ep4_wh_comeback_296c0304:

#   mc "A threesome, with [sa] and [j]."
    mc "Un trío, con [sa] y [j]."

# game/episodes/Ep4_2/episode4_2.rpy:4058
translate HZIlle ep4_wh_comeback_91366f40:

#   n "Holy shit!"
    n "¡Mierda!"

# game/episodes/Ep4_2/episode4_2.rpy:4059
translate HZIlle ep4_wh_comeback_8dc553b0:

#   n "Well, I guess I can let you off the hook."
    n "Bueno, supongo que puedo dejarte libre."

# game/episodes/Ep4_2/episode4_2.rpy:4062
translate HZIlle ep4_wh_comeback_1ea24ed0:

#   mc "Just kept watch over [j] with [sa], then crashed. Nothing wild."
    mc "Sólo vigilaba a [j] con [sa], luego se estrelló. Nada descabellado."

# game/episodes/Ep4_2/episode4_2.rpy:4064
translate HZIlle ep4_wh_comeback_00ac86f8:

#   n "Boooooooooring!"
    n "¡Boooooooooring!"

# game/episodes/Ep4_2/episode4_2.rpy:4066
translate HZIlle ep4_wh_comeback_4f65e3f8:

#   mc "Still, thanks for the concern, big sis."
    mc "Aun así, gracias por preocuparte, hermana mayor."

# game/episodes/Ep4_2/episode4_2.rpy:4067
translate HZIlle ep4_wh_comeback_efb7e40b:

#   mc "Hey there, [v]! Good to see you."
    mc "Hola, [v]Me alegro de verte."

