translate HZIlle ep4_mansion_talk_em_785e63df:

#   mc "The [z] family should be made aware!"
    mc "¡La familia [z] debería estar al corriente!"

# game/episodes/Ep4_2/episode4_2.rpy:5038
translate HZIlle ep4_mansion_talk_em_94a33b74:

#   mc "It was you yesterday, it may be [k] today..."
    mc "Fuiste tú ayer, puede que seas [k] hoy..."

# game/episodes/Ep4_2/episode4_2.rpy:5039
translate HZIlle ep4_mansion_talk_em_345ee341:

#   mc "Either you tell them, or I will."
    mc "O se lo dices tú o se lo digo yo."

# game/episodes/Ep4_2/episode4_2.rpy:5041
translate HZIlle ep4_mansion_talk_em_01ae0cb3:

#   em "Ok... Ok. I'll do it, eventually."
    em "Vale... Vale. Al final lo haré."

# game/episodes/Ep4_2/episode4_2.rpy:5042
translate HZIlle ep4_mansion_talk_em_4c098e04:

#   mc "No, you'll do it today. After [pol1], go straight to [z] and explain everything."
    mc "No, lo harás hoy. Después de [pol1], ve directamente a [z] y explícalo todo."

# game/episodes/Ep4_2/episode4_2.rpy:5044
translate HZIlle ep4_mansion_talk_em_e48a2ac9:

#   em "I will..."
    em "Yo..."

# game/episodes/Ep4_2/episode4_2.rpy:5045
translate HZIlle ep4_mansion_talk_em_f3f56fd4:

#   mc "Promise me."
    mc "Prométemelo."

# game/episodes/Ep4_2/episode4_2.rpy:5047
translate HZIlle ep4_mansion_talk_em_68e142ea:

#   em "Yes, I promise!"
    em "Sí, te lo prometo."

# game/episodes/Ep4_2/episode4_2.rpy:5049
translate HZIlle ep4_mansion_talk_em_7b471f6f:

#   mc "Good."
    mc "Bien."

# game/episodes/Ep4_2/episode4_2.rpy:5050
translate HZIlle ep4_mansion_talk_em_829d32d5:

#   mc "And about your medical treatment..."
    mc "Y sobre tu tratamiento médico..."

# game/episodes/Ep4_2/episode4_2.rpy:5052
translate HZIlle ep4_mansion_talk_em_b5d25cf5:

#   em "I don't want any help!"
    em "¡No quiero ayuda!"

# game/episodes/Ep4_2/episode4_2.rpy:5053
translate HZIlle ep4_mansion_talk_em_1ea8121d:

#   mc "Just listen. [mi] is at the mansion. She can check on you."
    mc "Escucha. [mi] Está en la mansión. Puede ver cómo estás."

# game/episodes/Ep4_2/episode4_2.rpy:5055
translate HZIlle ep4_mansion_talk_em_c6ce96b1:

#   em "I..."
    em "I..."

# game/episodes/Ep4_2/episode4_2.rpy:5056
translate HZIlle ep4_mansion_talk_em_18b26f0c:

#   mc "No buts. You're going to do as I say, okay?"
    mc "Sin peros. Vas a hacer lo que yo te diga, ¿vale?"

# game/episodes/Ep4_2/episode4_2.rpy:5058
translate HZIlle ep4_mansion_talk_em_cc77529c:

#   em "Yes."
    em "Sí."

# game/episodes/Ep4_2/episode4_2.rpy:5059
translate HZIlle ep4_mansion_talk_em_9930ed4b:

#   mc "Great."
    mc "Estupendo."

# game/episodes/Ep4_2/episode4_2.rpy:5061
translate HZIlle ep4_mansion_talk_em_af9e0a50:

#   em "..."
    em "..."

# game/episodes/Ep4_2/episode4_2.rpy:5063
translate HZIlle ep4_mansion_talk_em_f9157ee6:

#   mc "Shit. Are you sure you're okay? Did they hurt you?"
    mc "Mierda. ¿Seguro que estás bien? ¿Te han hecho daño?"

# game/episodes/Ep4_2/episode4_2.rpy:5064
translate HZIlle ep4_mansion_talk_em_89692486:

#   em "I'm alright... A few scratches, but that's it."
    em "Estoy bien... Unos rasguños, pero nada más."

# game/episodes/Ep4_2/episode4_2.rpy:5066
translate HZIlle ep4_mansion_talk_em_892b99b1:

#   em "Why me?! Everything was finally going right, thanks to you, and then this happens."
    em "¿Por qué yo? Por fin todo iba bien, gracias a ti, y entonces ocurre esto."

# game/episodes/Ep4_2/episode4_2.rpy:5067
translate HZIlle ep4_mansion_talk_em_40d20bd9:

#   em "I'm so fucking exhausted..."
    em "Estoy tan jodidamente agotada..."

# game/episodes/Ep4_2/episode4_2.rpy:5069
translate HZIlle ep4_mansion_talk_em_5007d9b1:

#   mc "Let me ask you a few questions if you don't mind. How many people were involved?"
    mc "Permíteme hacerte unas preguntas, si no te importa. ¿Cuántas personas participaron?"

# game/episodes/Ep4_2/episode4_2.rpy:5071
translate HZIlle ep4_mansion_talk_em_4f66f543:

#   em "Only one, but he had a gun. I gave him everything right away, and he still hit me."
    em "Sólo uno, pero tenía una pistola. Se lo di todo enseguida, y aun así me pegó."

# game/episodes/Ep4_2/episode4_2.rpy:5072
translate HZIlle ep4_mansion_talk_em_2111d727:

#   mc "Can you describe him?"
    mc "¿Puedes describirlo?"

# game/episodes/Ep4_2/episode4_2.rpy:5074
translate HZIlle ep4_mansion_talk_em_3d16bc45:

#   em "He was in a hoodie and a mask, and he used something to change his voice."
    em "Llevaba una sudadera con capucha y una máscara, y utilizó algo para cambiar su voz."

# game/episodes/Ep4_2/episode4_2.rpy:5075
translate HZIlle ep4_mansion_talk_em_00aa0793:

#   mc "Was he skilled at what he did?"
    mc "¿Era hábil en lo que hacía?"

# game/episodes/Ep4_2/episode4_2.rpy:5077
translate HZIlle ep4_mansion_talk_em_01f93fb8:

#   em "I mean, he got what he wanted, so I suppose he was."
    em "Es decir, consiguió lo que quería, así que supongo que sí."

# game/episodes/Ep4_2/episode4_2.rpy:5078
translate HZIlle ep4_mansion_talk_em_bbcc636b:

#   mc "Height?"
    mc "¿Altura?"

# game/episodes/Ep4_2/episode4_2.rpy:5080
translate HZIlle ep4_mansion_talk_em_4c149d30:

#   em "Shorter than me."
    em "Más bajo que yo."

# game/episodes/Ep4_2/episode4_2.rpy:5082
translate HZIlle ep4_mansion_talk_em_21d2ab63:

#   mc "Hmmm. Interesting."
    mc "Hmmm. Interesante."

# game/episodes/Ep4_2/episode4_2.rpy:5083
translate HZIlle ep4_mansion_talk_em_64386f4c:

#   mc "And where did this happen?"
    mc "¿Y dónde ocurrió esto?"

# game/episodes/Ep4_2/episode4_2.rpy:5085
translate HZIlle ep4_mansion_talk_em_54e07a7d:

#   em "Downtown. Right by that new office building, near the cool toy store. You know the place?"
    em "En el centro. Justo al lado de ese nuevo edificio de oficinas, cerca de la juguetería guay. ¿Conoces el sitio?"

# game/episodes/Ep4_2/episode4_2.rpy:5086
translate HZIlle ep4_mansion_talk_em_5882a379:

#   mc "Can't say I do."
    mc "No puedo decir que sí."

# game/episodes/Ep4_2/episode4_2.rpy:5088
translate HZIlle ep4_mansion_talk_em_23c9042a:

#   em "Umm... Next to the weird cafe... Self Pleasure Cafe?"
    em "Umm... Al lado del café raro... ¿Café Self Pleasure?"

# game/episodes/Ep4_2/episode4_2.rpy:5090
translate HZIlle ep4_mansion_talk_em_bb27c463:

#   mc "Soft Satisfaction Cafe. [gb]'s place. I know that area."
    mc "Café Soft Satisfaction. [gb] Conozco esa zona."

# game/episodes/Ep4_2/episode4_2.rpy:5091
translate HZIlle ep4_mansion_talk_em_ad7a9e5a:

#   mc "I'll do what I can to help."
    mc "Haré lo que pueda para ayudar."

# game/episodes/Ep4_2/episode4_2.rpy:5093
translate HZIlle ep4_mansion_talk_em_bd0d4a0c:

#   em "What's your plan?"
    em "¿Cuál es tu plan?"

# game/episodes/Ep4_2/episode4_2.rpy:5095
translate HZIlle ep4_mansion_talk_em_3f9023e2:

#   mc "Track him down and... politely educate him on proper manners."
    mc "Localízalo y... edúcale educadamente sobre los modales adecuados."

# game/episodes/Ep4_2/episode4_2.rpy:5096
translate HZIlle ep4_mansion_talk_em_467301eb:

#   mc "More importantly, how are you going to survive without money?"
    mc "Y lo que es más importante, ¿cómo vas a sobrevivir sin dinero?"

# game/episodes/Ep4_2/episode4_2.rpy:5098
translate HZIlle ep4_mansion_talk_em_e69d977d:

#   em "Don't worry about it. I've been asking myself the same question for years, and I'm still here."
    em "No te preocupes. Llevo años haciéndome la misma pregunta y sigo aquí."

# game/episodes/Ep4_2/episode4_2.rpy:5099
translate HZIlle ep4_mansion_talk_em_de1eb316:

#   em "I'll survive."
    em "Sobreviviré."

# game/episodes/Ep4_2/episode4_2.rpy:5101
translate HZIlle ep4_mansion_talk_em_5078b27d:

#   em "And you've already done so much for me."
    em "Y ya has hecho mucho por mí."

# game/episodes/Ep4_2/episode4_2.rpy:5102
translate HZIlle ep4_mansion_talk_em_e5119ee9:

#   mc "I just think that..."
    mc "Sólo creo que..."

# game/episodes/Ep4_2/episode4_2.rpy:5104
translate HZIlle ep4_mansion_talk_em_bf789028:

#   em "No more arguments. It's my turn to insist."
    em "Se acabaron las discusiones, me toca insistir."

# game/episodes/Ep4_2/episode4_2.rpy:5105
translate HZIlle ep4_mansion_talk_em_79966f69:

#   mc "... Ok, then."
    mc "... De acuerdo, entonces."

# game/episodes/Ep4_2/episode4_2.rpy:5110
translate HZIlle ep4_mansion_talk_em_be4437d7:

#   em "Thank you."
    em "Gracias."

# game/episodes/Ep4_2/episode4_2.rpy:5117
translate HZIlle ep4_mansion_talk_after_23f5437b:

#   k "Mom! [mc]! Where are we going?!"
    k "¡Mamá! [mc]¿Adónde vamos?"

# game/episodes/Ep4_2/episode4_2.rpy:5118
translate HZIlle ep4_mansion_talk_after_1ce23179:

#   lil "[mc] is in the dark too. I've got a surprise for you."
    lil "[mc] también está en la oscuridad. Tengo una sorpresa para ti."

# game/episodes/Ep4_2/episode4_2.rpy:5120
translate HZIlle ep4_mansion_talk_after_a2f2edde:

#   lil "And it's going to be a fantastic one!"
    lil "¡Y va a ser fantástico!"

# game/episodes/Ep4_2/episode4_2.rpy:5121
translate HZIlle ep4_mansion_talk_after_7d86a204:

#   k "Hihi! The suspense is killing me!"
    k "¡Hihi! ¡El suspense me está matando!"

# game/episodes/Ep4_2/episode4_2.rpy:5123
translate HZIlle ep4_mansion_talk_after_b77399c1:

#   k "Any hints?"
    k "¿Alguna pista?"

# game/episodes/Ep4_2/episode4_2.rpy:5124
translate HZIlle ep4_mansion_talk_after_23ec2b25:

#   k "[mc], help me out!"
    k "[mc], ¡ayúdame!"

# game/episodes/Ep4_2/episode4_2.rpy:5125
translate HZIlle ep4_mansion_talk_after_c86ef280:

#   mc "Hmmm... Let's brainstorm together."
    mc "Hmmm... Hagamos una lluvia de ideas juntos."

# game/episodes/Ep4_2/episode4_2.rpy:5127
translate HZIlle ep4_mansion_talk_after_6a00ea49:

#   k "YES!"
    k "¡SÍ!"

# game/episodes/Ep4_2/episode4_2.rpy:5128
translate HZIlle ep4_mansion_talk_after_709e43ba:

#   mc "I'm thinking [mlil] might just hand over her whole empire to you, [k]."
    mc "Estoy pensando que [mlil] podría entregarte todo su imperio, [k]."

# game/episodes/Ep4_2/episode4_2.rpy:5130
translate HZIlle ep4_mansion_talk_after_53a856e5:

#   k "Hihi!"
    k "¡Hola!"

# game/episodes/Ep4_2/episode4_2.rpy:5131
translate HZIlle ep4_mansion_talk_after_46a26bfc:

#   k "An interesting take, but I don't need all that."
    k "Un punto de vista interesante, pero no necesito todo eso."

# game/episodes/Ep4_2/episode4_2.rpy:5133
translate HZIlle ep4_mansion_talk_after_12a7f64d:

#   lil "Let's stop here, [mc]."
    lil "Detengámonos aquí, [mc]."

# game/episodes/Ep4_2/episode4_2.rpy:5134
translate HZIlle ep4_mansion_talk_after_13fc1511:

#   lil "I'm about to unveil the big surprise, darling... in just a second."
    lil "Estoy a punto de desvelar la gran sorpresa, cariño... en un segundo."

# game/episodes/Ep4_2/episode4_2.rpy:5136
translate HZIlle ep4_mansion_talk_after_e4beb0b4:

#   k "You are teasing so much, Mom!"
    k "¡Te estás burlando mucho, mamá!"

# game/episodes/Ep4_2/episode4_2.rpy:5137
translate HZIlle ep4_mansion_talk_after_3aa302f7:

#   mct "Yes, she is..."
    mct "Sí, ella es..."

# game/episodes/Ep4_2/episode4_2.rpy:5139
translate HZIlle ep4_mansion_talk_after_b4b3b58b:

#   k "Hihi! I'm so thrilled, I can hardly keep still!"
    k "¡Hola! ¡Estoy tan emocionada que casi no puedo estarme quieta!"

# game/episodes/Ep4_2/episode4_2.rpy:5142
translate HZIlle ep4_mansion_talk_after_9425a4f1:

#   lil "You can actually see it from here."
    lil "De hecho, puedes verlo desde aquí."

# game/episodes/Ep4_2/episode4_2.rpy:5143
translate HZIlle ep4_mansion_talk_after_f3ea6847:

#   mc "Hmm, so it's not the Cafe nor the bank."
    mc "Hmm, así que no es el Café ni el banco."

# game/episodes/Ep4_2/episode4_2.rpy:5145
translate HZIlle ep4_mansion_talk_after_58ea51dd:

#   lil "Look a bit to the right."
    lil "Mira un poco a la derecha."

# game/episodes/Ep4_2/episode4_2.rpy:5147
translate HZIlle ep4_mansion_talk_after_decc6f3c:

#   lil "That's the way."
    lil "Así se hace."

# game/episodes/Ep4_2/episode4_2.rpy:5149
translate HZIlle ep4_mansion_talk_after_ca4ed524:

#   k "Ohhhh!"
    k "¡Ohhhh!"

# game/episodes/Ep4_2/episode4_2.rpy:5150
translate HZIlle ep4_mansion_talk_after_2c78f660:

#   k "I think I've guessed!"
    k "¡Creo que lo he adivinado!"

# game/episodes/Ep4_2/episode4_2.rpy:5152
translate HZIlle ep4_mansion_talk_after_7334414b:

#   lil "What's your guess?"
    lil "¿Qué te parece?"

# game/episodes/Ep4_2/episode4_2.rpy:5154
translate HZIlle ep4_mansion_talk_after_3cada331:

#   k "AN OFFICE! MY VERY OWN OFFICE!"
    k "¡UN DESPACHO! ¡MI PROPIO DESPACHO!"

# game/episodes/Ep4_2/episode4_2.rpy:5155
translate HZIlle ep4_mansion_talk_after_7d0062e0:

#   k "AM I RIGHT OR AM I RIGHT?"
    k "¿TENGO RAZÓN O TENGO RAZÓN?"

# game/episodes/Ep4_2/episode4_2.rpy:5160
translate HZIlle ep4_mansion_talk_after_29d4f509:

#   k "Moooom! I love you so so so much!"
    k "¡Moooom! ¡Te quiero tanto, tanto, tanto!"

# game/episodes/Ep4_2/episode4_2.rpy:5161
translate HZIlle ep4_mansion_talk_after_732291cd:

#   k "It's not just about the gifts... It's you! All you! The best Mom on the planet!"
    k "No se trata sólo de los regalos... ¡Eres tú! ¡Toda tú! ¡La mejor mamá del planeta!"

# game/episodes/Ep4_2/episode4_2.rpy:5163
translate HZIlle ep4_mansion_talk_after_4c0574d7:

#   lil "Everything for you, my dear."
    lil "Todo para ti, querida."

# game/episodes/Ep4_2/episode4_2.rpy:5165
translate HZIlle ep4_mansion_talk_after_576841cd:

#   k "Mom, how many times have we discussed this?"
    k "Mamá, ¿cuántas veces hemos hablado de esto?"

# game/episodes/Ep4_2/episode4_2.rpy:5166
translate HZIlle ep4_mansion_talk_after_3afd6eba:

#   lil "Oh, please! I'm not crying..."
    lil "¡Oh, por favor! No estoy llorando..."

# game/episodes/Ep4_2/episode4_2.rpy:5168
translate HZIlle ep4_mansion_talk_after_4f2c35d2:

#   mct "Seeing [lil] this joyful is rare. Always focused, determined, and intimidating."
    mct "Ver a [lil] tan alegre es raro. Siempre centrado, decidido e intimidante."

# game/episodes/Ep4_2/episode4_2.rpy:5169
translate HZIlle ep4_mansion_talk_after_b0855b94:

#   mct "It's nice seeing her just being human."
    mct "Es agradable verla siendo simplemente humana."

# game/episodes/Ep4_2/episode4_2.rpy:5171
translate HZIlle ep4_mansion_talk_after_24920e0c:

#   mct "I hope I can bring this happiness to her some day."
    mct "Espero poder aportarle esta felicidad algún día."

# game/episodes/Ep4_2/episode4_2.rpy:5173
translate HZIlle ep4_mansion_talk_after_24f4967d:

#   mc "Do you want me to wait here?"
    mc "¿Quieres que espere aquí?"

# game/episodes/Ep4_2/episode4_2.rpy:5174
translate HZIlle ep4_mansion_talk_after_d2f30376:

#   k "No way, you're coming along!"
    k "De ninguna manera, ¡vienes!"

# game/episodes/Ep4_2/episode4_2.rpy:5176
translate HZIlle ep4_mansion_talk_after_29f5fc21:

#   lil "You heard the boss. Let's go together!"
    lil "Ya has oído al jefe. ¡Vamos juntos!"

# game/episodes/Ep4_2/episode4_2.rpy:5177
translate HZIlle ep4_mansion_talk_after_5bedd565:

#   k "Hihi! That's me! I'm the boss!"
    k "¡Hola! ¡Soy yo! ¡Soy el jefe!"

# game/episodes/Ep4_2/episode4_2.rpy:5183
translate HZIlle ep4_out_office_523c6daa:

#   lil "Here we are. Your very own office for the charity organization."
    lil "Aquí estamos. Tu propia oficina para la organización benéfica."

# game/episodes/Ep4_2/episode4_2.rpy:5184
translate HZIlle ep4_out_office_2ce13b0c:

#   lil "We always talked about you stepping in for me in the [z] family business."
    lil "Siempre hablamos de que me sustituirías en el [z] negocio familiar."

# game/episodes/Ep4_2/episode4_2.rpy:5186
translate HZIlle ep4_out_office_707e718d:

#   lil "It's about time we listen to you... After all, you've been telling us for years."
    lil "Ya es hora de que te escuchemos... Al fin y al cabo, llevas años diciéndonoslo."

# game/episodes/Ep4_2/episode4_2.rpy:5187
translate HZIlle ep4_out_office_9a82566f:

#   lil "Now we've finally done it. Better late than never, right?"
    lil "Ahora por fin lo hemos hecho. Más vale tarde que nunca, ¿verdad?"

# game/episodes/Ep4_2/episode4_2.rpy:5189
translate HZIlle ep4_out_office_04b158ab:

#   lil "Do what you love. That's the key to happiness. And that's all that matters."
    lil "Haz lo que te gusta, ésa es la clave de la felicidad, y eso es lo único que importa."

# game/episodes/Ep4_2/episode4_2.rpy:5190
translate HZIlle ep4_out_office_600645dd:

#   lil "If you're happy, I'm happy."
    lil "Si tú eres feliz, yo soy feliz."

# game/episodes/Ep4_2/episode4_2.rpy:5192
translate HZIlle ep4_out_office_08439733:

#   k "M-m-moom..."
    k "M-m-moom..."

# game/episodes/Ep4_2/episode4_2.rpy:5193
translate HZIlle ep4_out_office_bda4f1ce:

#   lil "Are we breaking our 'no crying' rule today?"
    lil "¿Vamos a romper hoy nuestra regla de \"no llorar\"?"

# game/episodes/Ep4_2/episode4_2.rpy:5195
translate HZIlle ep4_out_office_d217e70b:

#   k "J-just for t-today, y-yeah."
    k "S-sólo por s-hoy, s-sí."

# game/episodes/Ep4_2/episode4_2.rpy:5197
translate HZIlle ep4_out_office_e77e7d7c:

#   lil "Are we pulling ourselves together?"
    lil "¿Nos estamos recomponiendo?"

# game/episodes/Ep4_2/episode4_2.rpy:5199
translate HZIlle ep4_out_office_6b8243d6:

#   k "T-two more m-minutes, Mom..."
    k "T-dos m-minutos más, mamá..."

# game/episodes/Ep4_2/episode4_2.rpy:5201
translate HZIlle ep4_out_office_98f0db38:

#   lil "What do you think, sweetie?"
    lil "¿Qué te parece, cariño?"

# game/episodes/Ep4_2/episode4_2.rpy:5202
translate HZIlle ep4_out_office_89ce476f:

#   k "It's so spacious and beautiful... You didn't have to go this much! I could've just worked from my room!"
