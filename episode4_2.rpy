translate HZIlle ep4_wh_comeback_89a540f3:

#   mc "They weren't just dreams. They were real events, replayed exactly as they happened. Every word, every moment."
    mc "No eran sólo sueños. Eran hechos reales, reproducidos exactamente como ocurrieron. Cada palabra, cada momento."

# game/episodes/Ep4_2/episode4_2.rpy:4078
translate HZIlle ep4_wh_comeback_ca80c125:

#   mc "Not a fan of those memories."
    mc "No me gustan esos recuerdos."

# game/episodes/Ep4_2/episode4_2.rpy:4080
translate HZIlle ep4_wh_comeback_f36deac3:

#   v "Has this happened before?"
    v "¿Ha ocurrido esto antes?"

# game/episodes/Ep4_2/episode4_2.rpy:4082
translate HZIlle ep4_wh_comeback_f9187991:

#   mc "It was not the first time."
    mc "No era la primera vez."

