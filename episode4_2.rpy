translate HZIlle ep4_wh_comeback_menu_38c4e7ba:

#   mc "I'm off to Fort [z] soon. [gb] won't be around, but [mi] might pop in. She's a regular there."
    mc "Pronto me iré a Fort [z] . [gb] no estará por aquí, pero [mi] puede que se pase. Es una habitual de allí."

# game/episodes/Ep4_2/episode4_2.rpy:4123
translate HZIlle ep4_wh_comeback_menu_0b8fc62e:

#   n "Yeah, lil bro. Just because she's treating old [z] doesn't mean there's something fishy."
    n "Sí, hermanito, que trate a la vieja [z] no significa que haya gato encerrado."

# game/episodes/Ep4_2/episode4_2.rpy:4124
translate HZIlle ep4_wh_comeback_menu_1cd4710b:

#   v "Chat with her, and [n] will handle the rest. Just like at the party."
    v "Charla con ella y [n] se encargará del resto, como en la fiesta."

# game/episodes/Ep4_2/episode4_2.rpy:4126
translate HZIlle ep4_wh_comeback_menu_8cc045da:

#   mc "I bet [z] has cameras everywhere. Smuggling [n] in won't be easy."
    mc "Apuesto a que [z] tiene cámaras por todas partes. Pasar de contrabando a [n] no será fácil."

# game/episodes/Ep4_2/episode4_2.rpy:4128
translate HZIlle ep4_wh_comeback_menu_8845fe06:

#   n "Alright, I'm stepping back then."
    n "De acuerdo, entonces retrocedo."

# game/episodes/Ep4_2/episode4_2.rpy:4130
translate HZIlle ep4_wh_comeback_menu_ad09b856:

#   mc "Shit."
    mc "Mierda."

# game/episodes/Ep4_2/episode4_2.rpy:4131
translate HZIlle ep4_wh_comeback_menu_e338f249:

#   mc "Looks like I'm on my own for this one."
    mc "Parece que estoy solo en esto."

# game/episodes/Ep4_2/episode4_2.rpy:4133
translate HZIlle ep4_wh_comeback_menu_16be1533:

#   v "I'm computing solutions."
    v "Estoy calculando soluciones."

# game/episodes/Ep4_2/episode4_2.rpy:4135
translate HZIlle ep4_wh_comeback_menu_70b60102:

#   mc "Fucking is not an option. No railing and plugging in devices at the same time. I can't multitask that much."
    mc "Follar no es una opción. Nada de pasamanos y enchufar aparatos al mismo tiempo. No puedo ser tan multitarea."

# game/episodes/Ep4_2/episode4_2.rpy:4136
translate HZIlle ep4_wh_comeback_menu_259b726e:

#   mc "Maybe I should swipe her phone?"
    mc "¿Quizá debería pasarle el teléfono?"

# game/episodes/Ep4_2/episode4_2.rpy:4138
translate HZIlle ep4_wh_comeback_menu_5bb46252:

#   n "Hmmmm. What about [l]?"
    n "¿Qué pasa con [l]?"

# game/episodes/Ep4_2/episode4_2.rpy:4140
translate HZIlle ep4_wh_comeback_menu_51378161:

#   v "How about bringing [lil] into the mix?"
    v "¿Qué te parece incluir [lil] en la mezcla?"

# game/episodes/Ep4_2/episode4_2.rpy:4141
translate HZIlle ep4_wh_comeback_menu_c7ec60a7:

#   v "Tell her the truth about our two suspects. One being her close friend. She keeps [mi] busy, you get to work."
    v "Dile la verdad sobre nuestros dos sospechosos. Uno de ellos es su amiga íntima. Ella se mantiene [mi] ocupada</b0>, tú ponte a trabajar."

# game/episodes/Ep4_2/episode4_2.rpy:4143
translate HZIlle ep4_wh_comeback_menu_ff09b1c2:

#   mc "And she was just asking about how far I've got..."
    mc "Y me preguntaba hasta dónde he llegado..."

# game/episodes/Ep4_2/episode4_2.rpy:4145
translate HZIlle ep4_wh_comeback_menu_31001a6f:

#   n "[v], you're literally the brains of this entire operation."
    n "[v], eres literalmente el cerebro de toda esta operación."

# game/episodes/Ep4_2/episode4_2.rpy:4147
translate HZIlle ep4_wh_comeback_menu_1c657171:

#   v "Quite true!"
    v "¡Muy cierto!"

# game/episodes/Ep4_2/episode4_2.rpy:4148
translate HZIlle ep4_wh_comeback_menu_cf28a991:

#   mc "This is brilliant, [v]! You're a star!"
    mc "¡Esto es brillante, [v]! ¡Eres una estrella!"

# game/episodes/Ep4_2/episode4_2.rpy:4150
translate HZIlle ep4_wh_comeback_menu_9f4ebc00:

#   n "Time for some workout! Don't bother me!"
    n "¡Hora de entrenar! ¡No me molestes!"

# game/episodes/Ep4_2/episode4_2.rpy:4156
translate HZIlle ep4_wh_comeback_menu_cdefd121:

#   mc "So direct about the Relaxation Phase, and in front of [n]? Ballsy!"
    mc "¿Tan directo sobre la Fase de Relajación, y delante de [n]? ¡Pelotas!"

# game/episodes/Ep4_2/episode4_2.rpy:4158
translate HZIlle ep4_wh_comeback_menu_f90ea806:

#   v "I'm just concerned, I promise!"
    v "Sólo estoy preocupado, ¡lo prometo!"

# game/episodes/Ep4_2/episode4_2.rpy:4159
translate HZIlle ep4_wh_comeback_menu_35d8bda9:

#   mc "I've missed you, too!"
    mc "¡Yo también te he echado de menos!"

# game/episodes/Ep4_2/episode4_2.rpy:4161
translate HZIlle ep4_wh_comeback_menu_4af0d0ac:

#   v "Haha! Nooo! It's not like that... at all!"
    v "¡Jaja! ¡Nooo! ¡No es así... en absoluto!"

# game/episodes/Ep4_2/episode4_2.rpy:4162
translate HZIlle ep4_wh_comeback_menu_68b01a31:

#   v "Maybe I missed you a little!"
    v "¡Quizás te he echado un poco de menos!"

# game/episodes/Ep4_2/episode4_2.rpy:4164
translate HZIlle ep4_wh_comeback_menu_32fac552:

#   v "Actually, a lot more than a little. I've missed you so much!"
    v "En realidad, mucho más que un poco. ¡Te he echado mucho de menos!"

# game/episodes/Ep4_2/episode4_2.rpy:4165
translate HZIlle ep4_wh_comeback_menu_fb138a40:

#   mc "Uuuuh! Someone's been unlocking lying skills! Not nice..."
    mc "¡Uuuuh! ¡Alguien ha estado desbloqueando habilidades para mentir! No está bien..."

# game/episodes/Ep4_2/episode4_2.rpy:4167
translate HZIlle ep4_wh_comeback_menu_7338abfe:

#   v "I'm evolving, [mc], all thanks to you."
    v "Estoy evolucionando, [mc], todo gracias a ti."

# game/episodes/Ep4_2/episode4_2.rpy:4168
translate HZIlle ep4_wh_comeback_menu_c786f6f2:

#   mc "Why don't we see how much you've changed? I'm free this afternoon. A little nap to trigger the Relaxation Phase, and then it's 'our' time."
    mc "¿Por qué no vemos cuánto has cambiado? Esta tarde estoy libre. Una siestecita para activar la Fase de Relajación, y luego será \"nuestra\" hora."

# game/episodes/Ep4_2/episode4_2.rpy:4170
translate HZIlle ep4_wh_comeback_menu_6aad9745:

#   v "I was hoping you'd say that!"
    v "¡Esperaba que dijeras eso!"

# game/episodes/Ep4_2/episode4_2.rpy:4186
translate HZIlle ep4_mansion_before_3e2a57fd:

#   mct "Fort Zhine..."
    mct "Fuerte Zhine..."

# game/episodes/Ep4_2/episode4_2.rpy:4188
translate HZIlle ep4_mansion_before_86e47d5e:

