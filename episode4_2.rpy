#   mc "[sa], [z]'s assassin."
    mc "[sa], el asesino de [z]."

# game/episodes/Ep4_2/episode4_2.rpy:7184
translate HZIlle ep4_cafe_7f2a473d:

#   f "You sure?"
    f "¿Estás seguro?"

# game/episodes/Ep4_2/episode4_2.rpy:7185
translate HZIlle ep4_cafe_24b4d06a:

#   mc "100%%."
    mc "100%%."

# game/episodes/Ep4_2/episode4_2.rpy:7190
translate HZIlle ep4_cafe_c52b8ce4:

#   f "How about we get down to business?"
    f "¿Qué tal si vamos al grano?"

# game/episodes/Ep4_2/episode4_2.rpy:7192
translate HZIlle ep4_cafe_e8b1f419:

#   bl "Such a good idea!"
    bl "¡Qué buena idea!"

# game/episodes/Ep4_2/episode4_2.rpy:7194
translate HZIlle ep4_cafe_b5769266:

#   bl "We're here with a special invitation for [n] to join [hns]. You're a prime candidate according to the leadership."
    bl "Estamos aquí con una invitación especial para que [n] se una a [hns]. Eres un candidato de primera según la dirección."

# game/episodes/Ep4_2/episode4_2.rpy:7195
translate HZIlle ep4_cafe_265fb546:

#   bl "So, as the one who vouched for you, I'm here to hand over this fancy device and show you the ropes."
    bl "Así que, como el que ha respondido por ti, estoy aquí para entregarte este elegante aparato y enseñarte cómo funciona."

# game/episodes/Ep4_2/episode4_2.rpy:7197
translate HZIlle ep4_cafe_a913283e:

#   bl "Here's the device. Power it up and let it scan your face. This ensures that only you have access to it."
    bl "Aquí tienes el dispositivo. Enciéndelo y deja que escanee tu cara. Así te aseguras de que sólo tú tengas acceso a él."

# game/episodes/Ep4_2/episode4_2.rpy:7198
translate HZIlle ep4_cafe_fd6f12f2:

#   bl "Any unauthorized use will result in the app's permanent deletion."
    bl "Cualquier uso no autorizado conllevará la eliminación permanente de la aplicación."

# game/episodes/Ep4_2/episode4_2.rpy:7200
translate HZIlle ep4_cafe_4640dfcb:

#   n "Yup, I figured after seeing dumb and dumber begging at the party..."
    n "Sí, me lo imaginaba después de ver a tontos y a tontos mendigando en la fiesta..."

# game/episodes/Ep4_2/episode4_2.rpy:7202
translate HZIlle ep4_cafe_f9af1005:

#   bl "You accept a job via the device, everything else is handled through your phone."
    bl "Aceptas un trabajo a través del dispositivo, todo lo demás se gestiona a través de tu teléfono."

# game/episodes/Ep4_2/episode4_2.rpy:7203
translate HZIlle ep4_cafe_ffd84c2c:

#   bl "Photos, extra objectives, anything..."
    bl "Fotos, objetivos adicionales, cualquier cosa..."

# game/episodes/Ep4_2/episode4_2.rpy:7205
translate HZIlle ep4_cafe_f6a70799:

#   bl "We don't offer second chances, unless the higher-ups say otherwise."
    bl "No ofrecemos segundas oportunidades, a menos que los superiores digan lo contrario."

# game/episodes/Ep4_2/episode4_2.rpy:7207
translate HZIlle ep4_cafe_105aa811:

#   f "Ummm... One tiny thing you should know..."
    f "Ummm... Una cosita que deberías saber..."

# game/episodes/Ep4_2/episode4_2.rpy:7209
translate HZIlle ep4_cafe_42d40fff:

#   bl "We're also eyeing [mc] for potential membership..."
    bl "También estamos mirando a [mc] para una posible adhesión..."

# game/episodes/Ep4_2/episode4_2.rpy:7211
translate HZIlle ep4_cafe_3d364a8e:

#   f "Not now..."
    f "Ahora no..."

# game/episodes/Ep4_2/episode4_2.rpy:7213
translate HZIlle ep4_cafe_b47e0286:

#   bl "Just... You know..."
    bl "Sólo... Ya sabes..."

# game/episodes/Ep4_2/episode4_2.rpy:7215
translate HZIlle ep4_cafe_f008d761:

#   f "Perhaps further down the line?"
    f "¿Quizá más adelante?"

# game/episodes/Ep4_2/episode4_2.rpy:7217
translate HZIlle ep4_cafe_1e61cdb8:

#   mc "I can neither confirm nor deny."
    mc "No puedo confirmarlo ni negarlo."

# game/episodes/Ep4_2/episode4_2.rpy:7219
translate HZIlle ep4_cafe_510c13c7:

#   f "Let's focus on the present. Is your face scan complete, [n]?"
    f "Centrémonos en el presente. ¿Has completado el escaneado de tu cara, [n]?"

# game/episodes/Ep4_2/episode4_2.rpy:7221
translate HZIlle ep4_cafe_e47a425c:

#   n "Looks like it."
    n "Eso parece."

# game/episodes/Ep4_2/episode4_2.rpy:7224
translate HZIlle ep4_cafe_d55abd0f:

#   f "Perfect. I'll just confirm your device for its first run."
    f "Perfecto. Confirmaré tu dispositivo para su primera ejecución."

# game/episodes/Ep4_2/episode4_2.rpy:7226
translate HZIlle ep4_cafe_32a6b808:

#   f "Ready?"
    f "¿Preparado?"

# game/episodes/Ep4_2/episode4_2.rpy:7227
translate HZIlle ep4_cafe_f972b2ba:

#   bl "Anything popped up?"
    bl "¿Ha aparecido algo?"

# game/episodes/Ep4_2/episode4_2.rpy:7229
translate HZIlle ep4_cafe_f7e28f63:

#   n "A referral link? Looks like a scam."
    n "¿Un enlace de referencia? Parece una estafa."

# game/episodes/Ep4_2/episode4_2.rpy:7231
translate HZIlle ep4_cafe_f0f8b558:

#   f "It's not. It's just... hmmm..."
    f "No lo es. Es que... hmmm..."

# game/episodes/Ep4_2/episode4_2.rpy:7233
translate HZIlle ep4_cafe_e383b781:

#   bl "[f] benefits from your payouts. That's the drill."
    bl "[f] se beneficia de tus pagos. Ése es el procedimiento."

# game/episodes/Ep4_2/episode4_2.rpy:7235
translate HZIlle ep4_cafe_cc3084af:

#   n "I don't mind."
    n "No me importa."

# game/episodes/Ep4_2/episode4_2.rpy:7237
translate HZIlle ep4_cafe_08fb6be9:

#   n "This your profile, [f]? Cute photo."
    n "¿Éste es tu perfil, [f]? Bonita foto."

# game/episodes/Ep4_2/episode4_2.rpy:7239
translate HZIlle ep4_cafe_ed1158dc:

#   f "Um, thanks?"
    f "Um, ¿gracias?"

# game/episodes/Ep4_2/episode4_2.rpy:7241
translate HZIlle ep4_cafe_e483cad0:

#   n "Mind if I show [mc]?"
    n "¿Te importa si muestro [mc]?"

# game/episodes/Ep4_2/episode4_2.rpy:7243
translate HZIlle ep4_cafe_e5557f9c:

#   bl "ABSOLUTELY NOT! That would lock you out of the device!"
    bl "¡ABSOLUTAMENTE NO! ¡Eso te bloquearía el dispositivo!"

# game/episodes/Ep4_2/episode4_2.rpy:7245
translate HZIlle ep4_cafe_25d0e623:

#   n "Whoops, my bad. Safety first, right?"
    n "La seguridad es lo primero, ¿no?"

# game/episodes/Ep4_2/episode4_2.rpy:7247
translate HZIlle ep4_cafe_f6ba6c61:

#   f "Exactly."
    f "Exacto."

# game/episodes/Ep4_2/episode4_2.rpy:7249
translate HZIlle ep4_cafe_27fe0623:

#   n "So, you're [f], ID 552902."
    n "Así que eres [f], ID 552902."

# game/episodes/Ep4_2/episode4_2.rpy:7251
translate HZIlle ep4_cafe_5c21aeb5:

#   f "That's me. You'll see that ID often when completing jobs. It shows my 5%% cut."
    f "Ese soy yo. Verás esa identificación a menudo cuando completes los trabajos. Muestra mi porcentaje del 5%%."

# game/episodes/Ep4_2/episode4_2.rpy:7252
translate HZIlle ep4_cafe_2f9fafa7:

#   mct "... What was the ID, again? HOLY SHIT!"
    mct "... ¿Cuál era la identificación, otra vez? MIERDA!"

# game/episodes/Ep4_2/episode4_2.rpy:7254
translate HZIlle ep4_cafe_a8dafadc:

#   n "I'm not in this for the money."
    n "No estoy en esto por el dinero."

# game/episodes/Ep4_2/episode4_2.rpy:7256
translate HZIlle ep4_cafe_e32ff952:

#   bl "Really?"
    bl "¿De verdad?"

# game/episodes/Ep4_2/episode4_2.rpy:7258
translate HZIlle ep4_cafe_22cf0294:

#   n "I want to make a name for myself, hit the Phantom tier, and make a real impact."
    n "Quiero hacerme un nombre, llegar al nivel Fantasma y tener un impacto real."

# game/episodes/Ep4_2/episode4_2.rpy:7260
translate HZIlle ep4_cafe_17f814cd:

#   bl "You're exactly what we're looking for! Wish I was your referrer... I'd be rolling in it."
    bl "Eres exactamente lo que buscamos! Ojalá yo fuera tu recomendante... estaría revolcándome en ello."

# game/episodes/Ep4_2/episode4_2.rpy:7261
translate HZIlle ep4_cafe_d9b44e6a:

#   bl "Now I'm a bit bummed..."
    bl "Ahora estoy un poco desanimado..."

# game/episodes/Ep4_2/episode4_2.rpy:7263
translate HZIlle ep4_cafe_c1b3aaba:

#   f "We need capable people after yesterday's heist. If you really commit to doing high prestige jobs, you'll be a Phantom in no time."
    f "Necesitamos gente capaz después del atraco de ayer. Si realmente te comprometes a hacer trabajos de alto prestigio, serás un Fantasma en poco tiempo."

# game/episodes/Ep4_2/episode4_2.rpy:7264
translate HZIlle ep4_cafe_a7fec009:

#   mc "High prestige jobs... Like?"
    mc "Trabajos de alto prestigio... ¿Cómo?"

# game/episodes/Ep4_2/episode4_2.rpy:7266
translate HZIlle ep4_cafe_2b2489f0:

#   f "Jobs like stalking, extortion, and humiliation, they're not your big-ticket items in terms of cash. But they sure do wonders for your rep."
    f "Trabajos como el acoso, la extorsión y la humillación, no son los más caros en términos de dinero, pero seguro que hacen maravillas por tu reputación."

# game/episodes/Ep4_2/episode4_2.rpy:7267
translate HZIlle ep4_cafe_43f9b0f4:

#   f "Rack up enough prestige points, and you'll get the golden ticket - an invite to become a Phantom."
    f "Acumula suficientes puntos de prestigio y conseguirás el billete dorado: una invitación para convertirte en Fantasma."

# game/episodes/Ep4_2/episode4_2.rpy:7269
translate HZIlle ep4_cafe_6081d79f:

#   n "Sounds simple enough."
    n "Parece bastante sencillo."

# game/episodes/Ep4_2/episode4_2.rpy:7270
translate HZIlle ep4_cafe_1f1f1a2a:

#   n "So how do I navigate around this thing? I'm guessing hands-on help is off the table to keep the app safe?"
    n "Supongo que la ayuda práctica está descartada para mantener la seguridad de la aplicación."

# game/episodes/Ep4_2/episode4_2.rpy:7272
translate HZIlle ep4_cafe_0d6371be:

#   bl "It's super easy. Just power it up..."
    bl "Es superfácil. Sólo tienes que encenderlo..."

# game/episodes/Ep4_2/episode4_2.rpy:7274
translate HZIlle ep4_cafe_7f897b4d:

#   bl "First tab - your dashboard. It shows your earnings, any debts, your prestige level, and your current tier."
    bl "Primera pestaña: tu panel de control. Muestra tus ganancias, cualquier deuda, tu nivel de prestigio y tu nivel actual."

# game/episodes/Ep4_2/episode4_2.rpy:7275
translate HZIlle ep4_cafe_a316f9ff:

#   bl "Second tab - the job board. It's a straightforward list of gigs you can pick up."
    bl "Segunda pestaña: la bolsa de trabajo. Es una lista directa de trabajos que puedes conseguir."

# game/episodes/Ep4_2/episode4_2.rpy:7277
translate HZIlle ep4_cafe_534a12dd:

#   f "And the third tab - your job history."
    f "Y la tercera pestaña: tu historial laboral."

# game/episodes/Ep4_2/episode4_2.rpy:7279
translate HZIlle ep4_cafe_c4bdd344:

#   n "Oh, easy then."
    n "Oh, pues tranquilo."

# game/episodes/Ep4_2/episode4_2.rpy:7280
translate HZIlle ep4_cafe_0d738518:

#   mc "Hang on, what's this about debt?"
    mc "Espera, ¿qué es eso de la deuda?"

# game/episodes/Ep4_2/episode4_2.rpy:7282
translate HZIlle ep4_cafe_1e4d8f3d:

#   bl "Normally, you'd front the initiation fee when you sign up. After that, any job earnings start chipping away at what you owe."
    bl "Normalmente, cuando te inscribes tienes que pagar la cuota de ingreso. Después, cualquier ganancia laboral empieza a reducir lo que debes."

# game/episodes/Ep4_2/episode4_2.rpy:7283
translate HZIlle ep4_cafe_2854bf96:

#   n "But we didn't pay upfront..."
    n "Pero no pagamos por adelantado..."

# game/episodes/Ep4_2/episode4_2.rpy:7285
translate HZIlle ep4_cafe_67677173:

#   f "... Care to fill us in, [bl]?"
    f "... ¿Te importaría informarnos, [bl]?"

# game/episodes/Ep4_2/episode4_2.rpy:7287
translate HZIlle ep4_cafe_feb73af4:

#   bl "Heh, well, the initiation fee took a nosedive when we... mentioned POSSIBLY bringing [mc] on board... eventually."
    bl "Je, bueno, la cuota de iniciación cayó en picado cuando... mencionamos la POSIBILIDAD de traer a [mc] a bordo... eventualmente."

# game/episodes/Ep4_2/episode4_2.rpy:7289
translate HZIlle ep4_cafe_95776c23:

#   n "This is such a scam..."
    n "Esto es una estafa..."

# game/episodes/Ep4_2/episode4_2.rpy:7291
translate HZIlle ep4_cafe_29edb0a1:

#   f "Can't deny that. Cheers to our savvy negotiator."
    f "No se puede negar. Salud a nuestro hábil negociador."

# game/episodes/Ep4_2/episode4_2.rpy:7293
translate HZIlle ep4_cafe_5d300587:

#   bl "Look at the bright side, you're in fee-free!"
    bl "Mira el lado bueno, ¡estás libre de tasas!"

# game/episodes/Ep4_2/episode4_2.rpy:7295
translate HZIlle ep4_cafe_0691da74:

#   f "Speak for yourself..."
    f "Habla por ti..."

# game/episodes/Ep4_2/episode4_2.rpy:7297
translate HZIlle ep4_cafe_f5e120f6:

#   bl "... I meant [n]."
    bl "... Quería decir [n]."

# game/episodes/Ep4_2/episode4_2.rpy:7299
translate HZIlle ep4_cafe_31ffdc47:

#   n "Still, I'm excited to be part of this! [f]..."
    n "Aún así, ¡me emociona formar parte de esto! [f]..."

# game/episodes/Ep4_2/episode4_2.rpy:7301
translate HZIlle ep4_cafe_3eaf6485:

#   f "Hmmm?"
    f "¿Hmmm?"

# game/episodes/Ep4_2/episode4_2.rpy:7303
translate HZIlle ep4_cafe_6b73679c:

#   n "We're gonna make so much money together."
    n "Vamos a ganar mucho dinero juntos."

# game/episodes/Ep4_2/episode4_2.rpy:7305
translate HZIlle ep4_cafe_e6e09321:

#   f "I hope so! If you need anything, hit me up... or [bl]. We're here for you."
    f "Eso espero! Si necesitas algo, dame un toque... o [bl]. Estamos aquí para lo que necesites."

# game/episodes/Ep4_2/episode4_2.rpy:7307
translate HZIlle ep4_cafe_710b3c8e:

#   f "Oh! We almost forgot... the money!"
    f "Casi lo olvidamos... ¡el dinero!"

# game/episodes/Ep4_2/episode4_2.rpy:7309
translate HZIlle ep4_cafe_633e9a0c:

#   bl "Oops! Right, so all the cash you earn goes straight to your BlitzTransfer account, along with your loan info."
    bl "Cierto, así que todo el dinero que ganas va directamente a tu cuenta de BlitzTransfer, junto con la información de tu préstamo."

# game/episodes/Ep4_2/episode4_2.rpy:7311
translate HZIlle ep4_cafe_0cafddc1:

#   f "They kinda finance all [hns] stuff."
    f "En cierto modo financian todas las cosas [hns]."

# game/episodes/Ep4_2/episode4_2.rpy:7313
translate HZIlle ep4_cafe_0c5e5e47:

#   n "Guess I should keep away from [z] Bank then?"
    n "¿Supongo que entonces debería mantenerme alejado del Banco [z]?"

# game/episodes/Ep4_2/episode4_2.rpy:7315
translate HZIlle ep4_cafe_ced6974e:

#   f "A 100 fucking percent... regardless if you are a Slayer or not."
    f "Al cien por cien... independientemente de si eres Cazadora o no."

# game/episodes/Ep4_2/episode4_2.rpy:7317
translate HZIlle ep4_cafe_13206efb:

#   f "We all set then?"
    f "¿Todo listo entonces?"

# game/episodes/Ep4_2/episode4_2.rpy:7319
translate HZIlle ep4_cafe_e3d0905e:

#   bl "I think so..."
    bl "Creo que sí..."

# game/episodes/Ep4_2/episode4_2.rpy:7320
translate HZIlle ep4_cafe_4956bf22:

#   bl "We'll still see each other. Ask anything anytime!"
    bl "Seguiremos viéndonos. ¡Pregúntanos cualquier cosa cuando quieras!"

# game/episodes/Ep4_2/episode4_2.rpy:7322
translate HZIlle ep4_cafe_3910d413:

#   f "Pleasure doing business with you."
    f "Un placer hacer negocios contigo."

# game/episodes/Ep4_2/episode4_2.rpy:7324
translate HZIlle ep4_cafe_12607773:

#   n "Likewise."
    n "Igualmente."

# game/episodes/Ep4_2/episode4_2.rpy:7326
translate HZIlle ep4_cafe_ed087c36:

#   mc "See you soon!"
    mc "¡Hasta pronto!"

# game/episodes/Ep4_2/episode4_2.rpy:7336
translate HZIlle ep4_cafe_4e85cb4d:

#   mc "Hello?"
    mc "Hola?"

# game/episodes/Ep4_2/episode4_2.rpy:7337
translate HZIlle ep4_cafe_437e03b7:

#   lil "10 PM. Desert Springs Motel. Do not be late."
    lil "22 h. Motel Desert Springs. No llegues tarde."

# game/episodes/Ep4_2/episode4_2.rpy:7342
translate HZIlle ep4_cafe_7364effb:

#   mct "And just like that, she hung up... What's this about?"
    mct "Y sin más, colgó... ¿De qué va esto?"

# game/episodes/Ep4_2/episode4_2.rpy:7343
translate HZIlle ep4_cafe_95f0b154:

#   mct "This can't be a setup, can it? [lil] wouldn't do that... Not to me."
    mct "Esto no puede ser un montaje, ¿verdad? [lil] No haría eso... No a mí."

# game/episodes/Ep4_2/episode4_2.rpy:7345
translate HZIlle ep4_cafe_4e85950e:

#   mct "There's got to be another reason. It can't be what I'm thinking."
    mct "Tiene que haber otra razón, no puede ser lo que estoy pensando."

# game/episodes/Ep4_2/episode4_2.rpy:7368
translate HZIlle ep4_lil_ss_0c187d0c:

#   mct "I'm anxious... What if [lil] wants to get rid of me?"
    mct "Estoy ansioso... ¿Y si [lil] quiere deshacerse de mí?"

# game/episodes/Ep4_2/episode4_2.rpy:7369
translate HZIlle ep4_lil_ss_da8864b2:

#   mct "After all, I am the only one who knows about [z]'s affair."
    mct "Al fin y al cabo, soy el único que conoce la aventura de [z]."

# game/episodes/Ep4_2/episode4_2.rpy:7371
translate HZIlle ep4_lil_ss_fdd05892:

#   mct "What if she thinks I want to sell the info...? Humiliate her, expose [z]... and make bank."
    mct "¿Y si piensa que quiero vender la información? Humillarla, desenmascarar a [z]... y hacer caja."

# game/episodes/Ep4_2/episode4_2.rpy:7372
translate HZIlle ep4_lil_ss_4bdc5aa0:

#   mct "Shit!"
    mct "¡Mierda!"

# game/episodes/Ep4_2/episode4_2.rpy:7374
translate HZIlle ep4_lil_ss_cbb731c2:

#   mct "I should've told her I only did it for her!"
    mct "¡Debería haberle dicho que sólo lo hice por ella!"

# game/episodes/Ep4_2/episode4_2.rpy:7376
translate HZIlle ep4_lil_ss_d044c449:

#   mct "Why didn't I do that?!"
    mct "¿Por qué no lo hice?"

# game/episodes/Ep4_2/episode4_2.rpy:7378
translate HZIlle ep4_lil_ss_1387bd9f:

#   mct "I'm at the location... A perfect place to get whacked. No witnesses, plenty of spots to hide the body."
    mct "Estoy en el lugar... Un sitio perfecto para que te den una paliza. Sin testigos, con muchos sitios para esconder el cuerpo."

# game/episodes/Ep4_2/episode4_2.rpy:7379
translate HZIlle ep4_lil_ss_930de9ee:

#   mct "What the hell am I doing?"
    mct "¿Qué demonios estoy haciendo?"

# game/episodes/Ep4_2/episode4_2.rpy:7381
translate HZIlle ep4_lil_ss_75dd8c81:

#   mct "I should get out of here..."
    mct "Debería salir de aquí..."

# game/episodes/Ep4_2/episode4_2.rpy:7383
translate HZIlle ep4_lil_ss_295bbea7:

#   mct "..."
    mct "..."

# game/episodes/Ep4_2/episode4_2.rpy:7385
translate HZIlle ep4_lil_ss_dcc3bb4c:

#   mct "Too late now."
