translate HZIlle ep4_wh_comeback_d756c636:

#   mc "You know a thing or two about my skill, don't you?"
    mc "Sabes un par de cosas sobre mi habilidad, ¿verdad?"

# game/episodes/Ep4_2/episode4_2.rpy:4093
translate HZIlle ep4_wh_comeback_a54b3feb:

#   mc "Owww! It was only a joke!"
    mc "¡Sólo era una broma!"

