translate HZIlle ep1_streets_downtown_0d199a5d:

#   mc "You should consider working in advertising. Is the pay that good?"
    mc "Deberías plantearte trabajar en publicidad. ¿Tan bien pagan?"

# game/episodes/episode1.rpy:4481
translate HZIlle ep1_streets_downtown_d3c253da:

#   l "I don't care about IRL money. Why would I even need it?"
    l "No me importa el dinero IRL, ¿para qué iba a necesitarlo?"

# game/episodes/episode1.rpy:4482
translate HZIlle ep1_streets_downtown_c3afd34c:

#   l "I'm grateful for the opportunity to work for Aegis."
    l "Agradezco la oportunidad de trabajar para Aegis."

# game/episodes/episode1.rpy:4484
translate HZIlle ep1_streets_downtown_4b40a600:

#   mc "An employee of the month, I see!"
    mc "Un empleado del mes, ¡ya veo!"

# game/episodes/episode1.rpy:4486
translate HZIlle ep1_streets_downtown_c6dda40f:

#   mc "Ok! I'm done! We're not going any further!"
    mc "¡Vale! ¡He terminado! ¡No vamos a ir más lejos!"

# game/episodes/episode1.rpy:4488
translate HZIlle ep1_streets_downtown_e97d5c4b:

#   l "And the miracle has happened! We're here!"
    l "¡Y se ha producido el milagro! ¡Ya estamos aquí!"

# game/episodes/episode1.rpy:4489
translate HZIlle ep1_streets_downtown_7c42d74a:

#   l "A little optimism goes a long way! So does trusting me!"
    l "¡Un poco de optimismo hace mucho! ¡Y también confiar en mí!"

# game/episodes/episode1.rpy:4494
translate HZIlle ep1_streets_downtown_0e39c0ed:

#   mc "These ads are getting smarter! I can't go a minute without adblock!"
    mc "¡Estos anuncios son cada vez más inteligentes! ¡No puedo pasar ni un minuto sin adblock!"

# game/episodes/episode1.rpy:4506
translate HZIlle ep1_glass_3d3f1328:

#   r "Any progress on finding everyone involved in this?"
    r "¿Algún avance en la búsqueda de todos los implicados en esto?"

# game/episodes/episode1.rpy:4508
translate HZIlle ep1_glass_0b147361:

#   sa "One in custody, the other one missing in action."
    sa "Uno detenido, el otro desaparecido en combate."

# game/episodes/episode1.rpy:4509
translate HZIlle ep1_glass_b78a3d0c:

#   r "What do you mean MIA? How can he be missing if he's supposed to be in jail?!"
    r "¿Cómo que MIA? ¿Cómo puede estar desaparecido si se supone que está en la cárcel?"

# game/episodes/episode1.rpy:4511
translate HZIlle ep1_glass_dd664aa5:

#   sa "No clue. Maybe he's one of the rich kids that get away with everything?"
    sa "Ni idea. ¿Quizá es uno de los niños ricos que se salen con la suya?"

# game/episodes/episode1.rpy:4512
translate HZIlle ep1_glass_97208d95:

#   sa "All I know is he's outside my reach. We'll get to the one we can."
    sa "Sólo sé que está fuera de mi alcance. Llegaremos al que podamos."

# game/episodes/episode1.rpy:4514
translate HZIlle ep1_glass_aef318d0:

#   r "Make sure he won't live to see another day."
    r "Asegúrate de que no vivirá para ver otro día."

# game/episodes/episode1.rpy:4515
translate HZIlle ep1_glass_4b52b8d2:

#   sa "Only if he talks. No use to us as a stiff."
    sa "Sólo si habla. No nos sirve como fiambre."

# game/episodes/episode1.rpy:4517
translate HZIlle ep1_glass_b91065a5:

#   r "Regardless of his cooperation. What we need is his phone."
    r "Independientemente de su cooperación, lo que necesitamos es su teléfono."

# game/episodes/episode1.rpy:4518
translate HZIlle ep1_glass_ba3706f7:

#   sa "Huh. I'll try to pull some strings. Maybe it will work. No guarantee, though."
    sa "Intentaré mover algunos hilos. Quizá funcione, aunque no te lo garantizo."

# game/episodes/episode1.rpy:4520
translate HZIlle ep1_glass_8d41859f:

#   r "I'll talk to the boss."
    r "Hablaré con el jefe."

# game/episodes/episode1.rpy:4521
translate HZIlle ep1_glass_f5a253f4:

#   r "He'll know what to do."
    r "Él sabrá qué hacer."

# game/episodes/episode1.rpy:4523
translate HZIlle ep1_glass_4de4dc9e:

#   sa "Always the man with a plan."
    sa "Siempre el hombre con un plan."

# game/episodes/episode1.rpy:4524
translate HZIlle ep1_glass_c01cea7f:

#   r "This is no joke, [sa]."
    r "Esto no es ninguna broma, [sa]."

# game/episodes/episode1.rpy:4526
translate HZIlle ep1_glass_b46eefde:

#   sa "Sorry, boss. What about those two who ran? Any leads?"
    sa "Lo siento, jefe. ¿Y los dos que huyeron? ¿Alguna pista?"

# game/episodes/episode1.rpy:4527
translate HZIlle ep1_glass_a36ea1af:

#   r "Ugh..."
    r "Uf..."

# game/episodes/episode1.rpy:4529
translate HZIlle ep1_glass_bd45e748:

#   sa "Yeah. Happiness can't last forever."
    sa "Sí, la felicidad no puede durar para siempre."

# game/episodes/episode1.rpy:4530
translate HZIlle ep1_glass_8c12eb75:

#   r "God-damn right."
    r "Claro que sí."

# game/episodes/episode1.rpy:4532
translate HZIlle ep1_glass_a4a3f9d1:

#   j "You don't look too happy, [r]."
    j "No pareces muy contento, [r]."

# game/episodes/episode1.rpy:4533
translate HZIlle ep1_glass_de224f7a:

#   r "We have zero reasons to."
    r "Tenemos cero razones para hacerlo."

# game/episodes/episode1.rpy:4535
translate HZIlle ep1_glass_6450c59f:

#   sa "Yup. Tough times ahead."
    sa "Sí, se avecinan tiempos difíciles."

# game/episodes/episode1.rpy:4536
translate HZIlle ep1_glass_f78e2c96:

#   j "Is this about Mr [z]?!"
    j "¿Se trata del Sr. [z]?"

# game/episodes/episode1.rpy:4538
translate HZIlle ep1_glass_36e71b49:

#   sa "Shhh! Not so loud."
    sa "No tan alto."

# game/episodes/episode1.rpy:4539
translate HZIlle ep1_glass_f9bf86d4:

#   r "Yes, it's about him."
    r "Sí, se trata de él."

# game/episodes/episode1.rpy:4541
translate HZIlle ep1_glass_ddddef5f:

#   j "What does it mean?"
    j "¿Qué significa?"

# game/episodes/episode1.rpy:4542
translate HZIlle ep1_glass_ddd42c39:

#   r "War, most likely. If we get to those responsible for the attack."
    r "La guerra, lo más probable. Si llegamos a los responsables del atentado."

# game/episodes/episode1.rpy:4544
translate HZIlle ep1_glass_8f7df63d:

#   j "Shit."
    j "Mierda."

# game/episodes/episode1.rpy:4545
translate HZIlle ep1_glass_da9a4268:

#   r "You may have to reconsider your career path, [j]. Bartending at the Glass is trouble these days."
    r "Puede que tengas que reconsiderar tu trayectoria profesional, [j]. Ser camarero en el Glass es problemático hoy en día."

# game/episodes/episode1.rpy:4547
translate HZIlle ep1_glass_dbb259de:

#   j "Not gonna happen! I love my job!"
    j "¡No va a pasar! ¡Me encanta mi trabajo!"

# game/episodes/episode1.rpy:4548
translate HZIlle ep1_glass_76a11e1d:

#   j "Besides, I have this fairly cute-looking assassin to defend the fort!"
    j "Además, ¡tengo a este asesino de aspecto bastante mono para defender el fuerte!"

# game/episodes/episode1.rpy:4550
translate HZIlle ep1_glass_b4afdc4a:

#   sa "What do you mean fairly?!"
    sa "¿Qué quieres decir con justo?"

# game/episodes/episode1.rpy:4551
translate HZIlle ep1_glass_cd4db5e7:

#   sa "Also, I'm not cute!"
    sa "Además, ¡no soy guapo!"

# game/episodes/episode1.rpy:4553
translate HZIlle ep1_glass_9ff6eb9a:

#   j "What I meant to say was scary."
    j "Lo que quería decir es que daba miedo."

# game/episodes/episode1.rpy:4554
translate HZIlle ep1_glass_21cb79df:

#   sa "Better."
    sa "Mejor."

# game/episodes/episode1.rpy:4556
translate HZIlle ep1_glass_253597fc:

#   j "But also cute, innocent and bubbly."
    j "Pero también guapa, inocente y burbujeante."

# game/episodes/episode1.rpy:4557
translate HZIlle ep1_glass_4ebcd82f:

#   sa "No wonder you don't get any tips!"
    sa "¡No me extraña que no recibas ninguna propina!"

# game/episodes/episode1.rpy:4559
translate HZIlle ep1_glass_2eb76d7a:

#   r "She gets them from me."
    r "Ella los recibe de mí."

# game/episodes/episode1.rpy:4560
translate HZIlle ep1_glass_d8c5a0e8:

#   j "Thanks, pap!"
    j "¡Gracias, pap!"

# game/episodes/episode1.rpy:4562
translate HZIlle ep1_glass_9fa51ccd:

#   j "Aww! You too, [sa]? How... cute of you!"
    j "¿Tú también, [sa]? ¡Qué mono eres!"

# game/episodes/episode1.rpy:4564
translate HZIlle ep1_glass_1d5aa165:

#   sa "Wrrr! You're in trouble now!"
    sa "¡Wrrr! ¡Ahora tienes problemas!"

# game/episodes/episode1.rpy:4565
translate HZIlle ep1_glass_87128627:

#   sa "Make it up to me. Right now."
    sa "Compénsame, ahora mismo."

# game/episodes/episode1.rpy:4567
translate HZIlle ep1_glass_9c8503d8:

#   j "Hmmm... Fine."
    j "Hmmm... Bien."

# game/episodes/episode1.rpy:4568
translate HZIlle ep1_glass_d4775e98:

#   j "You are the double ass in assassin!"
    j "¡Eres el doble culo de asesino!"

# game/episodes/episode1.rpy:4570
translate HZIlle ep1_glass_b5bc1e2b:

#   sa "All forgiven!"
    sa "¡Todo perdonado!"

# game/episodes/episode1.rpy:4572
translate HZIlle ep1_glass_4b1cd857:

#   j "I'll let you get back to your brooding! Let me know if you need anything else!"
    j "Te dejo que vuelvas a tus cavilaciones! Avísame si necesitas algo más!"

# game/episodes/episode1.rpy:4573
translate HZIlle ep1_glass_469d4e3d:

#   r "Girls..."
    r "Chicas..."

# game/episodes/episode1.rpy:4583
translate HZIlle ep1_glass_1d7ab8a4:

#   j "You're new here. Both of you."
    j "Los dos sois nuevos aquí."

# game/episodes/episode1.rpy:4584
translate HZIlle ep1_glass_2b89abd8:

#   mc "How'd you know?"
    mc "¿Cómo lo has sabido?"

# game/episodes/episode1.rpy:4586
translate HZIlle ep1_glass_288d3d70:

#   j "I have a memory for faces and I haven't seen yours before."
    j "Tengo memoria para las caras y no había visto la tuya antes."

# game/episodes/episode1.rpy:4587
translate HZIlle ep1_glass_bea7d140:

#   j "... and also, I deal with the same clientele every day."
    j "... y además, trato con la misma clientela todos los días."

# game/episodes/episode1.rpy:4589
translate HZIlle ep1_glass_9c6be14b:

#   mc "So you've got an eye for new people."
    mc "Así que tienes buen ojo para la gente nueva."

# game/episodes/episode1.rpy:4590
translate HZIlle ep1_glass_48c3d5fa:

#   j "Eye or, as some people call it, desperation."
    j "Ojo o, como algunos lo llaman, desesperación."

# game/episodes/episode1.rpy:4592
translate HZIlle ep1_glass_8241ec20:

#   j "Seriously, anyone new here sticks out like a sore thumb."
    j "En serio, cualquiera que sea nuevo aquí sobresale como un pulgar dolorido."

# game/episodes/episode1.rpy:4594
translate HZIlle ep1_glass_e943ccfc:

#   l "In that case, you caught us. We're new."
    l "En ese caso, nos has pillado, somos nuevos."

# game/episodes/episode1.rpy:4596
translate HZIlle ep1_glass_e917ced7:

#   j "My instincts never fail me!"
    j "¡Mis instintos nunca me fallan!"

# game/episodes/episode1.rpy:4597
translate HZIlle ep1_glass_5be13d49:

#   j "So, what would the new guys like to drink?"
    j "Entonces, ¿qué les gustaría beber a los nuevos?"

# game/episodes/episode1.rpy:4599
translate HZIlle ep1_glass_1a2ef36e:

#   mc "Two beers, please."
    mc "Dos cervezas, por favor."

# game/episodes/episode1.rpy:4604
translate HZIlle ep1_glass_76249b5d:

#   j "How did you find your way here?"
    j "¿Cómo has llegado hasta aquí?"

# game/episodes/episode1.rpy:4605
translate HZIlle ep1_glass_4a2dbb8c:

#   mc "Just looking for a place to chill."
    mc "Sólo busco un lugar para relajarme."

# game/episodes/episode1.rpy:4607
translate HZIlle ep1_glass_be8a4468:

#   mc "And this one looked like the most promising one!"
    mc "¡Y éste parecía el más prometedor!"

# game/episodes/episode1.rpy:4608
translate HZIlle ep1_glass_0d724a51:

#   j "Really?"
    j "¿De verdad?"

# game/episodes/episode1.rpy:4610
translate HZIlle ep1_glass_0ef8f49a:

#   l "It's the first one we saw."
    l "Es la primera que vimos."

# game/episodes/episode1.rpy:4611
translate HZIlle ep1_glass_e5b4e44f:

#   j "Thought so!"
    j "Eso pensaba."

# game/episodes/episode1.rpy:4613
translate HZIlle ep1_glass_10a61903:

#   mc "What's better than grabbing a beer after a hard day of... well..."
    mc "Qué hay mejor que tomarse una cerveza después de un duro día de... bueno..."

# game/episodes/episode1.rpy:4614
translate HZIlle ep1_glass_c4b16d24:

#   j "Doing nothing?"
    j "¿No hacer nada?"

# game/episodes/episode1.rpy:4616
translate HZIlle ep1_glass_1f73fc4c:

#   j "Yeah, I know the pain."
    j "Sí, conozco el dolor."

# game/episodes/episode1.rpy:4617
translate HZIlle ep1_glass_10ca958c:

#   j "What are the two laziest guys in the world looking for in the city?"
    j "¿Qué buscan en la ciudad los dos tíos más vagos del mundo?"

# game/episodes/episode1.rpy:4619
translate HZIlle ep1_glass_d2c2347b:

#   mc "You know, the usual. New city, new life..."
    mc "Ya sabes, lo de siempre. Nueva ciudad, nueva vida..."

# game/episodes/episode1.rpy:4620
translate HZIlle ep1_glass_8a8a7d55:

#   l "New me."
    l "Nuevo yo."

# game/episodes/episode1.rpy:4622
translate HZIlle ep1_glass_ea75d245:

#   j "Sounds more like a New Year's resolution."
    j "Parece más bien un propósito de Año Nuevo."

# game/episodes/episode1.rpy:4623
translate HZIlle ep1_glass_e801973a:

#   mc "We're looking for opportunities."
    mc "Buscamos oportunidades."

# game/episodes/episode1.rpy:4625
translate HZIlle ep1_glass_48385a8d:

#   r "Everything alright in here?"
    r "¿Va todo bien aquí?"

# game/episodes/episode1.rpy:4626
translate HZIlle ep1_glass_44c25a87:

#   l "What the hell is even that question?"
    l "¿Qué demonios es esa pregunta?"

# game/episodes/episode1.rpy:4628
translate HZIlle ep1_glass_4c994ffe:

#   j "Yeah! Stop scaring our new customers!"
    j "¡Sí! ¡Deja de asustar a nuestros nuevos clientes!"

# game/episodes/episode1.rpy:4629
translate HZIlle ep1_glass_261e4000:

#   r "Sorry! Didn't mean to intrude."
    r "Perdona, no quería entrometerme."

# game/episodes/episode1.rpy:4631
translate HZIlle ep1_glass_150c1d1c:

#   mc "And to answer your question, we're looking for a job."
    mc "Y para responder a tu pregunta, estamos buscando trabajo."

# game/episodes/episode1.rpy:4632
translate HZIlle ep1_glass_7e9d2ccd:

#   j "At the bar? Strange place for a job interview."
    j "¿En el bar? Extraño lugar para una entrevista de trabajo."

# game/episodes/episode1.rpy:4634
translate HZIlle ep1_glass_06705de8:

#   mc "Well, nighttime isn't the best time to look for a job."
    mc "La noche no es el mejor momento para buscar trabajo."

# game/episodes/episode1.rpy:4635
translate HZIlle ep1_glass_fe7cffb8:

#   j "You can find a job after dark, you know! You're not trying hard enough..."
    j "No te esfuerzas lo suficiente..."

# game/episodes/episode1.rpy:4637
translate HZIlle ep1_glass_92fc7a70:

#   l "That's what my ex used to say. Good times!"
    l "Eso es lo que decía mi ex. ¡Buenos tiempos!"

# game/episodes/episode1.rpy:4638
translate HZIlle ep1_glass_b82d2b80:

#   j "Well, I'm saying it now."
    j "Bueno, lo digo ahora."

# game/episodes/episode1.rpy:4640
translate HZIlle ep1_glass_3caef1cd:

#   j "There is a strip club down the road. I'm sure you'd both find a place there."
    j "Hay un club de striptease al final de la calle. Seguro que ambos encontraríais un sitio allí."

# game/episodes/episode1.rpy:4641
translate HZIlle ep1_glass_00ddb4c8:

#   mc "Male strippers?"
    mc "¿Strippers masculinos?"

# game/episodes/episode1.rpy:4643
translate HZIlle ep1_glass_a7298caf:

#   j "You look the part."
    j "Tienes buen aspecto."

# game/episodes/episode1.rpy:4644
translate HZIlle ep1_glass_545090c4:

#   mc "Is that a compliment?"
    mc "¿Es un cumplido?"

# game/episodes/episode1.rpy:4646
translate HZIlle ep1_glass_c3a1e62c:

#   j "You'd fit in staright away is what I meant to say."
    j "Encajarías perfectamente, es lo que quería decir."

# game/episodes/episode1.rpy:4647
translate HZIlle ep1_glass_653cb8e1:

#   j "You look good."
    j "Tienes buen aspecto."

# game/episodes/episode1.rpy:4649
translate HZIlle ep1_glass_8c2067c7:

#   j "Tips are welcome!"
    j "¡Los consejos son bienvenidos!"

# game/episodes/episode1.rpy:4650
translate HZIlle ep1_glass_f66e6da4:

#   mc "Oh, really?"
    mc "¿Ah, sí?"

# game/episodes/episode1.rpy:4652
translate HZIlle ep1_glass_df750352:

#   j "Company policy! They cut my wages and expect me to live off tips."
    j "Política de empresa! Me recortan el sueldo y esperan que viva de las propinas."

# game/episodes/episode1.rpy:4653
translate HZIlle ep1_glass_1c796b45:

#   mc "Why do I find this hard to believe? That's exactly what a scammer would say."
    mc "¿Por qué me cuesta creerlo? Es exactamente lo que diría un estafador."

# game/episodes/episode1.rpy:4655
translate HZIlle ep1_glass_753a10a2:

#   j "Don't be cheap!"
    j "¡No seas tacaño!"

# game/episodes/episode1.rpy:4656
translate HZIlle ep1_glass_caa2b027:

#   j "Also, I may or may not have stretched the truth a tiny little bit."
    j "Además, puede que haya estirado o no un poco la verdad."

# game/episodes/episode1.rpy:4658
translate HZIlle ep1_glass_fa32983b:

#   j "But I told the whole truth about appreciating tips!"
    j "¡Pero dije toda la verdad sobre apreciar las propinas!"

# game/episodes/episode1.rpy:4659
translate HZIlle ep1_glass_64d07154:

#   mc "Hmm."
    mc "Hmm."

# game/episodes/episode1.rpy:4661
translate HZIlle ep1_glass_0fe33466:

#   mc "Come on, man. Don't be like that. Just because she sold alcohol to an underage guy doesn't mean she needs to go to jail..."
    mc "Vamos hombre, no seas así, que haya vendido alcohol a un menor no significa que tenga que ir a la cárcel...."

# game/episodes/episode1.rpy:4662
translate HZIlle ep1_glass_816bec49:

#   mc "And lose her job!"
    mc "¡Y perder su trabajo!"

# game/episodes/episode1.rpy:4663
translate HZIlle ep1_glass_00d52ca8:

#   l "Sorry, even off duty, I can't stand by someone breaking the law!"
    l "Lo siento, ¡incluso fuera de servicio, no puedo estar al lado de alguien que infringe la ley!"

# game/episodes/episode1.rpy:4665
translate HZIlle ep1_glass_50df211e:

#   j "Cops?! No way!"
    j "¿Policías? ¡Ni hablar!"

# game/episodes/episode1.rpy:4666
translate HZIlle ep1_glass_4e7bb535:

#   j "Please, I need this job!"
    j "Por favor, ¡necesito este trabajo!"

# game/episodes/episode1.rpy:4668
translate HZIlle ep1_glass_6aaf5375:

#   mc "What are you willing to do to keep it?"
    mc "¿Qué estás dispuesto a hacer para conservarlo?"

# game/episodes/episode1.rpy:4669
translate HZIlle ep1_glass_b039f382:

#   j "Did I just enter a porn casting?"
    j "¿Acabo de entrar en un casting porno?"

# game/episodes/episode1.rpy:4671
translate HZIlle ep1_glass_25083597:

#   j "It doesn't have the same charm without the black couch. Not my thing."
    j "No tiene el mismo encanto sin el sofá negro, no es lo mío."

# game/episodes/episode1.rpy:4672
