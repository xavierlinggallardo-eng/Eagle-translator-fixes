#   n "AHHHH!"
    n "¡AHHHH!"

# game/episodes/episode1.rpy:171
translate HZIlle ep1_intro_6fce83da:

#   nt "Yes! I've got it!"
    nt "¡Sí! ¡Lo tengo!"

# game/episodes/episode1.rpy:175
translate HZIlle ep1_intro_d4f25fa6:

#   v "[n]! What's with the delay?! Did you find anything else?"
    v "[n] ¿A qué se debe el retraso? ¿Has encontrado algo más?"

# game/episodes/episode1.rpy:194
translate HZIlle ep1_intro_2809fae8:

#   n "Oh, fuck no!"
    n "¡Joder, no!"

# game/episodes/episode1.rpy:217
translate HZIlle ep1_intro_668624c1:

#   n "It'so close! I can make it!"
    n "¡Está tan cerca! ¡Puedo hacerlo!"

# game/episodes/episode1.rpy:259
translate HZIlle ep1_pmc_boss1_c77f7582:

#   msd "Ah, [n]! I didn't see you there!"
    msd "Ah, [n] ¡No te había visto!"

# game/episodes/episode1.rpy:260
translate HZIlle ep1_pmc_boss1_7cc282f4:

#   msd "Hmm. Accidents do happen, even to the best of us."
    msd "Los accidentes ocurren, incluso a los mejores de nosotros."

# game/episodes/episode1.rpy:262
translate HZIlle ep1_pmc_boss1_90985147:

#   n "My leg wasn't an accident."
    n "Mi pierna no fue un accidente."

# game/episodes/episode1.rpy:263
translate HZIlle ep1_pmc_boss1_b65571d4:

#   n "And I need it fixed before the next deployment."
    n "Y necesito que se arregle antes del próximo despliegue."

# game/episodes/episode1.rpy:266
translate HZIlle ep1_pmc_boss1_1fa6da73:

#   n "Laser tricks, the AI calculating a couple of walking cycle corrections, and I should be good to go."
    n "Trucos láser, la IA calculando un par de correcciones del ciclo de marcha, y debería estar listo."

# game/episodes/episode1.rpy:271
translate HZIlle ep1_pmc_boss1_5c611196:

#   msd "No laser tricks and no calculations. We don't have time."
    msd "Nada de trucos láser ni cálculos, no tenemos tiempo."

# game/episodes/episode1.rpy:273
translate HZIlle ep1_pmc_boss1_61a7d955:

#   msd "We're sending Valerie and the rest of her team in 15 minutes. You included."
    msd "En 15 minutos enviaremos a Valerie y al resto de su equipo. Tú incluido."

# game/episodes/episode1.rpy:275
translate HZIlle ep1_pmc_boss1_130b9634:

#   n "Don't give me that bullshit! What's with the rush?"
    n "¡No me vengas con esas tonterías! ¿A qué vienen esas prisas?"

# game/episodes/episode1.rpy:276
translate HZIlle ep1_pmc_boss1_416f413f:

#   n "We've been running simulations with out-of-control security systems for a decade!"
    n "¡Llevamos una década haciendo simulaciones con sistemas de seguridad fuera de control!"

# game/episodes/episode1.rpy:278
translate HZIlle ep1_pmc_boss1_1420af01:

#   n "What difference does a day make?"
    n "¿Qué diferencia hay entre un día y otro?"

# game/episodes/episode1.rpy:280
translate HZIlle ep1_pmc_boss1_7776ef57:

#   msd "Tell me, [n], what's the result of the uncontrollable system? Hmmm?"
    msd "Dime, [n] ¿cuál es el resultado del sistema incontrolable? Hmmm?"

# game/episodes/episode1.rpy:282
translate HZIlle ep1_pmc_boss1_0afb6092:

#   n "A dead agent."
    n "Un agente muerto."

# game/episodes/episode1.rpy:284
translate HZIlle ep1_pmc_boss1_c3cbe462:

#   msd "Third this month! 5 years of experience out the window! And it's getting worse by the day."
    msd "El tercero de este mes! ¡5 años de experiencia por la ventana! Y cada día va a peor."

# game/episodes/episode1.rpy:285
translate HZIlle ep1_pmc_boss1_141d3412:

#   msd "We don't have time to fix you up."
    msd "No tenemos tiempo para arreglarte."

# game/episodes/episode1.rpy:287
translate HZIlle ep1_pmc_boss1_144377be:

#   msd "Why are you here?"
    msd "¿Por qué estás aquí?"

# game/episodes/episode1.rpy:289
translate HZIlle ep1_pmc_boss1_5b843739:

#   n "Our previous mission turned out to be a success..."
    n "Nuestra misión anterior resultó ser un éxito..."

# game/episodes/episode1.rpy:291
translate HZIlle ep1_pmc_boss1_1c568474:

#   msd "And a failure."
    msd "Y un fracaso."

# game/episodes/episode1.rpy:293
translate HZIlle ep1_pmc_boss1_ca678cc0:

#   n "We got what we went for, didn't we? That's a-aall that matters, right?"
    n "Conseguimos lo que queríamos, ¿no? Eso es lo único que importa, ¿no?"

# game/episodes/episode1.rpy:294
translate HZIlle ep1_pmc_boss1_5b018026:

#   n "Complete the objective no matter the cost."
    n "Completa el objetivo cueste lo que cueste."

# game/episodes/episode1.rpy:296
translate HZIlle ep1_pmc_boss1_bfe64ed8:

#   msd "Cut to the chase. You've got something for me?"
    msd "Ve al grano. ¿Tienes algo para mí?"

# game/episodes/episode1.rpy:297
translate HZIlle ep1_pmc_boss1_052da679:

#   n "Information retrieved and decrypted. All in time."
    n "Información recuperada y desencriptada. Todo a tiempo."

# game/episodes/episode1.rpy:299
translate HZIlle ep1_pmc_boss1_9b2029dc:

#   n "Hector Zhine. Co-creator of the AI... and a traitor. How sad."
    n "Hector Zhine. Co-creador de la IA... y traidor. Qué triste."

# game/episodes/episode1.rpy:300
translate HZIlle ep1_pmc_boss1_a4312c0e:

#   n "You had no idea that he coded the security system to keep you in check, did you?"
    n "No tenías ni idea de que había codificado el sistema de seguridad para mantenerte a raya, ¿verdad?"

# game/episodes/episode1.rpy:302
translate HZIlle ep1_pmc_boss1_020f05b5:

#   msd "I read Valerie's report. No need to repeat."
    msd "He leído el informe de Valerie, no hace falta repetirlo."

# game/episodes/episode1.rpy:303
translate HZIlle ep1_pmc_boss1_0d6c0d1a:

#   msd "I already know everything."
    msd "Ya lo sé todo."

# game/episodes/episode1.rpy:305
translate HZIlle ep1_pmc_boss1_5b7d2d31:

#   n "Dismantling the security system..."
    n "Desmontar el sistema de seguridad..."

# game/episodes/episode1.rpy:306
translate HZIlle ep1_pmc_boss1_8102c95a:

#   n "Getting rid of the [exe], wouldn't that be convenient for you?"
    n "Deshacerte del [exe], ¿no te resultaría conveniente?"

# game/episodes/episode1.rpy:308
translate HZIlle ep1_pmc_boss1_edd1c9be:

#   msd "For me? What about you? What about the other agents? No danger, no life-threatening situations."
    msd "¿Para mí? ¿Y para ti? ¿Y para los demás agentes? No hay peligro, no hay situaciones que pongan en peligro la vida."

# game/episodes/episode1.rpy:309
translate HZIlle ep1_pmc_boss1_53b70ba3:

#   msd "You can be whoever you want to be. A paradise with no consequences for your actions."
    msd "Puedes ser quien quieras ser. Un paraíso sin consecuencias para tus actos."

# game/episodes/episode1.rpy:310
translate HZIlle ep1_pmc_boss1_a737d4b0:

#   msd "Free rein!"
    msd "¡Vía libre!"

# game/episodes/episode1.rpy:312
translate HZIlle ep1_pmc_boss1_a66458e6:

#   n "[msd], blessing us with such care for her dear agents. I'm touched."
    n "[msd], bendiciéndonos con tanto cuidado para sus queridos agentes. Estoy conmovido."

# game/episodes/episode1.rpy:313
translate HZIlle ep1_pmc_boss1_64c7a2f0:

#   msd "Well-treated agents doing their job flawlessly is a benefit for all parties. Win-win for everyone."
    msd "Los agentes bien tratados que hacen su trabajo a la perfección son un beneficio para todas las partes. Todos salen ganando."

# game/episodes/episode1.rpy:314
translate HZIlle ep1_pmc_boss1_46c2bb8f:

#   msd "If you'd ever led anyone, you'd know."
    msd "Si alguna vez hubieras dirigido a alguien, lo sabrías."

# game/episodes/episode1.rpy:316
translate HZIlle ep1_pmc_boss1_38eb39fe:

#   msd "Besides, properly motivated agents complete their assignments no matter the cost."
    msd "Además, los agentes debidamente motivados completan sus tareas cueste lo que cueste."

# game/episodes/episode1.rpy:318
translate HZIlle ep1_pmc_boss1_2e61c847:

#   msd "Wouldn't you know something about that, [n]?"
    msd "¿No sabrías tú algo de eso, [n]?"

# game/episodes/episode1.rpy:325
translate HZIlle ep1_pmc_boss1_3aa18362:

#   msd "What is this?!"
    msd "¿Qué es esto?"

# game/episodes/episode1.rpy:327
translate HZIlle ep1_pmc_boss1_b766f002:

#   n "Thought you already knew everything?"
    n "¿Pensabas que ya lo sabías todo?"

# game/episodes/episode1.rpy:329
translate HZIlle ep1_pmc_boss1_272e6614:

#   n "You don't?"
    n "¿No?"

# game/episodes/episode1.rpy:331
translate HZIlle ep1_pmc_boss1_d1c43e7a:

#   n "It would be a shame if you missed the most crucial part."
    n "Sería una pena que te perdieras la parte más crucial."

# game/episodes/episode1.rpy:332
translate HZIlle ep1_pmc_boss1_288f0145:

#   msd "What do you want?"
    msd "¿Qué quieres?"

# game/episodes/episode1.rpy:334
translate HZIlle ep1_pmc_boss1_3a872d0a:

#   n "No need to repeat myself, right?"
    n "No hace falta que me repita, ¿verdad?"

# game/episodes/episode1.rpy:335
translate HZIlle ep1_pmc_boss1_c4212b3e:

#   msd "Hm. The deal still stands."
    msd "El trato sigue en pie."

# game/episodes/episode1.rpy:337
translate HZIlle ep1_pmc_boss1_f6be9715:

#   n "[d] gave up his life for this."
    n "[d] dio su vida por esto."

# game/episodes/episode1.rpy:339
translate HZIlle ep1_pmc_boss1_930765ce:

#   n "Betray me, and you'll share his fate."
    n "Traicióname y compartirás su destino."

# game/episodes/episode1.rpy:346
translate HZIlle ep1_pmc_boss1_8512b317:

#   n "About Hector Zhine's treachery, I assume I'm sitting this one out?"
    n "Sobre la traición de Héctor Zhine, ¿asumo que me voy a sentar?"

# game/episodes/episode1.rpy:348
translate HZIlle ep1_pmc_boss1_f2ac4c46:

#   msd "With no replacements available? Not a chance."
    msd "¿Sin sustitutos disponibles? Ni hablar."

# game/episodes/episode1.rpy:350
translate HZIlle ep1_pmc_boss1_ef9582ff:

#   n "So you expect me to pull off the riskiest heist we've ever attempted on crutches?"
    n "¿Esperas que lleve a cabo el atraco más arriesgado que jamás hayamos intentado con muletas?"

# game/episodes/episode1.rpy:352
translate HZIlle ep1_pmc_boss1_fc956f63:

#   n "That's new."
    n "Eso es nuevo."

# game/episodes/episode1.rpy:353
translate HZIlle ep1_pmc_boss1_153ad7c5:

#   n "Bold."
    n "Negrita."

# game/episodes/episode1.rpy:355
translate HZIlle ep1_pmc_boss1_e136148b:

#   n "And stupid."
    n "Y estúpido."

# game/episodes/episode1.rpy:357
translate HZIlle ep1_pmc_boss1_f6e88f05:

#   msd "Don't be so dramatic. Not everything lays on your shoulders, [n]."
    msd "No seas tan dramático. No todo recae sobre tus hombros, [n]."

# game/episodes/episode1.rpy:359
translate HZIlle ep1_pmc_boss1_55e08074:

#   n "Still, two specialized agents won't be enough. We need at least one more."
    n "Aun así, dos agentes especializados no serán suficientes. Necesitamos al menos uno más."

# game/episodes/episode1.rpy:360
translate HZIlle ep1_pmc_boss1_e7155da7:

#   n "And with no replacements available... See where I'm going with this?"
    n "Y sin sustitutos disponibles... ¿Ves a dónde quiero llegar?"

# game/episodes/episode1.rpy:362
translate HZIlle ep1_pmc_boss1_7312346d:

#   msd "Mhm."
    msd "Mhm."

# game/episodes/episode1.rpy:367
