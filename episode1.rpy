# game/episodes/episode1.rpy:1127
translate HZIlle ep1_sim_intro_994e03fa:

#   mc "But something tells me I wouldn't mind her company at all!"
    mc "¡Pero algo me dice que no me importaría en absoluto su compañía!"

# game/episodes/episode1.rpy:1129
translate HZIlle ep1_sim_intro_823afc62:

#   l "Haha! I sure hope so, given your profession!"
    l "¡Jaja! ¡Seguro que sí, dada tu profesión!"

# game/episodes/episode1.rpy:1130
translate HZIlle ep1_sim_intro_35b4e098:

#   l "Finally, a guy I can talk to!"
    l "¡Por fin un tío con el que puedo hablar!"

# game/episodes/episode1.rpy:1136
translate HZIlle ep1_sim_intro_2320285b:

#   mc "Happy to be here to save you!"
    mc "¡Me alegro de estar aquí para salvarte!"

# game/episodes/episode1.rpy:1137
translate HZIlle ep1_sim_intro_6fc20333:

#   l "Thanks! You should also be excited to be here!"
    l "¡Gracias! ¡También deberías estar emocionada de estar aquí!"

# game/episodes/episode1.rpy:1138
translate HZIlle ep1_sim_intro_e80847ea:

#   l "What I'd give to be in your shoes!"
    l "¡Lo que daría por estar en tu lugar!"

# game/episodes/episode1.rpy:1141
translate HZIlle ep1_sim_intro_6e031d5b:

#   mc "Yeah, maybe."
    mc "Sí, puede ser."

# game/episodes/episode1.rpy:1142
translate HZIlle ep1_sim_intro_d34aaca4:

#   l "Hmm."
    l "Hmm."

# game/episodes/episode1.rpy:1146
translate HZIlle ep1_sim_intro_e98886e2:

#   mc "How long have you been here?"
    mc "¿Cuánto tiempo llevas aquí?"

# game/episodes/episode1.rpy:1147
translate HZIlle ep1_sim_intro_43b245df:

#   l "In this sim? A few days."
    l "¿En esta simulación? Unos días."

# game/episodes/episode1.rpy:1149
translate HZIlle ep1_sim_intro_6c432879:

#   mc "What?! How...?"
    mc "¿Qué? ¿Cómo...?"

# game/episodes/episode1.rpy:1150
translate HZIlle ep1_sim_intro_6a954930:

#   l "Time dicklatation."
    l "Tiempo de dicklatation."

# game/episodes/episode1.rpy:1152
translate HZIlle ep1_sim_intro_9e7c094c:

#   mc "Come again?"
    mc "¿Otra vez?"

# game/episodes/episode1.rpy:1153
translate HZIlle ep1_sim_intro_5be6869d:

#   l "Don't ask me, dude. I have no idea what that word even means."
    l "No me preguntes, tío, no tengo ni idea de lo que significa esa palabra."

# game/episodes/episode1.rpy:1156
translate HZIlle ep1_sim_intro_cbce6554:

#   l "I heard it from [n] when I entered my first sim ages ago."
    l "Me lo dijo [n] cuando entré en mi primera sim hace años."

# game/episodes/episode1.rpy:1157
translate HZIlle ep1_sim_intro_0994a71b:

#   mc "Seems like time passes much slower in the sim. Interesting."
    mc "Parece que el tiempo pasa mucho más despacio en la simulación. Interesante."

# game/episodes/episode1.rpy:1159
translate HZIlle ep1_sim_intro_c02fbb00:

#   l "Anyway, I'm here to move stuff around, and make the base more livable. Not to think about physics."
    l "De todos modos, estoy aquí para mover cosas y hacer la base más habitable, no para pensar en la física."

# game/episodes/episode1.rpy:1160
translate HZIlle ep1_sim_intro_cd193830:

#   mc "Sure, understandable."
    mc "Claro, es comprensible."

# game/episodes/episode1.rpy:1162
translate HZIlle ep1_sim_intro_0995e477:

#   l "Usually, [n] helps. She tries her best, but she's a cripple now, so there goes that."
    l "Normalmente, [n] ayuda. Se esfuerza al máximo, pero ahora es una lisiada, así que ahí va eso."

# game/episodes/episode1.rpy:1164
translate HZIlle ep1_sim_intro_eed4f39e:

#   mc "The wounded girl? I think I met her."
    mc "¿La chica herida? Creo que la conocí."

# game/episodes/episode1.rpy:1165
translate HZIlle ep1_sim_intro_b83abbd0:

#   mc "Well, not met. I passed her 15 minutes ago at [msd]'s office, just before deployment."
    mc "Bueno, conocer no. Me he cruzado con ella hace 15 minutos en la oficina de [msd], justo antes del despliegue."

# game/episodes/episode1.rpy:1166
translate HZIlle ep1_sim_intro_43015306:

#   l "If you saw a bitchy redhead, that's [n]."
    l "Si has visto a una pelirroja zorra, esa es [n]."

# game/episodes/episode1.rpy:1168
translate HZIlle ep1_sim_intro_fbab0722:

#   l "Huh. Strange. Mention it to [v] when you can."
    l "Qué extraño. Menciónaselo a [v] cuando puedas."

# game/episodes/episode1.rpy:1169
translate HZIlle ep1_sim_intro_d0b3db76:

#   mc "[v]? Who's [v]?"
    mc "[v]¿Quién [v]?"

# game/episodes/episode1.rpy:1170
translate HZIlle ep1_sim_intro_a098c594:

#   l "The brain of the operation. The introductions may take a while. She's not technically 'present', but more on that later!"
    l "El cerebro de la operación. Las presentaciones pueden llevar un rato. Ella no está técnicamente \"presente\", ¡pero hablaremos de eso más adelante!"

# game/episodes/episode1.rpy:1173
translate HZIlle ep1_sim_intro_df71439b:

#   l "You, my friend, have won a lottery ticket!"
    l "Tú, amigo mío, ¡has ganado un billete de lotería!"

# game/episodes/episode1.rpy:1178
translate HZIlle ep1_sim_intro_fa6f22f3:

#   l "That's the spirit!"
    l "¡Ese es el espíritu!"

# game/episodes/episode1.rpy:1179
translate HZIlle ep1_sim_intro_e33f5524:

#   mc "Dreams come true, after all! I'm partnering up in the sim with one of the best."
    mc "Al fin y al cabo, ¡los sueños se hacen realidad! Me asocio en la simulación con uno de los mejores."

# game/episodes/episode1.rpy:1181
translate HZIlle ep1_sim_intro_b9c8cc90:

#   l "Wrong!"
    l "¡Error!"

# game/episodes/episode1.rpy:1182
translate HZIlle ep1_sim_intro_5fec5a7f:

#   l "The best of the best!"
    l "¡Lo mejor de lo mejor!"

# game/episodes/episode1.rpy:1186
translate HZIlle ep1_sim_intro_b65d8ff6:

#   l "You'll see! You're about to experience a new life. A better life!"
    l "¡Ya verás! Estás a punto de experimentar una nueva vida. ¡Una vida mejor!"

# game/episodes/episode1.rpy:1187
translate HZIlle ep1_sim_intro_9ae0a33f:

#   l "Something you haven't seen and won't ever experience in the real world!"
    l "¡Algo que no has visto y que nunca experimentarás en el mundo real!"

# game/episodes/episode1.rpy:1189
translate HZIlle ep1_sim_intro_59855523:

#   l "Learning all the tech stuff and rules from scratch can be tricky, but trust me, it's worth it!"
    l "Aprender todo el material técnico y las normas desde cero puede ser complicado, pero créeme, ¡merece la pena!"

# game/episodes/episode1.rpy:1190
translate HZIlle ep1_sim_intro_45581c26:

#   mc "I sure hope so!"
    mc "¡Eso espero!"

# game/episodes/episode1.rpy:1195
translate HZIlle ep1_sim_intro_708aa212:

#   l "Come on! Let me introduce you to the rest of the squad!"
    l "¡Vamos! ¡Déjame presentarte al resto del equipo!"

# game/episodes/episode1.rpy:1207
translate HZIlle ep1_sim_warehouse_e809d4ed:

#   l "Hey. Quick tip. Don't annoy [n]. Otherwise you'll be stuck in an endless loop of banter with no chance to escape."
    l "Oye, un consejo rápido: no molestes a [n]. De lo contrario, quedarás atrapado en un bucle interminable de bromas sin posibilidad de escapar."

# game/episodes/episode1.rpy:1208
translate HZIlle ep1_sim_warehouse_2cd1a905:

#   l "Here comes the long-awaited missing member of our team!"
    l "¡Aquí llega el tan esperado miembro que faltaba en nuestro equipo!"

# game/episodes/episode1.rpy:1211
translate HZIlle ep1_sim_warehouse_180c3ae3:

#   mc "Ummm... I don't see any welcoming party."
    mc "Ummm... no veo ninguna fiesta de bienvenida."

# game/episodes/episode1.rpy:1212
translate HZIlle ep1_sim_warehouse_6f914358:

#   mc "Are you sure those girls, [n] and [v], are real?"
    mc "¿Estás seguro de que esas chicas, [n] y [v], son reales?"

# game/episodes/episode1.rpy:1214
translate HZIlle ep1_sim_warehouse_0d5c5793:

#   l "Funny!"
    l "¡Qué gracioso!"

# game/episodes/episode1.rpy:1216
translate HZIlle ep1_sim_warehouse_4d7855a9:

#   l "[mc], [n]'s feet."
    l "[mc], los pies de [n]."

# game/episodes/episode1.rpy:1217
translate HZIlle ep1_sim_warehouse_135598eb:

#   l "[n]'s feet, [mc]."
    l "Los pies de [n], [mc]."

# game/episodes/episode1.rpy:1219
translate HZIlle ep1_sim_warehouse_603b0b20:

#   mc "Great to meet the rest of the squad!"
    mc "¡Me alegro de conocer al resto del equipo!"

# game/episodes/episode1.rpy:1227
translate HZIlle ep1_sim_warehouse_33664c01:

#   mc "Nice feet. Very cute."
    mc "Bonitos pies, muy monos."

# game/episodes/episode1.rpy:1228
translate HZIlle ep1_sim_warehouse_17f04047:

#   l "Ugh!"
    l "¡Uf!"

# game/episodes/episode1.rpy:1229
translate HZIlle ep1_sim_warehouse_4ed90695:

#   l "I'll never understand what people see in feet. It's disgusting!"
    l "Nunca entenderé lo que la gente ve en los pies. ¡Es repugnante!"

# game/episodes/episode1.rpy:1232
translate HZIlle ep1_sim_warehouse_1f8f4e76:

#   mc "Hi there!"
    mc "¡Hola!"

# game/episodes/episode1.rpy:1235
translate HZIlle ep1_sim_warehouse_33d36d5f:

#   n "Huh?"
    n "¿Eh?"

# game/episodes/episode1.rpy:1236
translate HZIlle ep1_sim_warehouse_ce4550c1:

#   l "Were you sleeping?"
    l "¿Estabas durmiendo?"

# game/episodes/episode1.rpy:1241
translate HZIlle ep1_sim_warehouse_e3a4a90f:

#   l "Look at this place! Of all the things you could've been doing, you chose to sleep."
    l "Mira este lugar! De todas las cosas que podrías haber estado haciendo, elegiste dormir."

# game/episodes/episode1.rpy:1242
translate HZIlle ep1_sim_warehouse_013c8d98:

#   n "I didn't choose anything. I just fell asleep by accident."
    n "No elegí nada, me quedé dormida por accidente."

# game/episodes/episode1.rpy:1244
translate HZIlle ep1_sim_warehouse_b2188157:

#   n "Oh. [mc]. Pleasure."
    n "Oh. [mc]El placer."

# game/episodes/episode1.rpy:1246
translate HZIlle ep1_sim_warehouse_11c4c484:

#   mct "Yeah, I can see that."
    mct "Sí, ya lo veo."

# game/episodes/episode1.rpy:1247
translate HZIlle ep1_sim_warehouse_14188ce0:

#   mct "For whatever reason, I already feel she's not my fan."
    mct "Por la razón que sea, ya siento que no es mi fan."

# game/episodes/episode1.rpy:1249
translate HZIlle ep1_sim_warehouse_cda823c7:

#   l "Try to be nice! What the hell is wrong with you?"
    l "¡Intenta ser amable! ¿Qué demonios te pasa?"

# game/episodes/episode1.rpy:1251
translate HZIlle ep1_sim_warehouse_4a0539e5:

#   l "So old and still has zero manners. Some people just can't be taught anything."
    l "Tan viejo y sigue sin tener modales. A algunas personas no se les puede enseñar nada."

# game/episodes/episode1.rpy:1256
translate HZIlle ep1_sim_warehouse_d397d61b:

#   mct "Woah."
    mct "Woah."

# game/episodes/episode1.rpy:1258
translate HZIlle ep1_sim_warehouse_44d443af:

#   n "Do I know you from somewhere?"
    n "¿Te conozco de algo?"

# game/episodes/episode1.rpy:1259
translate HZIlle ep1_sim_warehouse_a8d6fc35:

#   mc "Highly unlikely. Unless we count the brief glimpse we had at the... office."
    mc "Muy improbable. A menos que contemos el breve vistazo que tuvimos en la... oficina."

# game/episodes/episode1.rpy:1265
translate HZIlle ep1_sim_warehouse_68d84354:

#   n "Huh."
    n "¿Eh?"

# game/episodes/episode1.rpy:1267
translate HZIlle ep1_sim_warehouse_bcf0e6ee:

#   l "My advice? Better get used to her bitchiness. It's not going anywhere."
    l "¿Mi consejo? Acostúmbrate a su mala leche, no irá a ninguna parte."

# game/episodes/episode1.rpy:1268
translate HZIlle ep1_sim_warehouse_dc3f70e4:

#   l "Gotta get used to it."
    l "Hay que acostumbrarse."

# game/episodes/episode1.rpy:1270
translate HZIlle ep1_sim_warehouse_07069f4f:

#   mc "And how is it going for you?"
    mc "¿Y cómo te va a ti?"

# game/episodes/episode1.rpy:1271
translate HZIlle ep1_sim_warehouse_13cf8675:

#   l "Still trying after decades."
    l "Sigue intentándolo después de décadas."

# game/episodes/episode1.rpy:1274
translate HZIlle ep1_sim_warehouse_a0305c11:

#   n "But you can't argue we make a great team."
    n "Pero no puedes discutir que formamos un gran equipo."

# game/episodes/episode1.rpy:1275
translate HZIlle ep1_sim_warehouse_827dc4b9:

#   n "A bitch..."
    n "Una zorra..."

# game/episodes/episode1.rpy:1277
translate HZIlle ep1_sim_warehouse_d244ed2e:

#   n "And a dumb fuck."
    n "Y un tonto de los cojones."

# game/episodes/episode1.rpy:1278
translate HZIlle ep1_sim_warehouse_55ec9ac8:

#   l "That's tricky! You're both, so I'm not sure where you're going with this."
    l "Eso tiene truco! Ambos lo son, así que no estoy seguro de adónde quieres llegar con esto."

# game/episodes/episode1.rpy:1279
translate HZIlle ep1_sim_warehouse_7bb052dc:

#   n "Ugh!"
    n "¡Uf!"

# game/episodes/episode1.rpy:1281
translate HZIlle ep1_sim_warehouse_dba3d203:

#   v "I can't see him, you know!"
    v "No puedo verlo, ¿sabes?"

# game/episodes/episode1.rpy:1287
translate HZIlle ep1_sim_warehouse_afbd888a:

#   v "Hi, [mc]! So good to finally meet you! I'm [v]."
    v "Hola, [mc] ¡Me alegro de conocerte por fin! Soy [v]."

# game/episodes/episode1.rpy:1288
translate HZIlle ep1_sim_warehouse_75220c84:

#   mc "Woah! That's what I call a warm welcome."
    mc "Eso es lo que yo llamo una cálida bienvenida."

# game/episodes/episode1.rpy:1290
translate HZIlle ep1_sim_warehouse_4fae4c6e:

#   v "Part of my job is to make you feel at home."
    v "Parte de mi trabajo consiste en hacerte sentir como en casa."

# game/episodes/episode1.rpy:1296
translate HZIlle ep1_sim_warehouse_4a66ddcd:

#   l "See [n]? That's how you do it."
    l "¿Ves [n]? Así es como se hace."

# game/episodes/episode1.rpy:1297
translate HZIlle ep1_sim_warehouse_4b6a3183:

#   n "Whatever."
    n "Como quieras."

# game/episodes/episode1.rpy:1300
translate HZIlle ep1_sim_warehouse_70575c51:

#   v "Let's get straight to business, shall we? I'm sure you've got plenty of questions."
    v "Vayamos directamente al grano, ¿vale? Seguro que tienes muchas preguntas."

# game/episodes/episode1.rpy:1301
translate HZIlle ep1_sim_warehouse_c2ee4fdd:

#   v "Entering a simulation for the first time can be overwhelming, so we'll try to take it as slow as possible."
    v "Entrar en una simulación por primera vez puede ser abrumador, así que intentaremos ir lo más despacio posible."

# game/episodes/episode1.rpy:1304
translate HZIlle ep1_sim_warehouse_58e3a9df:

#   v "Without causing any delays to the mission."
    v "Sin causar ningún retraso a la misión."

# game/episodes/episode1.rpy:1305
translate HZIlle ep1_sim_warehouse_be489835:

#   mc "Embarrassing as it is, I don't even know why I'm here and what my role is."
    mc "Por muy vergonzoso que sea, ni siquiera sé por qué estoy aquí ni cuál es mi papel."

# game/episodes/episode1.rpy:1307
translate HZIlle ep1_sim_warehouse_c50546a6:

#   v "Ugh. Time management by those in charge... Typical."
    v "Uf. La gestión del tiempo por parte de los responsables... Típico."

# game/episodes/episode1.rpy:1308
translate HZIlle ep1_sim_warehouse_43ba0742:

#   v "As for your cluelessness, everything will be divulged in time."
    v "En cuanto a tu despiste, todo se divulgará a su debido tiempo."

# game/episodes/episode1.rpy:1311
translate HZIlle ep1_sim_warehouse_c682deee:

#   n "How about we start with the assigned roles?"
    n "¿Qué tal si empezamos con los papeles asignados?"

# game/episodes/episode1.rpy:1313
translate HZIlle ep1_sim_warehouse_e5960a5e:

#   v "Ok, I'm the brain of the operation. Anything computer related, you head to me. While I'm not technically present, I'm always here to help."
    v "Vale, soy el cerebro de la operación. Cualquier cosa relacionada con la informática, acude a mí. Aunque técnicamente no esté presente, siempre estoy aquí para ayudar."

# game/episodes/episode1.rpy:1314
translate HZIlle ep1_sim_warehouse_c3458c21:

#   v "Any questions you might have, you head to me."
    v "Cualquier pregunta que tengas, dirígete a mí."

# game/episodes/episode1.rpy:1319
translate HZIlle ep1_sim_warehouse_fe34685d:

#   mc "Seems like you're pretty busy."
    mc "Parece que estás muy ocupado."

# game/episodes/episode1.rpy:1322
translate HZIlle ep1_sim_warehouse_d1511a6a:

#   l "She is. Unfortunately, the same can't be said about the other team member."
    l "Por desgracia, no se puede decir lo mismo del otro miembro del equipo."

# game/episodes/episode1.rpy:1323
translate HZIlle ep1_sim_warehouse_473a2cf4:

#   l "Always complaining, cold, uncaring bitch. [n]'s role in one sentence."
    l "Siempre quejándose, zorra fría e indiferente. El papel de [n] en una frase."

# game/episodes/episode1.rpy:1325
translate HZIlle ep1_sim_warehouse_2540ff8f:

#   n "Don't pay [l] any attention, and most of all, don't try to follow in his footsteps."
    n "No hagas caso a [l] y, sobre todo, no intentes seguir sus pasos."

# game/episodes/episode1.rpy:1326
translate HZIlle ep1_sim_warehouse_42ac54f5:

#   n "Unless you too have a brain the size of a peanut. Then you're gonna make a great duo."
    n "A menos que tú también tengas el cerebro del tamaño de un cacahuete. Entonces haréis un dúo estupendo."

# game/episodes/episode1.rpy:1328
translate HZIlle ep1_sim_warehouse_db546e21:

#   v "Get used to it. These two argue all the time."
    v "Acostúmbrate, estos dos discuten todo el tiempo."

# game/episodes/episode1.rpy:1329
translate HZIlle ep1_sim_warehouse_e61d23e1:

#   v "[l] likes to live on the dangerous and irresponsible side. Since he's already mastered it, I'm not worried about him."
    v "[l] Le gusta vivir en el lado peligroso e irresponsable. Como ya lo domina, no me preocupa."

# game/episodes/episode1.rpy:1331
translate HZIlle ep1_sim_warehouse_9f49539e:

#   v "I'm more concerned about you acting like him, or worse, heed his advice."
    v "Me preocupa más que actúes como él, o peor aún, que sigas sus consejos."

# game/episodes/episode1.rpy:1332
translate HZIlle ep1_sim_warehouse_61f7c9d9:

#   v "If you really decide to be like [l], at least do it cautiously."
    v "Si realmente decides ser como [l], al menos hazlo con cautela."

# game/episodes/episode1.rpy:1335
translate HZIlle ep1_sim_warehouse_daa856ae:

#   n "Not when it comes to girls, though, cause you're gonna end up a 40-year-old virgin too."
    n "Pero no cuando se trata de chicas, porque también acabarás siendo virgen a los 40 años."

# game/episodes/episode1.rpy:1336
translate HZIlle ep1_sim_warehouse_d7c924cb:

#   l "What?! That's not true!"
    l "¡¿Qué?! ¡Eso no es verdad!"

# game/episodes/episode1.rpy:1338
translate HZIlle ep1_sim_warehouse_356b3c30:

#   v "Just ignore them. [l], as you can probably see, deals with anything related to action."
    v "Ignóralos. [l], como probablemente veas, trata de todo lo relacionado con la acción."

# game/episodes/episode1.rpy:1339
translate HZIlle ep1_sim_warehouse_a04f949d:

#   v "Stealing, impersonating, scamming, and stealth missions belong to [n]."
    v "Robar, suplantar, estafar y las misiones de sigilo pertenecen a [n]."

# game/episodes/episode1.rpy:1341
translate HZIlle ep1_sim_warehouse_be219034:

#   v "Well, she is more like an all-rounder, given the... experience she has."
    v "Bueno, es más bien una todoterreno, dada la... experiencia que tiene."

# game/episodes/episode1.rpy:1342
translate HZIlle ep1_sim_warehouse_ef176580:

#   mc "So, [n], you kick ass too?"
    mc "Entonces, [n], ¿tú también pateas culos?"

# game/episodes/episode1.rpy:1344
translate HZIlle ep1_sim_warehouse_d9cbf690:

#   n "I sure do! I'd kick [l]'s ass."
    n "Claro que sí, le patearía el culo a [l]."

