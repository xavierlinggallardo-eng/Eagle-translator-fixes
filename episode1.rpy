translate HZIlle ep1_glass_3fd75dbc_2:

#   j "Why are you saying this to me? Go and tell her yourself!"
    j "¿Por qué me dices esto? ¡Ve y díselo tú mismo!"

# game/episodes/episode1.rpy:4798
translate HZIlle ep1_glass_6644bb48_1:

#   mc "So it worked! Yes!"
    mc "¡Así que funcionó! ¡Sí!"

# game/episodes/episode1.rpy:4942
translate HZIlle ep1_interrogation_d3848957:

#   mc "What the fuck happened?"
    mc "¿Qué coño ha pasado?"

# game/episodes/episode1.rpy:4945
translate HZIlle ep1_interrogation_52000365:

#   mc "Hey! That's my phone!"
    mc "¡Eh! ¡Ese es mi teléfono!"

# game/episodes/episode1.rpy:4946
translate HZIlle ep1_interrogation_20a12476:

#   r "No sign of the application."
    r "No hay rastro de la solicitud."

# game/episodes/episode1.rpy:4948
translate HZIlle ep1_interrogation_221f2581:

#   r "He's not one of them."
    r "No es uno de ellos."

# game/episodes/episode1.rpy:4949
translate HZIlle ep1_interrogation_946f36ba:

#   mc "One of who? Listen, I'm just new in the city looking for a place to stay and a job! That's all!"
    mc "¿Uno de quién? ¡Escucha, soy nuevo en la ciudad y busco un lugar donde quedarme y un trabajo! ¡Eso es todo!"

# game/episodes/episode1.rpy:4951
translate HZIlle ep1_interrogation_23cd6895:

#   r "So, who the fuck are you? Who do you work for?"
    r "Entonces, ¿quién coño eres? ¿Para quién trabajas?"

# game/episodes/episode1.rpy:4952
translate HZIlle ep1_interrogation_be628c81:

#   r "You were at the Night Beats club yesterday."
    r "Ayer estuviste en el club Night Beats."

# game/episodes/episode1.rpy:4954
translate HZIlle ep1_interrogation_353c3d69:

#   mc "Yes, I was."
    mc "Sí, lo estaba."

# game/episodes/episode1.rpy:4955
translate HZIlle ep1_interrogation_ebec3661:

#   r "That wasn't a question."
    r "No era una pregunta."

# game/episodes/episode1.rpy:4957
translate HZIlle ep1_interrogation_970b96ef:

#   r "Why?"
    r "¿Por qué?"

# game/episodes/episode1.rpy:4965
translate HZIlle ep1_interrogation_4ca524bc:

#   mc "Why was I at the club? Hmmm. Let me think for a minute."
    mc "Déjame pensar un momento."

# game/episodes/episode1.rpy:4966
translate HZIlle ep1_interrogation_61fd0880:

#   mc "Why do you typically go to a club? To pick mushrooms, of course!"
    mc "¿Por qué sueles ir a un club? ¡Para coger setas, claro!"

# game/episodes/episode1.rpy:4969
translate HZIlle ep1_interrogation_5a09ae8c:

#   mc "Why would I be at the club? TO PARTY."
    mc "¿Por qué iba a estar en el club? PARA FIESTA."

# game/episodes/episode1.rpy:4972
translate HZIlle ep1_interrogation_7658d3a9:

#   r "Who's your friend?"
    r "¿Quién es tu amigo?"

# game/episodes/episode1.rpy:4977
translate HZIlle ep1_interrogation_01ecf27c:

#   mc "[l]."
    mc "[l]."

# game/episodes/episode1.rpy:4978
translate HZIlle ep1_interrogation_4f48911e:

#   mc "He's new too."
    mc "También es nuevo."

# game/episodes/episode1.rpy:4982
translate HZIlle ep1_interrogation_76ce10f5:

#   mc "I have no idea what you're talking about."
    mc "No tengo ni idea de lo que estás hablando."

# game/episodes/episode1.rpy:4983
translate HZIlle ep1_interrogation_be87723c:

#   r "Stop playing tough or you won't make it out of here in one piece."
    r "Deja de hacerte el duro o no saldrás de aquí de una pieza."

# game/episodes/episode1.rpy:4985
translate HZIlle ep1_interrogation_213de9f3:

#   r "We also have your friend. I highly suggest you reconsider your answers before blabbing nonsense."
    r "Te sugiero encarecidamente que reconsideres tus respuestas antes de soltar tonterías."

# game/episodes/episode1.rpy:4986
translate HZIlle ep1_interrogation_26f59c0e:

#   mc "[l]. He's new too."
    mc "[l]. Él también es nuevo."

# game/episodes/episode1.rpy:4991
translate HZIlle ep1_interrogation_3e41bd4b:

#   r "Both of you left the club at 2 a.m. What happened then?"
    r "Ambos salisteis del club a las 2 de la madrugada. ¿Qué ocurrió entonces?"

# game/episodes/episode1.rpy:4992
translate HZIlle ep1_interrogation_51c169a3:

#   mc "We noticed someone standing near a limo and an approaching bodyguard."
    mc "Vimos a alguien cerca de una limusina y a un guardaespaldas que se acercaba."

# game/episodes/episode1.rpy:4994
translate HZIlle ep1_interrogation_343930f4:

#   mc "We may be new, but we know who Hector [z] is. Everyone knows him. We recognized him immediately."
    mc "Puede que seamos nuevos, pero sabemos quién es Héctor [z] Todo el mundo lo conoce. Lo reconocimos inmediatamente."

# game/episodes/episode1.rpy:4995
translate HZIlle ep1_interrogation_5bdaf566:

#   mc "Then the attackers appeared. That still wasn't the right time to intervene. None of this had to do anything with us."
    mc "Entonces aparecieron los agresores. Aún no era el momento de intervenir. Nada de esto tenía que ver con nosotros."

# game/episodes/episode1.rpy:4997
translate HZIlle ep1_interrogation_0667af1e:

#   mc "Then the bodyguard got shot."
    mc "Entonces dispararon al guardaespaldas."

# game/episodes/episode1.rpy:4998
translate HZIlle ep1_interrogation_ec55a932:

#   mc "A simple choice. Intervene or [z] gets killed. So we intervened."
    mc "Una elección sencilla. Intervenir o que [z] muera. Así que intervenimos."

# game/episodes/episode1.rpy:5000
translate HZIlle ep1_interrogation_85d089cf:

#   r "Two random guys off the street rushed towards armed men ready to kill?"
    r "¿Dos tipos cualquiera de la calle se abalanzaron sobre hombres armados dispuestos a matar?"

# game/episodes/episode1.rpy:5001
translate HZIlle ep1_interrogation_b32d6ade:

#   r "All this trouble to save a stranger? Risking your own, probably drunken, lives?"
    r "¿Tantos problemas para salvar a un desconocido? ¿Arriesgando vuestras propias vidas, probablemente ebrias?"

# game/episodes/episode1.rpy:5003
translate HZIlle ep1_interrogation_4e3b7c13:

#   r "How many regular citizens would make that choice?"
    r "¿Cuántos ciudadanos normales tomarían esa decisión?"

# game/episodes/episode1.rpy:5004
translate HZIlle ep1_interrogation_0c1b6262:

#   mc "I never said we were regular citizens."
    mc "Nunca he dicho que fuéramos ciudadanos normales."

# game/episodes/episode1.rpy:5006
translate HZIlle ep1_interrogation_91fc70e5:

#   r "Details!"
    r "Detalles"

# game/episodes/episode1.rpy:5007
translate HZIlle ep1_interrogation_f86f423a:

#   mc "PMC. Does that tell you anything?"
    mc "PMC ¿Eso te dice algo?"

# game/episodes/episode1.rpy:5009
translate HZIlle ep1_interrogation_7ff3dd3c:

#   r "Private Military Company. So a military past. Government?"
    r "Empresa Militar Privada. Así que un pasado militar. ¿Gobierno?"

# game/episodes/episode1.rpy:5010
translate HZIlle ep1_interrogation_a64ac0b9:

#   mc "Keyword: private. We were the baddies with proper training."
    mc "Éramos los malos con la formación adecuada."

# game/episodes/episode1.rpy:5011
translate HZIlle ep1_interrogation_c25c079c:

#   mc "We still are."
    mc "Seguimos siéndolo."

# game/episodes/episode1.rpy:5013
translate HZIlle ep1_interrogation_47c8a709:

#   r "Which company?"
    r "¿Qué empresa?"

# game/episodes/episode1.rpy:5014
translate HZIlle ep1_interrogation_c1f6d1c8:

#   mc "I can't tell you that."
    mc "No puedo decírtelo."

# game/episodes/episode1.rpy:5018
translate HZIlle ep1_interrogation_b004483d:

#   mc "If I sell one company to score points with the other, what prevents me from doing the same later on?"
    mc "Si vendo una empresa para ganar puntos con la otra, ¿qué me impide hacer lo mismo más adelante?"

# game/episodes/episode1.rpy:5019
translate HZIlle ep1_interrogation_68626d84:

#   mc "And, let's say, sell YOU out?"
    mc "Y, digamos, ¿venderte?"

# game/episodes/episode1.rpy:5021
translate HZIlle ep1_interrogation_e593bfb2:

#   r "You'd be dead before you could sing."
    r "Estarías muerto antes de poder cantar."

# game/episodes/episode1.rpy:5022
translate HZIlle ep1_interrogation_a228dded:

#   mc "And that's exactly the reason why I won't tell you anything more."
    mc "Y ésa es exactamente la razón por la que no te diré nada más."

# game/episodes/episode1.rpy:5026
translate HZIlle ep1_interrogation_33cb3a51:

#   mc "Non-disclosure agreement. I can't say anything."
    mc "Acuerdo de confidencialidad. No puedo decir nada."

# game/episodes/episode1.rpy:5029
translate HZIlle ep1_interrogation_2d147d54:

#   r "Why should I trust you?"
    r "¿Por qué debería confiar en ti?"

# game/episodes/episode1.rpy:5030
translate HZIlle ep1_interrogation_858e8449:

#   mc "Like you said, no ordinary man would intervene against two armed men. And run away the moment the cops show up."
    mc "Como has dicho, ningún hombre corriente intervendría contra dos hombres armados. Y huiría en cuanto apareciera la policía."

# game/episodes/episode1.rpy:5032
translate HZIlle ep1_interrogation_882cc45b:

#   mc "Also, respect to Mr [z] for stopping the cops."
    mc "Además, respeto al Sr. [z] por detener a la policía."

# game/episodes/episode1.rpy:5033
translate HZIlle ep1_interrogation_f4486d7d:

#   r "How would you know he stopped them?"
    r "¿Cómo sabes que los detuvo?"

# game/episodes/episode1.rpy:5035
translate HZIlle ep1_interrogation_26000563:

#   mc "Well, no one was chasing us."
    mc "Nadie nos perseguía."

# game/episodes/episode1.rpy:5036
translate HZIlle ep1_interrogation_d489563b:

#   r "Why defend [z], then? What's in it for you?"
    r "Entonces, ¿por qué defender a [z]? ¿Qué ganas con ello?"

# game/episodes/episode1.rpy:5038
translate HZIlle ep1_interrogation_89f53809:

#   mc "Everything I said is true. We're new. Looking for jobs and opportunities."
    mc "Todo lo que he dicho es cierto. Somos nuevos. Buscamos trabajo y oportunidades."

# game/episodes/episode1.rpy:5039
translate HZIlle ep1_interrogation_90fbec27:

#   mc "Let's be honest, I didn't go through hell and back with that kind of training to become a waiter."
    mc "Seamos sinceros, no pasé por el infierno y volví con ese tipo de formación para convertirme en camarero."

# game/episodes/episode1.rpy:5041
translate HZIlle ep1_interrogation_f43c82e4:

#   mc "The most powerful man in the city, the king of the city, so to speak, is in trouble..."
    mc "El hombre más poderoso de la ciudad, el rey de la ciudad, por así decirlo, está en apuros..."

# game/episodes/episode1.rpy:5042
translate HZIlle ep1_interrogation_ae6380a4:

#   mc "... and you're capable of saving the day. What do you do?"
    mc "... y eres capaz de salvar el día. ¿Qué haces?"

# game/episodes/episode1.rpy:5044
translate HZIlle ep1_interrogation_4dcdb30e:

#   r "Kick the attackers' asses. Obviously. My questions is, is kicking asses the only thing you can do?"
    r "Patear el culo a los atacantes. Obviamente. Mi pregunta es, ¿patear el culo es lo único que puedes hacer?"

# game/episodes/episode1.rpy:5045
translate HZIlle ep1_interrogation_e555e734:

#   mc "I'm adaptable."
    mc "Soy adaptable."

# game/episodes/episode1.rpy:5047
translate HZIlle ep1_interrogation_5d8a7c95:

#   mc "I took my chance to impress the king and looks like it paid off."
    mc "Aproveché mi oportunidad para impresionar al rey y parece que valió la pena."

# game/episodes/episode1.rpy:5048
translate HZIlle ep1_interrogation_7ffc4c8a:

#   r "Do you know anything about the attackers?"
    r "¿Sabes algo de los atacantes?"

# game/episodes/episode1.rpy:5050
translate HZIlle ep1_interrogation_e6384b48:

#   mc "I know they bit more than they could chew. None of them knew what they were doing."
    mc "Sé que mordieron más de lo que podían masticar. Ninguno de ellos sabía lo que hacía."

# game/episodes/episode1.rpy:5051
translate HZIlle ep1_interrogation_f6f5f661:

#   mc "Correction. One of them knew. The one who shot the bodyguard. It wasn't his first time."
    mc "Corrección. Uno de ellos lo sabía. El que disparó al guardaespaldas. No era su primera vez."

# game/episodes/episode1.rpy:5053
translate HZIlle ep1_interrogation_3b76872b:

#   mc "After the shot, the other one panicked."
    mc "Tras el disparo, el otro entró en pánico."

# game/episodes/episode1.rpy:5054
translate HZIlle ep1_interrogation_c860c48a:

#   r "Hmmm."
    r "Hmmm."

# game/episodes/episode1.rpy:5056
translate HZIlle ep1_interrogation_8fc7187d:

#   mc "Typical newbies who got baited by the money. Or glory. Or both."
    mc "Típicos novatos que se dejaron engatusar por el dinero, o por la gloria, o por ambas cosas."

# game/episodes/episode1.rpy:5057
translate HZIlle ep1_interrogation_a052d899:

#   mc "They will be paying for years."
    mc "Pagarán durante años."

# game/episodes/episode1.rpy:5059
translate HZIlle ep1_interrogation_1b457078:

#   r "If they live to tell the tale."
    r "Si viven para contarlo."

# game/episodes/episode1.rpy:5067
translate HZIlle ep1_interrogation_61ed74c5:

#   r "One more thing..."
    r "Una cosa más..."

# game/episodes/episode1.rpy:5068
translate HZIlle ep1_interrogation_92a67615:

#   r "Suggestion for the future. Treat people with more respect!"
    r "Sugerencia para el futuro. ¡Trata a la gente con más respeto!"

# game/episodes/episode1.rpy:5070
translate HZIlle ep1_interrogation_b1c4a3ad:

#   r "Especially those who hold power over you."
    r "Especialmente los que tienen poder sobre ti."

# game/episodes/episode1.rpy:5071
translate HZIlle ep1_interrogation_2113d881:

#   r "Remember that, boy."
    r "Recuérdalo, muchacho."

# game/episodes/episode1.rpy:5075
translate HZIlle ep1_interrogation_cdd6b84b:

#   r "What do we do with him, boss?"
    r "¿Qué hacemos con él, jefe?"

# game/episodes/episode1.rpy:5076
translate HZIlle ep1_interrogation_534b1289:

#   r "Send him off with a 'warning'?"
    r "¿Mandarle a paseo con una \"advertencia\"?"

# game/episodes/episode1.rpy:5078
translate HZIlle ep1_interrogation_54eb43b6:

#   z "I don't believe getting roughed up is an adequate reward for saving my life."
    z "No creo que recibir una paliza sea una recompensa adecuada por salvarme la vida."

# game/episodes/episode1.rpy:5080
translate HZIlle ep1_interrogation_e70de165:

#   z "Regardless of this child's behaviour."
    z "Independientemente del comportamiento de este niño."

# game/episodes/episode1.rpy:5084
translate HZIlle ep1_interrogation_2d576751:

#   mct "Damn! He was here the entire time!"
    mct "¡Maldita sea! ¡Ha estado aquí todo el tiempo!"

# game/episodes/episode1.rpy:5085
translate HZIlle ep1_interrogation_7567d504:

#   z "The ability to 'kick ass' comes in handy in our profession."
    z "La capacidad de \"patear culos\" es muy útil en nuestra profesión."

# game/episodes/episode1.rpy:5086
translate HZIlle ep1_interrogation_72802e01:

#   z "Profitable."
    z "Rentable."

# game/episodes/episode1.rpy:5088
translate HZIlle ep1_interrogation_0c2851c2:

#   z "I'm used to people owing me rather than the other way around. I can't have that."
    z "Estoy acostumbrado a que la gente me deba y no al revés, no puedo permitirlo."

# game/episodes/episode1.rpy:5089
translate HZIlle ep1_interrogation_41870b8a:

#   z "Wait for a call tomorrow, boy. We will discuss the details of my debt in more pleasant circumstances."
    z "Espera una llamada mañana, muchacho. Discutiremos los detalles de mi deuda en circunstancias más agradables."

# game/episodes/episode1.rpy:5092
translate HZIlle ep1_interrogation_e894234d:

#   z "Let this be a lesson to you on how to act in life-threatening situations."
    z "Que esto te sirva de lección sobre cómo actuar en situaciones de riesgo vital."

# game/episodes/episode1.rpy:5093
translate HZIlle ep1_interrogation_d9241119:

#   z "Do the honors."
    z "Haz los honores."

# game/episodes/episode1.rpy:5096
translate HZIlle ep1_interrogation_9d4117e3:

#   z "We have a special place for talented and willing people. It'd be a shame if such skill went to waste."
    z "Sería una pena que se desperdiciara tanta habilidad."

# game/episodes/episode1.rpy:5099
translate HZIlle ep1_interrogation_a476b158:

#   z "Until tomorrow."
    z "Hasta mañana."

# game/episodes/episode1.rpy:5100
translate HZIlle ep1_interrogation_4b7ed492:

#   z "Well done, [r]."
    z "Bien hecho, [r]."

# game/episodes/episode1.rpy:5124
translate HZIlle ep1_interrogation_after_331f5e41:

#   l "You're alive!"
    l "¡Estás vivo!"

# game/episodes/episode1.rpy:5125
translate HZIlle ep1_interrogation_after_1f6d2bf2:

#   mc "So are you."
    mc "Tú también."

# game/episodes/episode1.rpy:5127
translate HZIlle ep1_interrogation_after_e4cd7eaf:

#   l "You don't look too beaten up."
    l "No pareces muy golpeado."

# game/episodes/episode1.rpy:5129
translate HZIlle ep1_interrogation_after_fe9101c8:

#   mc "I may have crossed boundaries on every occasion and got a reward for it."
    mc "Puede que haya traspasado los límites en cada ocasión y haya obtenido una recompensa por ello."

# game/episodes/episode1.rpy:5130
translate HZIlle ep1_interrogation_after_19fae242:

#   l "Happens to the best of us!"
    l "¡Nos pasa a los mejores!"

# game/episodes/episode1.rpy:5132
translate HZIlle ep1_interrogation_after_e282d13c:

#   mc "I'm perfectly fine."
    mc "Estoy perfectamente."

# game/episodes/episode1.rpy:5135
translate HZIlle ep1_interrogation_after_4db03926:

#   mc "What about you?"
    mc "¿Y tú?"

# game/episodes/episode1.rpy:5136
translate HZIlle ep1_interrogation_after_d4baa184:

#   l "I'm not a talker. Actions speak louder than words as they say!"
    l "No soy un hablador. ¡Las acciones hablan más que las palabras, como suele decirse!"

# game/episodes/episode1.rpy:5138
translate HZIlle ep1_interrogation_after_2d8bfa6a:

#   l "Besides, I couldn't get away with talking my way out. That's not what I do."
    l "Además, no podría salirme con la mía hablando, eso no es lo que hago."

# game/episodes/episode1.rpy:5139
translate HZIlle ep1_interrogation_after_d29aaa99:

#   mc "No way. You beat them up?"
    mc "De ninguna manera. ¿Les diste una paliza?"

# game/episodes/episode1.rpy:5141
translate HZIlle ep1_interrogation_after_47657b18:

#   l "They used a zip tie on me, can you believe it? Idiots."
    l "Me ataron con una cremallera, ¿te lo puedes creer? Idiotas."

# game/episodes/episode1.rpy:5142
translate HZIlle ep1_interrogation_after_7e36e2ac:

#   l "I tore those apart before they could notice."
    l "Los destrocé antes de que pudieran darse cuenta."

# game/episodes/episode1.rpy:5144
translate HZIlle ep1_interrogation_after_f047a0fc:

#   l "And, listen to this, I disarmed the interrogator. Put a gun to her head."
    l "Y, escucha esto, desarmé a la interrogadora. Le puse una pistola en la cabeza."

# game/episodes/episode1.rpy:5145
translate HZIlle ep1_interrogation_after_94d42bd5:

#   l "A badass line for good measure."
    l "Una frase de malote por si acaso."

# game/episodes/episode1.rpy:5147
translate HZIlle ep1_interrogation_after_7c529854:

#   l "If I wanted you dead you'd already be ashes."
    l "Si te quisiera muerto ya serías cenizas."

# game/episodes/episode1.rpy:5148
translate HZIlle ep1_interrogation_after_9cff98d6:

#   l "Handed the gun back to her. Easy."
    l "Devuélvele el arma. Tranquilo."

# game/episodes/episode1.rpy:5150
translate HZIlle ep1_interrogation_after_f60fe40d:

#   l "And... [z] wants me in!"
    l "Y... [z] ¡me quiere dentro!"

# game/episodes/episode1.rpy:5152
translate HZIlle ep1_interrogation_after_9d3e5e81:

#   mc "Damn. Impressive. And risky."
    mc "Maldita sea, impresionante y arriesgado."

# game/episodes/episode1.rpy:5153
translate HZIlle ep1_interrogation_after_28ea13a3:

#   mc "Wait! Her? You put a gun to HER head?"
    mc "¡Espera! ¿A ella? ¿Le pusiste una pistola en la cabeza?"

# game/episodes/episode1.rpy:5155
translate HZIlle ep1_interrogation_after_b43ca7e6:

#   l "[sa] knocked me out and tried to interrogate me."
    l "[sa] me dejó inconsciente e intentó interrogarme."

# game/episodes/episode1.rpy:5156
translate HZIlle ep1_interrogation_after_bc94036c:

#   l "But she underestimated my power!"
    l "¡Pero ella subestimó mi poder!"

# game/episodes/episode1.rpy:5158
translate HZIlle ep1_interrogation_after_3a8973c7:

#   mc "So much for not fighting women..."
    mc "Demasiado para no luchar contra las mujeres..."

# game/episodes/episode1.rpy:5159
translate HZIlle ep1_interrogation_after_1d6dfb0f:

#   l "So much for [sa] as my crush..."
    l "Demasiado para [sa] como mi flechazo..."

# game/episodes/episode1.rpy:5161
translate HZIlle ep1_interrogation_after_83bd027e:

#   l "And I didn't hurt anybody!"
    l "¡Y no he hecho daño a nadie!"

# game/episodes/episode1.rpy:5162
translate HZIlle ep1_interrogation_after_e13a0534:

#   mc "How did she get you, though?"
    mc "Pero, ¿cómo te ha pillado?"

# game/episodes/episode1.rpy:5167
translate HZIlle ep1_interrogation_after_08e86c85:

#   l "I was leaving the toilet. I open the door and bang! What kind of scumbag attacks someone like that?!"
    l "Salía del servicio, abro la puerta y ¡pum! ¿Qué clase de cabrón ataca así a alguien?"

# game/episodes/episode1.rpy:5168
translate HZIlle ep1_interrogation_after_31fdf917:

#   l "I had no chance to react."
    l "No tuve ocasión de reaccionar."

# game/episodes/episode1.rpy:5170
translate HZIlle ep1_interrogation_after_e8d8f124:

#   mc "So... [sa] lost some points with you, I guess."
    mc "Así que... [sa] perdí algunos puntos contigo, supongo."

# game/episodes/episode1.rpy:5171
translate HZIlle ep1_interrogation_after_cd517c9e:

#   l "Yeah, we're done."
    l "Sí, hemos terminado."

# game/episodes/episode1.rpy:5173
translate HZIlle ep1_interrogation_after_66ea38db:

#   l "... Before we even began."
    l "... Antes de empezar."

# game/episodes/episode1.rpy:5174
translate HZIlle ep1_interrogation_after_5bdfb7c2:

#   mc "Next time, buddy!"
    mc "¡La próxima vez, amigo!"

# game/episodes/episode1.rpy:5177
translate HZIlle ep1_interrogation_after_0d830638:

#   l "Were you for real with the help offer, though?"
    l "Pero, ¿hablabas en serio con la oferta de ayuda?"

# game/episodes/episode1.rpy:5178
translate HZIlle ep1_interrogation_after_7676044e:

#   mc "Sure! Why not?"
    mc "¿Por qué no?"

# game/episodes/episode1.rpy:5179
translate HZIlle ep1_interrogation_after_d5125a79:

#   l "That ship has sailed, but I appreciate it."
    l "Ese barco ya ha zarpado, pero te lo agradezco."

# game/episodes/episode1.rpy:5181
translate HZIlle ep1_interrogation_after_5c2a556e:

#   l "What was your grand escape like?"
    l "¿Cómo fue tu gran escapada?"

# game/episodes/episode1.rpy:5182
translate HZIlle ep1_interrogation_after_8431f30b:

#   mc "No crazy actions on my part."
    mc "No he cometido ninguna locura."

# game/episodes/episode1.rpy:5183
translate HZIlle ep1_interrogation_after_9d86af43:

#   mc "I smoothly talked my way out of trouble. Flawless performance!"
    mc "Hablé suavemente para salir del paso. ¡Una actuación impecable!"

# game/episodes/episode1.rpy:5186
translate HZIlle ep1_interrogation_after_63d39d3c:

#   mc "Well, almost."
    mc "Bueno, casi."

# game/episodes/episode1.rpy:5187
translate HZIlle ep1_interrogation_after_9d569e59:

#   l "Good thing they didn't hit your face. Ditch the almost part!"
    l "Menos mal que no te dieron en la cara. ¡Deja lo de casi!"

# game/episodes/episode1.rpy:5190
translate HZIlle ep1_interrogation_after_4c356d22:

#   l "That's what I wanted to hear. Good job, man!"
    l "Eso es lo que quería oír. ¡Buen trabajo, tío!"

# game/episodes/episode1.rpy:5191
translate HZIlle ep1_interrogation_after_42101f2d:

#   l "I'm starting tomorrow!"
    l "¡Empiezo mañana!"

# game/episodes/episode1.rpy:5193
translate HZIlle ep1_interrogation_after_ebf3171c:

#   mc "[z] told me to wait for a phone call."
    mc "[z] me dijo que esperara una llamada telefónica."

# game/episodes/episode1.rpy:5194
translate HZIlle ep1_interrogation_after_e797181e:

#   l "Wait! [z] was there with you?!"
    l "¡Espera! [z] estaba allí contigo?!"

# game/episodes/episode1.rpy:5195
translate HZIlle ep1_interrogation_after_9ded6f7d:

#   mc "Yeah. [z] and [r]. The boss didn't say a word until the last minute."
    mc "Sí, [z] y [r] el jefe no dijo ni una palabra hasta el último momento."

# game/episodes/episode1.rpy:5197
translate HZIlle ep1_interrogation_after_e59db764:

#   l "You're in, my man!"
    l "¡Estás dentro, amigo mío!"

# game/episodes/episode1.rpy:5198
translate HZIlle ep1_interrogation_after_13c972df:

#   mc "To be fair, the old man was probably too scared to be in the same room with you."
    mc "Para ser justos, el viejo probablemente estaba demasiado asustado para estar en la misma habitación que tú."

# game/episodes/episode1.rpy:5200
translate HZIlle ep1_interrogation_after_63a8d221:

#   l "And he was right!"
    l "¡Y tenía razón!"

# game/episodes/episode1.rpy:5201
translate HZIlle ep1_interrogation_after_4e76084d:

#   mc "Fuck yes, we did it!"
    mc "Joder, sí, ¡lo conseguimos!"

# game/episodes/episode1.rpy:5202
translate HZIlle ep1_interrogation_after_d2e000f8:

#   l "Let's get back and celebrate!"
    l "¡Volvamos y celebremos!"

# game/episodes/episode1.rpy:5206
translate HZIlle ep1_interrogation_after_af69ffab:

#   l "Everything alright?"
    l "¿Va todo bien?"

# game/episodes/episode1.rpy:5207
translate HZIlle ep1_interrogation_after_c975eb11:

#   mc "Something's fucked!"
    mc "¡Algo se ha jodido!"

# game/episodes/episode1.rpy:5209
translate HZIlle ep1_interrogation_after_b7b7edd4:

#   l "It was your first interrogation ever. Understandable."
    l "Era tu primer interrogatorio, es comprensible."

# game/episodes/episode1.rpy:5211
translate HZIlle ep1_interrogation_after_bedc247c:

#   l "Come on. Let's get you back to base."
    l "Vamos a llevarte a la base."

# game/episodes/episode1.rpy:5217
translate HZIlle ep1_interrogation_after_d32fef97:

#   r "Fucking hell, never a day of peace."
    r "Maldito infierno, nunca un día de paz."

# game/episodes/episode1.rpy:5219
translate HZIlle ep1_interrogation_after_454fe566:

#   r "Ugh! Retirement awaits..."
    r "Me espera la jubilación..."

# game/episodes/episode1.rpy:5221
translate HZIlle ep1_interrogation_after_59574043:

#   j "Talking to yourself again, pap?"
    j "¿Otra vez hablando solo, papá?"

# game/episodes/episode1.rpy:5222
translate HZIlle ep1_interrogation_after_ce7dc8f3:

#   r "Old age has finally caught up with me!"
    r "¡Por fin me ha alcanzado la vejez!"

# game/episodes/episode1.rpy:5224
translate HZIlle ep1_interrogation_after_1e5dcb73:

#   j "I've been hearing that for the past two decades!"
    j "¡Llevo oyendo eso desde hace dos décadas!"

# game/episodes/episode1.rpy:5225
translate HZIlle ep1_interrogation_after_f80a10a1:

#   j "And I don't believe you!"
    j "¡Y no te creo!"

# game/episodes/episode1.rpy:5227
translate HZIlle ep1_interrogation_after_809d8b05:

#   j "So... What did you do to [mc]?"
    j "Entonces... ¿Qué le has hecho a [mc]?"

# game/episodes/episode1.rpy:5228
translate HZIlle ep1_interrogation_after_d15279d1:

#   r "Nothing but a quick interrogation."
    r "Nada más que un rápido interrogatorio."

# game/episodes/episode1.rpy:5230
translate HZIlle ep1_interrogation_after_250f705b:

#   r "Nobody got harmed if that's what you're worried about."
    r "Nadie resultó herido, si es eso lo que te preocupa."

# game/episodes/episode1.rpy:5232
translate HZIlle ep1_interrogation_after_ab64387b:

#   j "What did you find out? Who is he?"
    j "¿Qué has averiguado? ¿Quién es?"

# game/episodes/episode1.rpy:5233
translate HZIlle ep1_interrogation_after_0c44fe4d:

#   r "A high-tier military guy, apparently. Hector wants both of them in."
    r "Un militar de alto rango, al parecer. Héctor quiere que entren los dos."

# game/episodes/episode1.rpy:5235
translate HZIlle ep1_interrogation_after_b9cdc77a:

#   j "Oh."
    j "Oh."

# game/episodes/episode1.rpy:5237
translate HZIlle ep1_interrogation_after_922c6dc2:

#   r "Why the sudden interest?"
    r "¿A qué se debe este repentino interés?"

# game/episodes/episode1.rpy:5239
translate HZIlle ep1_interrogation_after_4b64ed3c:

#   j "Huh? I'm just concerned!"
    j "¿Eh? ¡Sólo estoy preocupado!"

# game/episodes/episode1.rpy:5240
translate HZIlle ep1_interrogation_after_4b657f49:

#   r "About [mc] only? Whatever your plan is, he's not a proper guy for you!"
    r "¿Sólo sobre [mc] ? Sea cual sea tu plan, ¡no es un tipo adecuado para ti!"

# game/episodes/episode1.rpy:5241
translate HZIlle ep1_interrogation_after_ce407af0:

#   r "The only thing he brings is trouble!"
    r "¡Lo único que trae son problemas!"

# game/episodes/episode1.rpy:5243
translate HZIlle ep1_interrogation_after_8433bc39:

#   j "Please don't start again."
    j "Por favor, no empieces otra vez."

# game/episodes/episode1.rpy:5244
translate HZIlle ep1_interrogation_after_f0199fed:

#   r "Fine. Want a ride home?"
    r "Bien. ¿Quieres que te lleve a casa?"

# game/episodes/episode1.rpy:5246
translate HZIlle ep1_interrogation_after_750b2575:

#   j "Hmmm."
    j "Hmmm."

# game/episodes/episode1.rpy:5247
translate HZIlle ep1_interrogation_after_a05cb12e:

#   r "If you don't want a wage increase, don't want a new house, you could at least accept a ride home from your old man!"
    r "Si no quieres un aumento de sueldo, no quieres una casa nueva, ¡al menos podrías aceptar que tu viejo te lleve a casa!"

# game/episodes/episode1.rpy:5249
translate HZIlle ep1_interrogation_after_9a59979f:

#   j "Sure, pap!"
    j "Claro, ¡papá!"

# game/episodes/episode1.rpy:5266
translate HZIlle ep1_interrogation_warehouse_a7c3570d:

#   v "You are opening it the wrong way. Twist, not pull."
    v "Lo estás abriendo de forma incorrecta. Gira, no tires."

# game/episodes/episode1.rpy:5267
translate HZIlle ep1_interrogation_warehouse_b5c52094:

#   n "So observant."
    n "Tan observador."

# game/episodes/episode1.rpy:5269
translate HZIlle ep1_interrogation_warehouse_b67e96e4:

#   v "I know what's troubling you, [n]. I know what you feel."
    v "Sé lo que te preocupa, [n] sé lo que sientes."

# game/episodes/episode1.rpy:5270
translate HZIlle ep1_interrogation_warehouse_e23e4c6e:

#   n "Do you?"
    n "¿Y tú?"

# game/episodes/episode1.rpy:5272
translate HZIlle ep1_interrogation_warehouse_15f46112:

#   v "Yes, I am capable of sympathizing."
    v "Sí, soy capaz de simpatizar."

# game/episodes/episode1.rpy:5273
translate HZIlle ep1_interrogation_warehouse_59e33430:

#   n "That's not what I meant."
    n "No me refería a eso."

# game/episodes/episode1.rpy:5275
translate HZIlle ep1_interrogation_warehouse_5dce187b:

#   v "What happened to [d] wasn't your fault."
    v "Lo que le ocurrió a [d] no fue culpa tuya."

# game/episodes/episode1.rpy:5276
translate HZIlle ep1_interrogation_warehouse_ad7b8cee:

#   n "What if it was?"
    n "¿Y si lo fuera?"

# game/episodes/episode1.rpy:5278
translate HZIlle ep1_interrogation_warehouse_336e6ab1:

#   v "Don't blame yourself. Whatever happened, happened. There is nothing you can do to change it."
    v "No te culpes. Lo que haya pasado, ha pasado. No hay nada que puedas hacer para cambiarlo."

# game/episodes/episode1.rpy:5279
translate HZIlle ep1_interrogation_warehouse_0632bcd9:

#   n "That's the professional advice these days? It depresses me even more."
    n "¿Ese es el consejo profesional hoy en día? Me deprime aún más."

# game/episodes/episode1.rpy:5281
translate HZIlle ep1_interrogation_warehouse_adb4557b:

#   n "No wonder suicide rates keep climbing."
    n "No es de extrañar que las tasas de suicidio sigan subiendo."

# game/episodes/episode1.rpy:5282
translate HZIlle ep1_interrogation_warehouse_247a9c83:

#   v "Were you considering it?"
    v "¿Te lo estabas planteando?"

# game/episodes/episode1.rpy:5284
translate HZIlle ep1_interrogation_warehouse_3b10f45b:

#   n "What? Suicide? How can I even consider suicide if I haven't yet had the chance to live?"
    n "¿Qué? ¿Suicidio? ¿Cómo puedo siquiera plantearme el suicidio si aún no he tenido la oportunidad de vivir?"

# game/episodes/episode1.rpy:5285
translate HZIlle ep1_interrogation_warehouse_d6be94fa:

#   v "What else can you do other than move on? Keeping your emotions inside is never a good option."
    v "¿Qué otra cosa puedes hacer aparte de seguir adelante? Guardar tus emociones dentro nunca es una buena opción."

# game/episodes/episode1.rpy:5287
translate HZIlle ep1_interrogation_warehouse_cb7888f2:

#   n "Quick diagnosis for just one meeting. I thought there should be more sessions before the final verdict."
    n "Diagnóstico rápido para una sola reunión. Pensaba que debería haber más sesiones antes del veredicto final."

# game/episodes/episode1.rpy:5288
translate HZIlle ep1_interrogation_warehouse_b437335b:

#   v "We can make it regular if you want to. Anything to help you."
    v "Si quieres, podemos hacerlo regular. Lo que sea para ayudarte."

# game/episodes/episode1.rpy:5290
translate HZIlle ep1_interrogation_warehouse_426fbb72:

#   n "No, thanks. I can handle myself."
    n "No, gracias, puedo sola."

# game/episodes/episode1.rpy:5291
translate HZIlle ep1_interrogation_warehouse_f056141b:

#   v "Also, you should not take pills without drinking water!"
    v "Además, ¡no debes tomar pastillas sin beber agua!"

# game/episodes/episode1.rpy:5293
translate HZIlle ep1_interrogation_warehouse_1d30ed31:

#   n "Sure... mom."
    n "Claro... mamá."

# game/episodes/episode1.rpy:5297
translate HZIlle ep1_interrogation_warehouse_24222437:

#   n "Again?! What happened this time?"
    n "¿Otra vez? ¿Qué ha pasado esta vez?"

# game/episodes/episode1.rpy:5299
translate HZIlle ep1_interrogation_warehouse_43f0be81:

#   l "The second contact achieved!"
    l "¡Segundo contacto conseguido!"

# game/episodes/episode1.rpy:5300
translate HZIlle ep1_interrogation_warehouse_0cf02a54:

#   l "We got interrogated in the most painful ways imaginable, and guess what, we're in!"
    l "Nos interrogaron de las formas más dolorosas imaginables, y adivina qué, ¡estamos dentro!"

# game/episodes/episode1.rpy:5302
translate HZIlle ep1_interrogation_warehouse_2d803b2f:

#   n "[mc]? You with us?"
    n "[mc] ¿Estás con nosotros?"

# game/episodes/episode1.rpy:5303
translate HZIlle ep1_interrogation_warehouse_4dbb89da:

#   l "He was fine. Hyped up, proud, and shit."
    l "Estaba bien. Exaltado, orgulloso y todo eso."

# game/episodes/episode1.rpy:5305
translate HZIlle ep1_interrogation_warehouse_ab6678ac:

#   l "We started walking back and he collapsed suddenly. No idea what caused it."
    l "Empezamos a caminar de vuelta y se desplomó de repente. Ni idea de la causa."

# game/episodes/episode1.rpy:5306
translate HZIlle ep1_interrogation_warehouse_d1e304db:

#   n "Let me take a look."
    n "Déjame echar un vistazo."

# game/episodes/episode1.rpy:5308
translate HZIlle ep1_interrogation_warehouse_45b870c7:

#   n "Naah, it's not the interrogation."
    n "Naah, no es el interrogatorio."

# game/episodes/episode1.rpy:5309
translate HZIlle ep1_interrogation_warehouse_834e0449:

#   n "Data transfer sickness."
    n "Enfermedad por transferencia de datos."

# game/episodes/episode1.rpy:5311
translate HZIlle ep1_interrogation_warehouse_bb8180bc:

#   l "What now?"
    l "¿Y ahora qué?"

# game/episodes/episode1.rpy:5312
translate HZIlle ep1_interrogation_warehouse_cbc706ed:

#   l "Why couldn't they connect him like everybody else?"
    l "¿Por qué no podían conectarle como a los demás?"

# game/episodes/episode1.rpy:5314
translate HZIlle ep1_interrogation_warehouse_5f226d5d:

#   n "No time, apparently. A few hours equals a few months in the sim."
    n "No hay tiempo, aparentemente. Unas horas equivalen a unos meses en la simulación."

# game/episodes/episode1.rpy:5315
translate HZIlle ep1_interrogation_warehouse_3f857465:

#   n "A few months IF the sim is already running! They could've fixed my leg in the meantime."
    n "Unos meses SI la simulación ya está en marcha! Podrían haberme arreglado la pierna mientras tanto."

# game/episodes/episode1.rpy:5316
translate HZIlle ep1_interrogation_warehouse_e5d9170a:

#   l "I wouldn't mind more training. I'm getting rusty!"
    l "No me importaría recibir más formación. ¡Me estoy oxidando!"

# game/episodes/episode1.rpy:5318
translate HZIlle ep1_interrogation_warehouse_c5bb5966:

#   n "The time of responsible management and leadership are long gone at Aegis. The OG's are almost gone."
    n "La época de la gestión y el liderazgo responsables hace tiempo que pasó en Aegis. Los OG casi han desaparecido."

# game/episodes/episode1.rpy:5319
translate HZIlle ep1_interrogation_warehouse_cb6ea778:

#   n "Deloney starts shaking, and bam, what do you know, stupid decision time!"
    n "Deloney empieza a temblar, y zas, ¡qué sabes, hora de tomar decisiones estúpidas!"

# game/episodes/episode1.rpy:5321
translate HZIlle ep1_interrogation_warehouse_0db219b9:

#   l "Yeah, maybe. Not within my competence to judge."
    l "Sí, tal vez. No es de mi competencia juzgar."

# game/episodes/episode1.rpy:5322
translate HZIlle ep1_interrogation_warehouse_b6078c0f:

#   l "Let's just get [mc] to bed. Let him rest and chill for a bit."
    l "Llevemos a [mc] la cama. Dejémosle descansar y relajarse un rato."

# game/episodes/episode1.rpy:5324
translate HZIlle ep1_interrogation_warehouse_cb255a5c:

#   l "For the first time ever, not a single word of complaint about [mc]? [n], I'm proud of you."
    l "Por primera vez, ni una sola palabra de queja sobre [mc]? [n], estoy orgulloso de ti."

# game/episodes/episode1.rpy:5325
translate HZIlle ep1_interrogation_warehouse_b8702ded:

#   n "I'm not in the mood."
    n "No estoy de humor."

# game/episodes/episode1.rpy:5326
translate HZIlle ep1_interrogation_warehouse_42506484:

#   l "You never are."
    l "Nunca lo eres."

# game/episodes/episode1.rpy:5328
translate HZIlle ep1_interrogation_warehouse_4d4edd03:

#   n "Whatever you say, [l]."
    n "Lo que tú digas, [l]."

# game/episodes/episode1.rpy:5342
translate HZIlle ep1_interrogation_dream_84ee8199:

#   v "Why did they put you in, huh?"
    v "¿Por qué te han metido?"

# game/episodes/episode1.rpy:5343
translate HZIlle ep1_interrogation_dream_41786bd4:

#   v "Without proper training, without any experience in sim life."
    v "Sin una formación adecuada, sin ninguna experiencia en la vida sim."

# game/episodes/episode1.rpy:5348
translate HZIlle ep1_interrogation_dream_cf0d56a1:

#   v "How fucked up do you have to be in real life to force Aegis to employ you prematurely?"
    v "¿Cómo de jodido tienes que estar en la vida real para obligar a Aegis a contratarte antes de tiempo?"

# game/episodes/episode1.rpy:5349
translate HZIlle ep1_interrogation_dream_33cc1114:

#   v "But don't worry. I'll be here."
    v "Pero no te preocupes, aquí estaré."

# game/episodes/episode1.rpy:5351
translate HZIlle ep1_interrogation_dream_5e8ae733:

#   v "I'll take care of you."
    v "Yo me ocuparé de ti."

# game/episodes/episode1.rpy:5354
translate HZIlle ep1_interrogation_dream_afa1ef94:

#   mct "What the hell happened?"
    mct "¿Qué demonios ha pasado?"

# game/episodes/episode1.rpy:5355
translate HZIlle ep1_interrogation_dream_ca03523d:

#   mct "Where am I?"
    mct "¿Dónde estoy?"

# game/episodes/episode1.rpy:5358
translate HZIlle ep1_interrogation_dream_bb019795:

#   mc "Where am I?"
    mc "¿Dónde estoy?"

# game/episodes/episode1.rpy:5359
