    mc "Haz que se olvide de todos los demás."

# game/episodes/episode1.rpy:651
translate HZIlle ep1_pmc_boss2_31c49290:

#   mc "Just me and her lost in the moment."
    mc "Solos ella y yo, perdidos en el momento."

# game/episodes/episode1.rpy:652
translate HZIlle ep1_pmc_boss2_d9b262b2:

#   mc "Use her and then steal."
    mc "Utilízala y luego roba."

# game/episodes/episode1.rpy:654
translate HZIlle ep1_pmc_boss2_e4dbb92f:

#   mc "Or you, in this particular case. Sorry if that sounds harsh."
    mc "O tú, en este caso concreto. Perdona si suena duro."

# game/episodes/episode1.rpy:655
translate HZIlle ep1_pmc_boss2_8360191c:

#   msd "I see you've been paying attention to all the 'social aspects' lessons."
    msd "Veo que has prestado atención a todas las lecciones sobre \"aspectos sociales\"."

# game/episodes/episode1.rpy:657
translate HZIlle ep1_pmc_boss2_41088211:

#   msd "Hmm. Any reasons for this approach?"
    msd "¿Alguna razón para este enfoque?"

# game/episodes/episode1.rpy:661
translate HZIlle ep1_pmc_boss2_8b80d3e9:

#   msd "Understandable."
    msd "Es comprensible."

# game/episodes/episode1.rpy:663
translate HZIlle ep1_pmc_boss2_da77ea98:

#   msd "I would suggest paying more attention to the reasons behind your actions and not relying solely on impulses."
    msd "Te sugiero que prestes más atención a las razones que hay detrás de tus actos y que no confíes únicamente en los impulsos."

# game/episodes/episode1.rpy:664
translate HZIlle ep1_pmc_boss2_c1bc6cfe:

#   msd "Although we employ agents who have mastered this approach, I don't think you're quite ready for it yet."
    msd "Aunque empleamos a agentes que dominan este enfoque, no creo que estés preparado para ello todavía."

# game/episodes/episode1.rpy:670
translate HZIlle ep1_pmc_boss2_82ab2cb3:

#   mc "I broke your heart and stole from you. Used you. Betrayed you."
    mc "Te rompí el corazón, te robé, te utilicé, te traicioné."

# game/episodes/episode1.rpy:671
translate HZIlle ep1_pmc_boss2_95bdfc65:

#   mc "Any other agent from any corporation who tries the same approach with you will fail."
    mc "Cualquier otro agente de cualquier empresa que intente el mismo enfoque contigo fracasará."

# game/episodes/episode1.rpy:672
translate HZIlle ep1_pmc_boss2_c504f5ec:

#   mc "You won't ever let your guard down."
    mc "Nunca bajarás la guardia."

# game/episodes/episode1.rpy:674
translate HZIlle ep1_pmc_boss2_f1c01909:

#   msd "Deliberate and calculated. Impressive."
    msd "Deliberado y calculado, impresionante."

# game/episodes/episode1.rpy:678
translate HZIlle ep1_pmc_boss2_147f13a7:

#   mc "Male or female target doesn't matter. My approach remains the same."
    mc "El objetivo masculino o femenino no importa. Mi enfoque sigue siendo el mismo."

# game/episodes/episode1.rpy:679
translate HZIlle ep1_pmc_boss2_d6b60a29:

#   mc "Old-fashioned theft. In and out. No witnesses, no prints."
    mc "Robo a la antigua, entrar y salir, sin testigos ni huellas."

# game/episodes/episode1.rpy:681
translate HZIlle ep1_pmc_boss2_03c8750f:

#   mc "Just data gone, and my completing the assignment."
    mc "Sólo se han ido los datos y yo he completado la tarea."

# game/episodes/episode1.rpy:682
translate HZIlle ep1_pmc_boss2_0d397cff:

#   msd "Hmm. Practical approach. Not something I'm necessarily looking for."
    msd "Enfoque práctico. No es algo que busque necesariamente."

# game/episodes/episode1.rpy:685
translate HZIlle ep1_pmc_boss2_a7b55035:

#   msd "What is your experience with women?"
    msd "¿Cuál es tu experiencia con las mujeres?"

# game/episodes/episode1.rpy:686
translate HZIlle ep1_pmc_boss2_58cbfd04:

#   mc "Ummm... Is that relevant?"
    mc "Ummm... ¿Es eso relevante?"

# game/episodes/episode1.rpy:688
translate HZIlle ep1_pmc_boss2_1de47e29:

#   msd "If it wasn't, why would I ask the question?"
    msd "Si no lo fuera, ¿por qué haría la pregunta?"

# game/episodes/episode1.rpy:689
translate HZIlle ep1_pmc_boss2_2ea1bc1c:

#   mc "I know my way around women."
    mc "Conozco a las mujeres."

# game/episodes/episode1.rpy:691
translate HZIlle ep1_pmc_boss2_07a9b78d:

#   msd "Past experiences. Future decisions. Does your childhood have any influence on the person you are now?"
    msd "Experiencias pasadas. Decisiones futuras. ¿Tu infancia tiene alguna influencia en la persona que eres ahora?"

# game/episodes/episode1.rpy:696
translate HZIlle ep1_pmc_boss2_46f2b85d:

#   mc "I am who I am thanks to or because of my parents and the environment I was raised in."
    mc "Soy quien soy gracias o por culpa de mis padres y del entorno en el que me crié."

# game/episodes/episode1.rpy:697
translate HZIlle ep1_pmc_boss2_21071622:

#   msd "Any mistake you make now can be traced back to those roots?"
    msd "¿Cualquier error que cometas ahora puede remontarse a esas raíces?"

# game/episodes/episode1.rpy:699
translate HZIlle ep1_pmc_boss2_dbe38c93:

#   mc "I am also responsible for my own actions. No excuses."
    mc "Yo también soy responsable de mis actos, sin excusas."

# game/episodes/episode1.rpy:700
translate HZIlle ep1_pmc_boss2_5d15ed8d:

#   msd "Reasonable and responsible."
    msd "Razonable y responsable."

# game/episodes/episode1.rpy:703
translate HZIlle ep1_pmc_boss2_5d6bc3a3:

#   mc "I am my own person making my own decisions based on what I think is right."
    mc "Soy una persona que toma sus propias decisiones basándose en lo que considera correcto."

# game/episodes/episode1.rpy:704
translate HZIlle ep1_pmc_boss2_d1676d20:

#   mc "Each achievement is thanks to my own accomplishments, and each failure is my own mistake."
    mc "Cada logro es gracias a mis propios logros, y cada fracaso es mi propio error."

# game/episodes/episode1.rpy:706
translate HZIlle ep1_pmc_boss2_aa47c489:

#   msd "Unless you work in a team?"
    msd "¿A menos que trabajes en equipo?"

# game/episodes/episode1.rpy:707
translate HZIlle ep1_pmc_boss2_a55c8099:

#   mc "Even teams require individual responsibilities."
    mc "Incluso los equipos requieren responsabilidades individuales."

# game/episodes/episode1.rpy:710
translate HZIlle ep1_pmc_boss2_bafeaafc:

#   msd "Good. You can relax now."
    msd "Bien. Ya puedes relajarte."

# game/episodes/episode1.rpy:711
translate HZIlle ep1_pmc_boss2_4f9aad2c:

#   msd "Save an agent or complete the job?"
    msd "¿Salvar a un agente o completar el trabajo?"

# game/episodes/episode1.rpy:717
translate HZIlle ep1_pmc_boss2_298da1c8:

#   msd "Why?"
    msd "¿Por qué?"

# game/episodes/episode1.rpy:719
translate HZIlle ep1_pmc_boss2_0b69fa0a:

#   mc "If every agent abandoned their comrades in crisis, soon you'd have no agents left."
    mc "Si todos los agentes abandonaran a sus compañeros en crisis, pronto no te quedarían agentes."

# game/episodes/episode1.rpy:720
translate HZIlle ep1_pmc_boss2_ff92a648:

#   msd "I like the approach."
    msd "Me gusta el planteamiento."

# game/episodes/episode1.rpy:726
translate HZIlle ep1_pmc_boss2_3c555a3d:

#   mc "You didn't entrust me with a hazardous mission with potentially disastrous consequences to abandon it at first sight of trouble."
    mc "No me confiaste una misión peligrosa con consecuencias potencialmente desastrosas para abandonarla a la primera de cambio."

# game/episodes/episode1.rpy:727
translate HZIlle ep1_pmc_boss2_edb67885:

#   msd "Hmm."
    msd "Hmm."

# game/episodes/episode1.rpy:731
translate HZIlle ep1_pmc_boss2_89fb50a2:

#   mc "It entirely depends on the situation."
    mc "Depende totalmente de la situación."

# game/episodes/episode1.rpy:732
translate HZIlle ep1_pmc_boss2_9e585af8:

#   msd "Would you be able to evaluate the situation at a moment's notice?"
    msd "¿Serías capaz de evaluar la situación en un momento dado?"

# game/episodes/episode1.rpy:734
translate HZIlle ep1_pmc_boss2_1293a03d:

#   msd "Split-second decision under heavy stress? Deciding on another human's life?"
    msd "¿Decidir en una fracción de segundo bajo fuerte estrés? ¿Decidir sobre la vida de otro ser humano?"

# game/episodes/episode1.rpy:735
translate HZIlle ep1_pmc_boss2_a3a0cbcd:

#   msd "Would you be able to handle that?"
    msd "¿Serías capaz de soportarlo?"

# game/episodes/episode1.rpy:741
translate HZIlle ep1_pmc_boss2_cf1adef2:

#   mc "Yeah."
    mc "Sí."

# game/episodes/episode1.rpy:742
translate HZIlle ep1_pmc_boss2_670262de:

#   msd "Have you ever made a decision like that?"
    msd "¿Has tomado alguna vez una decisión así?"

# game/episodes/episode1.rpy:743
translate HZIlle ep1_pmc_boss2_a3e826ac:

#   mc "Not yet, but..."
    mc "Todavía no, pero..."

# game/episodes/episode1.rpy:745
translate HZIlle ep1_pmc_boss2_54a18f56:

#   msd "Oh. Not yet. I understand."
    msd "Todavía no. Lo entiendo."

# game/episodes/episode1.rpy:750
translate HZIlle ep1_pmc_boss2_45a736eb:

#   mc "Yes, I think I would."
    mc "Sí, creo que sí."

# game/episodes/episode1.rpy:753
translate HZIlle ep1_pmc_boss2_57d864fa:

#   mc "Of course not. But it's not that simple."
    mc "Claro que no, pero no es tan sencillo."

# game/episodes/episode1.rpy:754
translate HZIlle ep1_pmc_boss2_e1b8cbe7:

#   mc "What if, during the mission, it turns out that the ultimate goal isn't really the end goal?"
    mc "¿Y si, durante la misión, resulta que el objetivo final no es realmente el objetivo final?"

# game/episodes/episode1.rpy:755
translate HZIlle ep1_pmc_boss2_9e4a062c:

#   mc "What if there is one more after that? And if I sacrifice an agent, how do I complete the mission without him or her?"
    mc "¿Y si hay uno más después? Y si sacrifico a un agente, ¿cómo completo la misión sin él o ella?"

# game/episodes/episode1.rpy:757
translate HZIlle ep1_pmc_boss2_52c401d5:

#   mc "I won't. As I said, the answer is not that simple."
    mc "No lo haré. Como ya he dicho, la respuesta no es tan sencilla."

# game/episodes/episode1.rpy:758
translate HZIlle ep1_pmc_boss2_5d6b9fce:

#   msd "Respectable approach."
    msd "Enfoque respetable."

# game/episodes/episode1.rpy:762
translate HZIlle ep1_pmc_boss2_e5bd9784:

#   msd "Why do you think you got the rare opportunity to be introduced to the Aegis CEO?"
    msd "¿Por qué crees que tuviste la rara oportunidad de que te presentaran al director general de Aegis?"

# game/episodes/episode1.rpy:763
translate HZIlle ep1_pmc_boss2_626fdf44:

#   mct "... the ego on this woman..."
    mct "... el ego de esta mujer..."

# game/episodes/episode1.rpy:765
translate HZIlle ep1_pmc_boss2_fcf2b84b:

#   mc "I've got a few ideas. One less probable than the other."
    mc "Tengo algunas ideas, una menos probable que la otra."

# game/episodes/episode1.rpy:766
translate HZIlle ep1_pmc_boss2_1948b64e:

#   mc "Either I'm prematurely becoming an agent, or I get a special assignment. Both would be a dream come true."
    mc "O me convierto prematuramente en agente, o recibo un encargo especial. Ambas cosas serían un sueño hecho realidad."

# game/episodes/episode1.rpy:771
translate HZIlle ep1_pmc_boss2_e02bc357:

#   msd "A little bit of both."
    msd "Un poco de ambas cosas."

# game/episodes/episode1.rpy:772
translate HZIlle ep1_pmc_boss2_e3cff51d:

#   msd "You will take part in a secret operation. In short, enter the simulation with the rest of the team, pull off a robbery, and retrieve what we need."
    msd "Participarás en una operación secreta. En resumen, entra en la simulación con el resto del equipo, lleva a cabo un robo y recupera lo que necesitamos."

# game/episodes/episode1.rpy:774
translate HZIlle ep1_pmc_boss2_09cd3f01:

#   msd "The stakes are high. Higher than ever before. We cannot afford a single fuck up."
    msd "Hay mucho en juego, más que nunca. No podemos permitirnos ni una sola cagada."

# game/episodes/episode1.rpy:775
translate HZIlle ep1_pmc_boss2_d8907e6e:

#   mc "No offense, but you just described every heist in the history of mankind."
    mc "No te ofendas, pero acabas de describir todos los atracos de la historia de la humanidad."

# game/episodes/episode1.rpy:777
translate HZIlle ep1_pmc_boss2_6dcdd015:

#   mc "I mean, a-any more details? Who we stealing from? What are we stealing? What's the modus?"
    mc "¿Algún detalle más? ¿A quién robamos? ¿Qué robamos? ¿Cuál es el modus?"

# game/episodes/episode1.rpy:778
translate HZIlle ep1_pmc_boss2_b3ef2c55:

#   msd "Since you're not connected to the AI yet, the briefing will have to happen the old-fashioned way. Orally."
    msd "Como aún no estás conectado a la IA, la sesión informativa tendrá que hacerse a la antigua usanza: oralmente."

# game/episodes/episode1.rpy:780
translate HZIlle ep1_pmc_boss2_314ff30a:

#   msd "But not by me. The moment you enter the simulation, the brain of the operation will clue you in."
    msd "Pero no por mí. En cuanto entres en la simulación, el cerebro de la operación te dará una pista."

# game/episodes/episode1.rpy:781
translate HZIlle ep1_pmc_boss2_49bdfbbc:

#   mct "New and going in completely blind? Risky."
    mct "¿Ser nuevo e ir completamente a ciegas? Es arriesgado."

# game/episodes/episode1.rpy:783
translate HZIlle ep1_pmc_boss2_ab023b04:

#   msd "A new situation has forced us to take extraordinary measures and involve a partially trained agent."
    msd "Una nueva situación nos ha obligado a tomar medidas extraordinarias y a implicar a un agente parcialmente formado."

# game/episodes/episode1.rpy:784
translate HZIlle ep1_pmc_boss2_2a1c8098:

#   msd "Thanks to that assignment, you'll skip the 2 years of training left."
    msd "Gracias a esa asignación, te saltarás los 2 años de formación que te quedan."

# game/episodes/episode1.rpy:785
translate HZIlle ep1_pmc_boss2_1cc22caf:

#   msd "[mc], focus."
    msd "[mc], foco."

# game/episodes/episode1.rpy:787
translate HZIlle ep1_pmc_boss2_752a569f:

#   msd "You'll get to work with the best of the best our corporation has to offer."
    msd "Trabajarás con lo mejor de lo mejor que ofrece nuestra corporación."

# game/episodes/episode1.rpy:788
translate HZIlle ep1_pmc_boss2_a581262e:

#   msd "Gain experience from working in the field. Analyze subjects' behavior on the fly by actively participating and consciously alternating their views and alignments."
    msd "Adquiere experiencia trabajando sobre el terreno. Analiza el comportamiento de los sujetos sobre la marcha participando activamente y alternando conscientemente sus puntos de vista y alineamientos."

# game/episodes/episode1.rpy:790
translate HZIlle ep1_pmc_boss2_b24cbc2e:

#   msd "Memorizing the books will teach you the craft of manipulation. Working with the best will let you master it."
    msd "Memorizar los libros te enseñará el oficio de la manipulación. Trabajar con los mejores te permitirá dominarlo."

# game/episodes/episode1.rpy:791
translate HZIlle ep1_pmc_boss2_29ca2a80:

#   msd "If you pull this heist off successfully, I will make you the primary Aegis agent!"
    msd "Si llevas a cabo este atraco con éxito, ¡te nombraré agente principal de Aegis!"

# game/episodes/episode1.rpy:793
translate HZIlle ep1_pmc_boss2_2485f494:

#   mc "I..."
    mc "I..."

# game/episodes/episode1.rpy:796
translate HZIlle ep1_pmc_boss2_bde82bfd:

#   msd "Alright. Think it over for a minute."
    msd "De acuerdo, piénsalo un momento."

# game/episodes/episode1.rpy:797
translate HZIlle ep1_pmc_boss2_a1fc2729:

#   msd "Think how much there is to achieve."
    msd "Piensa en todo lo que hay que conseguir."

# game/episodes/episode1.rpy:799
translate HZIlle ep1_pmc_boss2_f8b7374c:

#   msd "Think of all the benefits you'd get from becoming a fully fledged Aegis agent!"
    msd "¡Piensa en todas las ventajas que obtendrías si te convirtieras en un agente Aegis de pleno derecho!"

# game/episodes/episode1.rpy:800
translate HZIlle ep1_pmc_boss2_fa8aad67:

#   msd "It's a one-in-a-million chance. Never before given to a trainee."
    msd "Es una oportunidad entre un millón, nunca antes dada a un aprendiz."

# game/episodes/episode1.rpy:802
translate HZIlle ep1_pmc_boss2_93c2a6ee:

#   msd "You're the best person we have for the job."
    msd "Eres la mejor persona que tenemos para el trabajo."

# game/episodes/episode1.rpy:803
translate HZIlle ep1_pmc_boss2_6ffadd71:

#   mct "Jesus, her being so close..."
    mct "Jesús, ella estando tan cerca..."

# game/episodes/episode1.rpy:808
translate HZIlle ep1_pmc_boss2_9fe85bb1:

#   mct "Should I push my luck?"
    mct "¿Debo tentar a la suerte?"

# game/episodes/episode1.rpy:815
translate HZIlle ep1_pmc_boss2_65869ec4:

#   mct "Better not."
    mct "Mejor no."

# game/episodes/episode1.rpy:822
translate HZIlle ep1_pmc_boss2_b9dcb07e:

#   msd "And? I'm gonna need an answer before you push things too far."
    msd "¿Y? Voy a necesitar una respuesta antes de que lleves las cosas demasiado lejos."

# game/episodes/episode1.rpy:828
translate HZIlle ep1_pmc_boss2_94806dd3:

#   mct "I've never had to take an easier decision in my life."
    mct "Nunca he tenido que tomar una decisión más fácil en mi vida."

# game/episodes/episode1.rpy:829
translate HZIlle ep1_pmc_boss2_5cb3941b:

#   mct "But I have to restrain myself. Maybe see what else she's up to."
    mct "Pero tengo que contenerme. Quizá vea qué más trama."

# game/episodes/episode1.rpy:831
translate HZIlle ep1_pmc_boss2_dda45ab3:

#   msd "If you're unsure about handling such a critical operation I can guarantee you will not get a better opportunity than this one."
    msd "Si no estás seguro de manejar una operación tan crítica, puedo garantizarte que no tendrás una oportunidad mejor que ésta."

# game/episodes/episode1.rpy:832
translate HZIlle ep1_pmc_boss2_3f51a959:

#   msd "Alright. I'll let you think for a minute."
    msd "Muy bien, te dejaré pensar un momento."

# game/episodes/episode1.rpy:834
translate HZIlle ep1_pmc_boss2_15051a21:

#   msd "Think how much you can achieve."
    msd "Piensa en todo lo que puedes conseguir."

# game/episodes/episode1.rpy:835
translate HZIlle ep1_pmc_boss2_5576a9cb:

#   msd "Think of all the benefits you'd get from becoming an Aegis agent!"
    msd "¡Piensa en todas las ventajas que obtendrías si te convirtieras en agente Aegis!"

# game/episodes/episode1.rpy:843
translate HZIlle ep1_pmc_boss2_9b636148:

#   mct "Her perfume. Ugh! I'm losing my fucking mind!"
    mct "Su perfume. ¡Uf! ¡Estoy perdiendo la puta cabeza!"

# game/episodes/episode1.rpy:724
translate HZIlle ep1_pmc_boss2_298da1c8_1:

#   msd "Why?"
    msd "¿Por qué?"

# game/episodes/episode1.rpy:751
translate HZIlle ep1_pmc_boss2_670262de_1:

#   msd "Have you ever made a decision like that?"
    msd "¿Has tomado alguna vez una decisión así?"

# game/episodes/episode1.rpy:836
translate HZIlle ep1_pmc_boss2_fa8aad67_1:

#   msd "It's a one-in-a-million chance. Never before given to a trainee."
    msd "Es una oportunidad entre un millón, nunca antes dada a un aprendiz."

# game/episodes/episode1.rpy:841
translate HZIlle ep1_pmc_boss2_93c2a6ee_1:

#   msd "You're the best person we have for the job."
    msd "Eres la mejor persona que tenemos para el trabajo."

# game/episodes/episode1.rpy:842
translate HZIlle ep1_pmc_boss2_6ffadd71_1:

#   mct "Jesus, her being so close..."
    mct "Jesús, ella estando tan cerca..."

# game/episodes/episode1.rpy:848
translate HZIlle ep1_pmc_boss_after_6781d10e:

#   mc "I'm in!"
    mc "¡Me apunto!"

# game/episodes/episode1.rpy:850
translate HZIlle ep1_pmc_boss_after_7f92592c:

#   msd "Good choice!"
    msd "¡Buena elección!"

# game/episodes/episode1.rpy:851
translate HZIlle ep1_pmc_boss_after_129fb25a:

#   mc "When do I start?"
    mc "¿Cuándo empiezo?"

# game/episodes/episode1.rpy:853
translate HZIlle ep1_pmc_boss_after_cc83138f:

#   msd "You start now."
    msd "Empieza ahora."

# game/episodes/episode1.rpy:854
translate HZIlle ep1_pmc_boss_after_ebed122f:

#   msd "Head to the -3 level. Try not to get lost while waiting for my assistant."
